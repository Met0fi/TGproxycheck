        result = check_one(args.link, max(1.0, args.timeout), max(1, min(5, args.attempts)), not args.no_geo)
        if args.json_path:
            ProxyChecker.export_json(args.json_path, result)
        if args.txt_path:
            ProxyChecker.export_txt(args.txt_path, result)
        raise SystemExit(0 if result.get("valid") else 2)
    if args.command == "batch":
        links = load_links(args.file)
        results = check_batch(links, max(1, min(128, args.workers)), max(1.0, args.timeout), max(1, min(5, args.attempts)))
