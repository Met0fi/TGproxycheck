        console.print(table)


def batch_bs_status(result: dict[str, Any]) -> str:
    whitelist = result.get("whitelist_check") or {}
    sni_match = bool((whitelist.get("sni") or {}).get("matched"))
    ip_match = bool((whitelist.get("ip") or {}).get("matched"))
    if sni_match and ip_match:
        return "SNI+IP"
    if sni_match:
        return "SNI"
    if ip_match:
        return "IP"
    return "НЕ БС" if whitelist.get("loaded") else "?"


