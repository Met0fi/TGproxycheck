        elif choice == "7":
            clear_screen()
            return
        else:
            console.print("[yellow]Введите число от 1 до 7.[/]")
            time.sleep(0.7)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="tgproxycheck", description=APP_NAME)
    parser.add_argument("--version", action="version", version=VERSION)
    sub = parser.add_subparsers(dest="command")
    single = sub.add_parser("check", help="проверить одну прокси")
    single.add_argument("link")
    single.add_argument("--timeout", type=float, default=DEFAULT_TIMEOUT)
    single.add_argument("--attempts", type=int, default=DEFAULT_ATTEMPTS)
    single.add_argument("--no-geo", action="store_true")
    single.add_argument("--json", dest="json_path")
    single.add_argument("--txt", dest="txt_path")
    batch = sub.add_parser("batch", help="проверить прокси из файла")
    batch.add_argument("file")
    batch.add_argument("--workers", type=int, default=DEFAULT_WORKERS)
    batch.add_argument("--timeout", type=float, default=DEFAULT_TIMEOUT)
    batch.add_argument("--attempts", type=int, default=DEFAULT_ATTEMPTS)
    batch.add_argument("--output")
    sources = sub.add_parser("sources", help="получить и проверить публичные и свои списки")
    sources.add_argument("--workers", type=int, default=DEFAULT_WORKERS)
    sources.add_argument("--timeout", type=float, default=DEFAULT_TIMEOUT)
    sources.add_argument("--attempts", type=int, default=DEFAULT_ATTEMPTS)
    sources.add_argument("--limit", type=int, default=0)
    sources.add_argument("--output")
    sources.add_argument("--source", action="append", default=[], help="добавить источник URL, путь к файлу или proxy-ссылку")
    sources.add_argument("--no-custom", action="store_true", help="не использовать сохранённые пользовательские источники")
    custom = sub.add_parser("custom-sources", help="управлять пользовательскими источниками")
    custom.add_argument("action", choices=("list", "add", "remove", "clear"))
    custom.add_argument("value", nargs="?")
    return parser


def main() -> None:
    parser = build_parser()
    args = parser.parse_args()
    if not args.command:
        interactive()
        return
