def result_dir() -> Path:
    try:
        base = Path(__file__).resolve().parent
    except NameError:
        base = Path.cwd()
    path = base / "results"
    path.mkdir(parents=True, exist_ok=True)
    return path


def export_paths(label: str) -> tuple[Path, Path]:
    stamp = datetime.now().strftime("%Y%m%d-%H%M%S")
    base = result_dir() / f"Tgproxycheck_{stamp}_{label}"
    return base.with_suffix(".txt"), base.with_suffix(".json")


def save_results(results: Any, path: str) -> None:
    suffix = Path(path).suffix.lower()
    if suffix == ".json":
        ProxyChecker.export_json(path, results)
    elif suffix == ".csv":
        ProxyChecker.export_csv(path, results)
    else:
        ProxyChecker.export_txt(path, results)
    console.print(f"[green]Сохранено:[/] [cyan]{path}[/]")


def prompt_save(results: Any, label: str) -> None:
    console.print("\n[bold cyan]Сохранить результат[/]")
    console.print("[green]1[/] TXT")
    console.print("[cyan]2[/] JSON")
    console.print("[magenta]3[/] TXT + JSON")
    console.print("[yellow]4[/] CSV")
    console.print("[dim]5[/] Не сохранять")
    choice = console.input("Выбор: ").strip()
    txt_path, json_path = export_paths(label)
    csv_path = txt_path.with_suffix(".csv")
    if choice == "1":
        save_results(results, str(txt_path))
    elif choice == "2":
        save_results(results, str(json_path))
    elif choice == "3":
        save_results(results, str(txt_path))
        save_results(results, str(json_path))
    elif choice == "4":
        save_results(results, str(csv_path))


def check_one(link: str, timeout: float, attempts: int, geo: bool) -> dict[str, Any]:
    with console.status("[bold cyan]Проверка прокси[/]", spinner="dots"):
        _, result = ProxyChecker.check_single(link, timeout=timeout, attempts=attempts, include_geo=geo, check_cover=True)
    print_single(result)
    return result


def load_links(path: str) -> list[str]:
    text = Path(path).read_text(encoding="utf-8", errors="replace")
    links = ProxyChecker.extract_proxies_from_text(text)
    if links:
        return links
    return [line.strip() for line in text.splitlines() if line.strip()]


def check_batch(links: list[str], workers: int, timeout: float, attempts: int) -> list[dict[str, Any]]:
    cancel_event = threading.Event()
    progress = Progress(SpinnerColumn(style="cyan"), TextColumn("[cyan]{task.description}"), BarColumn(bar_width=32, complete_style="green", finished_style="green"), TaskProgressColumn(), TimeElapsedColumn(), console=console)
    task = progress.add_task("Проверка", total=len(links))

    def callback(done: int, total: int, result: dict[str, Any]) -> None:
        progress.update(task, completed=done, description=f"Проверка {done}/{total}")

    try:
        with progress:
            results = ProxyChecker.check_many(links, workers=workers, timeout=timeout, attempts=attempts, include_geo=True, cancel_event=cancel_event, callback=callback)
    except KeyboardInterrupt:
        cancel_event.set()
        console.print("\n[yellow]Проверка остановлена.[/]")
        return []
    print_batch(results)
    return results


def custom_sources_path() -> Path:
    try:
        base = Path(__file__).resolve().parent
        if os.access(str(base), os.W_OK):
            return base / "custom_proxy_sources.json"
    except NameError:
        pass
    return Path.home() / "custom_proxy_sources.json"


def load_custom_sources() -> list[str]:
    try:
        data = json.loads(custom_sources_path().read_text(encoding="utf-8"))
        if isinstance(data, list):
            return list(dict.fromkeys(str(item).strip() for item in data if str(item).strip()))
    except Exception:
        pass
    return []


def save_custom_sources(sources: Iterable[str]) -> list[str]:
    unique = list(dict.fromkeys(str(item).strip() for item in sources if str(item).strip()))
    custom_sources_path().write_text(json.dumps(unique, ensure_ascii=False, indent=2), encoding="utf-8")
    return unique


def print_source_reports(reports: list[dict[str, Any]]) -> None:
    if not reports:
        return
    table = Table(title="Отчёт источников", box=box.SIMPLE_HEAVY, header_style="bold cyan", border_style="bright_black")
    table.add_column("Тип", width=10)
    table.add_column("Источник", overflow="ellipsis", max_width=46)
    table.add_column("Статус", width=10)
    table.add_column("Найдено", justify="right", width=9)
    table.add_column("Добавлено", justify="right", width=10)
    table.add_column("Сообщение", overflow="fold")
    for report in reports:
        kind = "Свой" if report.get("kind") == "custom" else "Публичный"
        table.add_row(kind, str(report.get("source") or ""), "ОК" if report.get("ok") else "ОШИБКА", str(report.get("found", 0)), str(report.get("added", 0)), str(report.get("message") or report.get("mirror") or ""))
    console.print(table)


def check_sources(workers: int, timeout: float, attempts: int, limit: int, custom_sources: Optional[Iterable[str]] = None) -> list[dict[str, Any]]:
    selected_custom = list(custom_sources) if custom_sources is not None else load_custom_sources()
    with console.status("[bold cyan]Загрузка публичных списков[/]", spinner="dots"):
        public_links, public_reports = ProxyChecker.fetch_public_proxies(timeout=min(10.0, timeout + 2.0))
        custom_links, custom_reports = ProxyChecker.fetch_proxies_from_sources(selected_custom, timeout=min(12.0, max(6.0, timeout))) if selected_custom else ([], [])
    links = []
    seen: set[str] = set()
    for link in public_links + custom_links:
        if link not in seen:
            seen.add(link)
            links.append(link)
    reports = [{**report, "kind": "public"} for report in public_reports]
    reports.extend({**report, "kind": "custom"} for report in custom_reports)
    ok_sources = sum(1 for report in reports if report.get("ok"))
    console.print(f"Источники: [cyan]{ok_sources}/{len(reports)}[/] | своих: [cyan]{len(custom_reports)}[/] | прокси: [cyan]{len(links)}[/]")
    print_source_reports(reports)
    if not links:
        console.print("[yellow]Публичные и свои источники не вернули прокси.[/]")
        return []
    if limit > 0:
        links = links[:limit]
    return check_batch(links, workers, timeout, attempts)


