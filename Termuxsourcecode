    table.add_row("Уверенность", str(result.get("confidence", "N/A")))
    table.add_row("Сервер", f"{proxy.get('server', 'N/A')}:{proxy.get('port', 'N/A')}")
    table.add_row("Протокол", str(result.get("proxy_type", "N/A")))
    if proxy.get("type") == "mtproto":
        table.add_row("Секрет", f"{secret.get('type', 'unknown')} | {secret.get('length', 0)} байт | {'валидный' if secret.get('valid') else 'невалидный'}")
    table.add_row("DNS", str(result.get("dns_status", "N/A")))
    table.add_row("IP", str(result.get("ip") or "N/A"))
