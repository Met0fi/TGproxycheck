    @staticmethod
    def _get_ip_asn_country(ip_str: str) -> Dict[str, Any]:
        cached = MTProtoChecker._asn_cache.get(ip_str)
        if cached: return cached
        result = {"asn": 0, "country": "", "error": None}
        try:
            session = MTProtoChecker._get_geo_session()
            resp = session.get(f"https://ipapi.co/{ip_str}/json/", timeout=5)
            if resp.status_code == 200:
                data = resp.json()
                asn_str = data.get("asn", "AS0")
                asn = int(asn_str.replace("AS", "")) if asn_str != "AS0" else 0
                result["asn"] = asn
                result["country"] = data.get("country_code", "")
        except Exception:
            pass
        MTProtoChecker._asn_cache.set(ip_str, result)
        return result

    @staticmethod
    def _test_raw_tcp_handshake(ip_str: str, port: int = 443, timeout: float = 2.5) -> bool:
        try:
            sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            sock.settimeout(timeout)
            result = sock.connect_ex((ip_str, port))
            sock.close()
            return result == 0
        except Exception:
            return False

    @staticmethod
    def _test_whitelist_status(proxy: Dict, mtproto_ok: bool = False, port_open: bool = False, ip: str = "", ping: Optional[float] = None) -> Tuple[str, bool]:
        if not proxy or not port_open or not mtproto_ok:
            return "Проверка не завершена", False
        secret = proxy.get('secret', '')
        if MTProtoChecker.check_ip_in_telegram_range(ip):
            sni = _decode_domain(secret) if secret.startswith('ee') else ""
            if sni and '.' in sni:
                return f"В БС (IP Telegram, SNI: {sni})", True
            return "В БС (IP Telegram)", True
        has_whitelisted_sni = False
        sni_domain = ""
        if secret.startswith('ee'):
            bs_compat = MTProtoChecker._detect_bs_compat_proxy(secret)
            sni_domain = bs_compat.get('sni_domain', '')
            if bs_compat.get('is_blocked_sni'):
                return f"Заблокированный SNI ({bs_compat['service_name']})", False
            if bs_compat.get('is_bs_compat') and bs_compat.get('is_russian_service'):
                has_whitelisted_sni = True
            elif sni_domain and sni_domain in BS_COMPAT_SNI_RU:
                has_whitelisted_sni = True
        ip_is_white = False
        ip_status = ""
        if MTProtoChecker._is_ip_in_whitelist_ranges(ip):
            ip_is_white = True
            ip_status = "CIDR РФ"
        else:
            asn_data = MTProtoChecker._get_ip_asn_country(ip)
            if asn_data.get("asn") in RU_TRUSTED_ASNS:
                ip_is_white = True
                ip_status = f"ASN {asn_data['asn']} доверенный"
            elif asn_data.get("country") == "RU":
                ip_is_white = True
                ip_status = f"IP РФ (ASN {asn_data.get('asn', 0)})"
        tspu_not_blocking = MTProtoChecker._test_raw_tcp_handshake(ip, 443)
        if has_whitelisted_sni and ip_is_white and tspu_not_blocking:
            return f"В БС (SNI: {sni_domain}, IP: {ip_status}, ТСПУ не блокирует)", True
        if has_whitelisted_sni and ip_is_white:
            return f"Вероятно в БС (SNI: {sni_domain}, IP: {ip_status}, ТСПУ не проверен)", True
        if has_whitelisted_sni and tspu_not_blocking:
            return f"Частично БС (SNI: {sni_domain}, ТСПУ не блокирует, IP не белый)", False
        if ip_is_white and tspu_not_blocking and not secret.startswith('ee'):
            return f"Возможно в БС (IP: {ip_status}, ТСПУ не блокирует, нет SNI)", False
        if ip_is_white and tspu_not_blocking:
            return f"Частично БС (IP: {ip_status}, ТСПУ не блокирует, SNI не из списка)", False
        if has_whitelisted_sni:
            return f"SNI из списка ({sni_domain}), но IP не белый", False
        if tspu_not_blocking:
            return "ТСПУ не блокирует, но нет SNI из списка и белого IP", False
        if secret.startswith('ee'):
            if sni_domain:
                return f"Не в БС (SNI: {sni_domain}, не из списка)", False
            return "Не в БС (Fake-TLS без проверенного SNI)", False
        elif secret.startswith('dd'):
            return "Не в БС (Padded, нет Fake-TLS)", False
        return "Не в БС (Standard)", False

    @classmethod
    def check_single(cls, link: str) -> Tuple[bool, Dict]:
        result = {
            'link': link, 'timestamp': datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
            'valid': False, 'error': None, 'proxy': None, 'ip': None, 'dns_status': '',
            'ping': None, 'jitter': None, 'ping_status': '', 'port_open': False, 'port_status': '',
            'mtproto_ok': False, 'mtproto_msg': '', 'geo': {}, 'secret_valid': False,
            'secret_msg': '', 'secret_info': {}, 'proxy_type': '', 'connection_score': 0,
            'advanced_test': {}, 'whitelist_status': '', 'is_whitelist': False, 'bs_compat_info': {},
            'telethon_ok': False, 'telethon_msg': '', 'carriers': {}
        }
        try:
            proxy_data = cls.parse_proxy_link(link)
            if not proxy_data:
                result['error'] = "Неверный формат ссылки"
                cls._collect_all_available_data(result)
                return False, result
            result['proxy'] = proxy_data

            if proxy_data.get('type') == 'socks5':
                result['proxy_type'] = 'SOCKS5'
                result['secret_valid'] = True
                result['secret_msg'] = 'SOCKS5 прокси'
                result['secret_info'] = {'valid': True, 'type': 'socks5', 'length': 0, 'hex_valid': False, 'message': 'SOCKS5 прокси'}
                ip, dns_status = cls.resolve_ip(proxy_data['server'])
                result['dns_status'] = dns_status
                if not ip:
                    result['error'] = f"DNS ошибка: {dns_status}"
                    cls._collect_all_available_data(result)
                    return False, result
                result['ip'] = ip
                result['geo'] = cls.get_geolocation(ip)
                port_open, port_status = cls.check_port_open(ip, proxy_data['port'], timeout=5.0)
                result['port_open'] = port_open
                result['port_status'] = port_status
                if not port_open:
                    result['error'] = f"Порт закрыт: {port_status}"
                    cls._collect_all_available_data(result)
                    return False, result
                ping, jitter, ping_status = cls.measure_ping(ip, proxy_data['port'], timeout=5.0)
                result['ping'] = ping
                result['jitter'] = jitter
                result['ping_status'] = ping_status
                carriers_res = cls.run_carrier_checks(proxy_data, timeout=6.0)
                result['carriers'] = carriers_res
                telethon_ok = any(carriers_res.values())
                result['telethon_ok'] = telethon_ok
                result['telethon_msg'] = "Успех" if telethon_ok else "Отказ"
                socks_ok = telethon_ok
                result['mtproto_ok'] = socks_ok
                result['mtproto_msg'] = "SOCKS5 Подключен" if socks_ok else "SOCKS5 Отказ"
                if not socks_ok:
                    result['error'] = "Не удалось подключиться через операторов"
                    result['valid'] = False
                    cls._collect_all_available_data(result)
                    return False, result
                score = 0
                if port_open: score += 33
                if socks_ok: score += 34
                if ping is not None and ping < 500: score += 33
                result['connection_score'] = score
                result['valid'] = True
                cls._collect_all_available_data(result)
                return True, result

            result['proxy_type'] = cls.detect_proxy_type(proxy_data['secret'])
            bs_compat_info = cls._detect_bs_compat_proxy(proxy_data['secret'])
            result['bs_compat_info'] = bs_compat_info
            secret_info = cls.check_secret_format(proxy_data['secret'])
            result['secret_info'] = secret_info
            result['secret_valid'] = secret_info['valid']
            result['secret_msg'] = secret_info['message']
            if not secret_info['valid']:
                result['error'] = f"Невалидный секрет: {secret_info['message']}"
                cls._collect_all_available_data(result)
                return False, result

            domain_extracted = _decode_domain(proxy_data['secret'])
            if _is_blocked(proxy_data['secret'], domain_extracted):
                result['error'] = f"Мусорный/Заблокированный домен ({domain_extracted})"
                cls._collect_all_available_data(result)
                return False, result

            ip, dns_status = cls.resolve_ip(proxy_data['server'])
            result['dns_status'] = dns_status
            if not ip:
                result['error'] = f"DNS ошибка: {dns_status}"
                cls._collect_all_available_data(result)
                return False, result
            result['ip'] = ip
            result['geo'] = cls.get_geolocation(ip)
            port_open, port_status = cls.check_port_open(ip, proxy_data['port'], timeout=5.0)
            result['port_open'] = port_open
            result['port_status'] = port_status
            if not port_open:  
                result['error'] = f"Порт закрыт: {port_status}"
                cls._collect_all_available_data(result)
                return False, result

            advanced_ok, advanced_msg, advanced_data = cls.advanced_connection_test(ip, proxy_data['port'], proxy_data['secret'], timeout=8.0)
            result['advanced_test'] = advanced_data
            ping, jitter, ping_status = cls.measure_ping(ip, proxy_data['port'], timeout=5.0)
            result['ping'] = ping
            result['jitter'] = jitter
            result['ping_status'] = ping_status
            
            secret = proxy_data.get('secret', '')
            if not secret.startswith('ee'):
                mtproto_ok, mtproto_msg, _ = cls.fast_mtproto_req_pq_test(ip, proxy_data['port'], secret, timeout=10.0)
            else:
                mtproto_ok, mtproto_msg = cls.mtproto_handshake_test(ip, proxy_data['port'], secret, timeout=10.0)
            result['mtproto_ok'] = mtproto_ok
            result['mtproto_msg'] = mtproto_msg

            carriers_res = cls.run_carrier_checks(proxy_data, timeout=6.0)
            result['carriers'] = carriers_res
            telethon_ok = any(carriers_res.values())
            result['telethon_ok'] = telethon_ok
            result['telethon_msg'] = "Успех" if telethon_ok else "Отказ"

            whitelist_msg, is_wl = cls._test_whitelist_status(proxy_data, mtproto_ok, port_open, ip, ping)
            result['whitelist_status'] = whitelist_msg
            result['is_whitelist'] = is_wl

            if not telethon_ok and not mtproto_ok:
                result['error'] = mtproto_msg
                cls._collect_all_available_data(result)
                return False, result

            score = 0
            if port_open: score += 20
            if mtproto_ok: score += 15
            if telethon_ok: score += 20
            if ping is not None and ping < 80: score += 20
            elif ping is not None and ping < 150: score += 15
            elif ping is not None and ping < 300: score += 10
            elif ping is not None and ping < 500: score += 5
            if is_wl: score += 15
            if bs_compat_info.get('is_bs_compat') and bs_compat_info.get('is_russian_service'):
                score += 10
            result['connection_score'] = min(score, 100)
            result['valid'] = telethon_ok or mtproto_ok
            if not result['valid']:
                result['error'] = "Провалены тесты соединения"
            cls._collect_all_available_data(result)
            return result['valid'], result
        except Exception as e:
            result['error'] = str(e)[:100]
            cls._collect_all_available_data(result)
            return False, result

    @staticmethod
    def _collect_all_available_data(result: Dict):
        defaults = {
            'proxy': {}, 'secret_info': {'valid': False, 'type': 'unknown', 'length': 0, 'hex_valid': False, 'message': 'Не проверен'},
            'geo': {'error': 'Не определена'}, 'advanced_test': {'tcp_connect': False, 'tcp_latency': None, 'ssl_test': False, 'http_probe': False, 'response_time': None},
            'dns_status': 'Не проверен', 'port_status': 'Не проверен', 'ping_status': 'Не проверен', 'mtproto_msg': 'Не проверен',
            'whitelist_status': 'Не определен', 'is_whitelist': False, 'bs_compat_info': {}, 'error': 'Неизвестная ошибка', 'carriers': {}
        }
        for k, v in defaults.items():
            if k not in result or result[k] is None:
                result[k] = v

class MTProtoCLI:
    def __init__(self):
        self.checker = MTProtoChecker()

    def _get_script_dir(self):
        try:
            return os.path.dirname(os.path.abspath(__file__))
        except NameError:
            return os.getcwd()

    def exit_app(self):
        print(f"\n{apply_gradient('Удачи, путник')}")
        os._exit(0)

    def show_author(self):
        os.system('clear' if os.name != 'nt' else 'cls')
        print(apply_gradient("=== Автор софта ==="))
        print(f"\n     ", end="")
        self._type_effect("https://t.me/D1edfr0mglitch3s", C)
        print(f"\n")
        input(f"{C}Нажмите Enter для возврата в меню...{R}")

    def _animate_header(self):
        lines = [
            "+--------------------------------------+",
            "|  TG Proxy Checker by MT v1.2.5       |",
            "+--------------------------------------+"
        ]
        for line in lines:
            for char in line:
                sys.stdout.write(apply_gradient(char))
                sys.stdout.flush()
                time.sleep(0.005)
            sys.stdout.write("\n")

    def _draw_progress(self, completed, total):
        pct = int((completed / total) * 100) if total > 0 else 100
        bar_len = 30
        filled = int(bar_len * completed / total) if total > 0 else bar_len
        bar = '#' * filled + '-' * (bar_len - filled)
        chars = ['|', '/', '-', '\\']
        idx = int(time.time() * 10) % len(chars)
        spinner_char = chars[idx]
        line = f"\r{C}{spinner_char}{R} {Y}Пакетная проверка...{R} [{G}{bar}{R}] {B}{pct}%{R}     "
        sys.stdout.write(line)
        sys.stdout.flush()

    def _type_effect(self, text, color=""):
        for char in text:
            sys.stdout.write(f"{color}{char}{R}")
            sys.stdout.flush()
            time.sleep(0.02)
        sys.stdout.write("\n")

    def run(self):
        while True:
            os.system('clear' if os.name != 'nt' else 'cls')
            self._animate_header()
            print(f"  {G}1.{R} {BD}Одиночная проверка{R}")
