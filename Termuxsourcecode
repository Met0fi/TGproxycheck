class TTLCache:
    def __init__(self, ttl: float) -> None:
        self.ttl = ttl
        self.storage: dict[str, tuple[float, Any]] = {}
        self.lock = threading.Lock()

    def get(self, key: str) -> Any:
        now = time.monotonic()
        with self.lock:
            item = self.storage.get(key)
            if not item:
                return None
            created, value = item
            if now - created > self.ttl:
                self.storage.pop(key, None)
                return None
            return value

    def set(self, key: str, value: Any) -> None:
        with self.lock:
            self.storage[key] = (time.monotonic(), value)


class AESCTR:
    def __init__(self, key: bytes, iv: bytes) -> None:
        if not HAS_CRYPTOGRAPHY:
            raise RuntimeError("Для глубокой MTProto-проверки установите cryptography")
        self.context = Cipher(algorithms.AES(key), modes.CTR(iv)).encryptor()

    def update(self, data: bytes) -> bytes:
        return self.context.update(data)


class ProxyChecker:
    _dns_cache = TTLCache(DNS_CACHE_TTL)
    _geo_cache = TTLCache(GEO_CACHE_TTL)
    _http_lock = threading.Lock()
    _http_session: Any = None
    _whitelist_lock = threading.Lock()
    _whitelist_cache: Optional[dict[str, Any]] = None
    _whitelist_loaded_at = 0.0
    _geo_sema = threading.Semaphore(4)

    @staticmethod
    def _strip_wrapping(text: str) -> str:
        return text.strip().strip("<>()[]{}'\".,;")

    @staticmethod
    def _normalize_whitelist_domain(value: str) -> str:
        domain = value.strip().rstrip(".").lower()
        if not domain:
            return ""
        try:
            return domain.encode("idna").decode("ascii")
        except Exception:
            return ""

    @staticmethod
    def _repo_values(text: str) -> list[str]:
        values: list[str] = []
        for raw_line in text.splitlines():
            value = raw_line.strip()
            if not value or value.startswith("#"):
                continue
            if "#" in value:
                value = value.split("#", 1)[0].strip()
            if value:
                values.append(value)
        return values

    @classmethod
    def _parse_whitelist_payloads(cls, payloads: dict[str, str]) -> dict[str, Any]:
        domains: set[str] = set()
        ip4: set[int] = set()
        ip6: set[int] = set()
        cidr4: dict[int, set[int]] = {}
        cidr6: dict[int, set[int]] = {}
        invalid = {"sni": 0, "ip": 0, "cidr": 0}
        for value in cls._repo_values(payloads.get("sni", "")):
            domain = cls._normalize_whitelist_domain(value)
            if domain and cls._valid_hostname(domain):
                domains.add(domain)
            else:
                invalid["sni"] += 1
        for value in cls._repo_values(payloads.get("ip", "")):
            try:
                address = ipaddress.ip_address(value)
            except ValueError:
                invalid["ip"] += 1
                continue
            target = ip4 if address.version == 4 else ip6
            target.add(int(address))
        for value in cls._repo_values(payloads.get("cidr", "")):
            try:
                network = ipaddress.ip_network(value, strict=False)
            except ValueError:
                invalid["cidr"] += 1
                continue
            min_prefix = 8 if network.version == 4 else 16
            if network.prefixlen < min_prefix:
                invalid["cidr"] += 1
                continue
            target = cidr4 if network.version == 4 else cidr6
            target.setdefault(network.prefixlen, set()).add(int(network.network_address))
        cidr4_frozen = {prefix: frozenset(values) for prefix, values in cidr4.items()}
        cidr6_frozen = {prefix: frozenset(values) for prefix, values in cidr6.items()}
        return {
            "loaded": True,
            "repo": RUSSIA_WHITELIST_REPO,
            "fetched_at": datetime.now(timezone.utc).astimezone().isoformat(timespec="seconds"),
            "domains": frozenset(domains),
            "ip4": frozenset(ip4),
            "ip6": frozenset(ip6),
            "cidr4": cidr4_frozen,
            "cidr6": cidr6_frozen,
            "counts": {
                "sni": len(domains),
                "ip": len(ip4) + len(ip6),
                "cidr": sum(len(values) for values in cidr4_frozen.values()) + sum(len(values) for values in cidr6_frozen.values()),
                "invalid_sni": invalid["sni"],
                "invalid_ip": invalid["ip"],
                "invalid_cidr": invalid["cidr"],
            },
            "urls": dict(RUSSIA_WHITELIST_URLS),
            "errors": [],
        }

    @classmethod
    def load_russia_whitelist(cls, timeout: float = 10.0, force: bool = False) -> dict[str, Any]:
        now = time.monotonic()
        cached = cls._whitelist_cache
        cache_ttl = RUSSIA_WHITELIST_CACHE_TTL if cached and cached.get("loaded") else 60.0
        if not force and cached is not None and now - cls._whitelist_loaded_at < cache_ttl:
            return cached
        with cls._whitelist_lock:
            now = time.monotonic()
            cached = cls._whitelist_cache
            cache_ttl = RUSSIA_WHITELIST_CACHE_TTL if cached and cached.get("loaded") else 60.0
            if not force and cached is not None and now - cls._whitelist_loaded_at < cache_ttl:
                return cached
            session = cls._get_http_session()
            if session is None:
                failure = {
                    "loaded": False,
                    "repo": RUSSIA_WHITELIST_REPO,
                    "counts": {"sni": 0, "ip": 0, "cidr": 0},
                    "urls": dict(RUSSIA_WHITELIST_URLS),
                    "errors": ["requests не установлен"],
                }
                cls._whitelist_cache = failure
                cls._whitelist_loaded_at = time.monotonic()
                return failure
            payloads: dict[str, str] = {}
            errors: list[str] = []
            def fetch(item: tuple[str, str]) -> tuple[str, str, str]:
                name, url = item
                try:
                    response = session.get(url, timeout=timeout)
                    response.raise_for_status()
                    if len(response.content) > 8 * 1024 * 1024:
                        return name, "", "файл превышает лимит 8 МБ"
                    return name, response.text, ""
                except Exception as exc:
                    return name, "", str(exc)
            with concurrent.futures.ThreadPoolExecutor(max_workers=3) as executor:
                futures = [executor.submit(fetch, item) for item in RUSSIA_WHITELIST_URLS.items()]
                for future in concurrent.futures.as_completed(futures):
                    name, text, error = future.result()
                    if error:
                        errors.append(f"{name}: {error}")
                    else:
                        payloads[name] = text
            if errors or len(payloads) != len(RUSSIA_WHITELIST_URLS):
                if cached is not None:
                    return cached
                failure = {
                    "loaded": False,
                    "repo": RUSSIA_WHITELIST_REPO,
                    "counts": {"sni": 0, "ip": 0, "cidr": 0},
                    "urls": dict(RUSSIA_WHITELIST_URLS),
                    "errors": errors or ["получены не все файлы репозитория"],
                }
                cls._whitelist_cache = failure
                cls._whitelist_loaded_at = time.monotonic()
                return failure
            parsed = cls._parse_whitelist_payloads(payloads)
            cls._whitelist_cache = parsed
            cls._whitelist_loaded_at = time.monotonic()
            return parsed

    @classmethod
    def refresh_russia_whitelist(cls, timeout: float = 10.0) -> dict[str, Any]:
        return cls.load_russia_whitelist(timeout=timeout, force=True)

    @classmethod
    def _match_whitelist_sni(cls, domain: str, domains: frozenset[str]) -> dict[str, Any]:
        normalized = cls._normalize_whitelist_domain(domain)
        if not normalized:
            return {"available": False, "domain": "", "matched": False, "exact": False, "matched_entry": "", "match_type": "none"}
        if normalized in domains:
            return {"available": True, "domain": normalized, "matched": True, "exact": True, "matched_entry": normalized, "match_type": "exact"}
        labels = normalized.split(".")
        for index in range(1, max(1, len(labels) - 1)):
            candidate = ".".join(labels[index:])
            if candidate in domains:
                return {"available": True, "domain": normalized, "matched": False, "exact": False, "parent_candidate": True, "matched_entry": candidate, "match_type": "parent_candidate"}
        return {"available": True, "domain": normalized, "matched": False, "exact": False, "parent_candidate": False, "matched_entry": "", "match_type": "none"}

    @staticmethod
    def _match_whitelist_ip(ip_value: str, data: dict[str, Any]) -> dict[str, Any]:
        try:
            address = ipaddress.ip_address(ip_value)
        except ValueError:
            return {"available": False, "ip": ip_value, "matched": False, "exact": False, "cidr": False, "matched_entry": "", "match_type": "none"}
        number = int(address)
        exact_values = data["ip4"] if address.version == 4 else data["ip6"]
        if number in exact_values:
            return {"available": True, "ip": str(address), "matched": True, "exact": True, "cidr": False, "matched_entry": str(address), "match_type": "exact_ip"}
        index = data["cidr4"] if address.version == 4 else data["cidr6"]
        bits = 32 if address.version == 4 else 128
        for prefix in sorted(index.keys(), reverse=True):
            shift = bits - prefix
            network_number = (number >> shift) << shift if shift else number
            if network_number in index[prefix]:
                network = ipaddress.ip_network((network_number, prefix))
                return {"available": True, "ip": str(address), "matched": True, "exact": False, "cidr": True, "matched_entry": str(network), "match_type": "cidr"}
        return {"available": True, "ip": str(address), "matched": False, "exact": False, "cidr": False, "matched_entry": "", "match_type": "none"}

    @classmethod
    def check_russia_whitelist(cls, ip_value: str, sni_domain: str = "", timeout: float = 10.0) -> dict[str, Any]:
        started = time.monotonic()
        data = cls.load_russia_whitelist(timeout=timeout)
        public = {
            "loaded": bool(data.get("loaded")),
            "repo": RUSSIA_WHITELIST_REPO,
            "fetched_at": data.get("fetched_at", ""),
            "counts": dict(data.get("counts", {})),
            "urls": dict(data.get("urls", RUSSIA_WHITELIST_URLS)),
            "errors": list(data.get("errors", [])),
            "universal_list": True,
            "operator_specific": False,
        }
        if not data.get("loaded"):
            public.update({
                "sni": {"available": bool(sni_domain), "domain": sni_domain, "matched": False, "exact": False, "matched_entry": "", "match_type": "unavailable"},
                "ip": {"available": bool(ip_value), "ip": ip_value, "matched": False, "exact": False, "cidr": False, "matched_entry": "", "match_type": "unavailable"},
                "matched": False,
                "combined_match": False,
                "status": "БС-база недоступна",
                "elapsed_ms": round((time.monotonic() - started) * 1000.0, 2),
            })
            return public
        sni = cls._match_whitelist_sni(sni_domain, data["domains"])
        ip_match = cls._match_whitelist_ip(ip_value, data)
        sni_match = bool(sni.get("matched"))
        sni_parent = bool(sni.get("parent_candidate"))
        address_match = bool(ip_match.get("matched"))
        if sni_domain and sni_match and address_match:
            status = f"SNI + IP найдены в {RUSSIA_WHITELIST_REPO}"
        elif sni_domain and sni_match:
            status = f"SNI найден, IP не найден в {RUSSIA_WHITELIST_REPO}"
        elif address_match and sni_parent:
            status = f"IP/CIDR найден; точного SNI нет, родитель {sni.get('matched_entry', '')} есть в списке"
        elif address_match:
            status = f"IP/CIDR найден, SNI {'не найден' if sni_domain else 'не применяется'}"
        elif sni_domain and sni_parent:
            status = f"Точного SNI нет; родитель {sni.get('matched_entry', '')} есть в списке, IP не найден"
        elif sni_domain:
            status = "SNI и IP не найдены в репозитории"
        else:
            status = "IP не найден в репозитории"
        public.update({
            "sni": sni,
            "ip": ip_match,
            "matched": sni_match or address_match,
            "combined_match": sni_match and address_match,
            "status": status,
            "elapsed_ms": round((time.monotonic() - started) * 1000.0, 2),
        })
        return public

    @staticmethod
    def _decode_mtproxy_secret(value: str) -> bytes:
        secret = urllib.parse.unquote(value.strip())
        if re.fullmatch(r"[0-9a-fA-F]+", secret) and len(secret) % 2 == 0:
            return bytes.fromhex(secret)
        normalized = secret.replace("-", "+").replace("_", "/")
        normalized += "=" * (-len(normalized) % 4)
        try:
            return base64.b64decode(normalized, validate=True)
        except Exception as exc:
            raise ValueError("секрет не является HEX или Base64") from exc

    @staticmethod
    def _valid_hostname(host: str) -> bool:
        value = host.rstrip(".")
        if not value or len(value) > 253:
            return False
        try:
            ipaddress.ip_address(value.strip("[]"))
            return True
        except ValueError:
            pass
        try:
            ascii_host = value.encode("idna").decode("ascii")
        except Exception:
            return False
        labels = ascii_host.split(".")
        return all(0 < len(label) <= 63 and re.fullmatch(r"[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?", label) for label in labels)

    @staticmethod
    def _normalize_web_proxy_host(value: str) -> str:
        source = value.strip()
        if not source or any(char in source for char in ":/?#@") or source.endswith("."):
            return ""
        try:
            host = source.encode("idna").decode("ascii").lower()
        except Exception:
            return ""
        if not host or len(host) > 253 or "." not in host:
            return ""
        labels = host.split(".")
        for label in labels:
            if not label or len(label) > 63 or label.startswith("-") or label.endswith("-"):
                return ""
            if re.fullmatch(r"[a-z0-9-]+", label) is None:
                return ""
        last = labels[-1]
        numeric = False
        if last.lower().startswith("0x"):
            digits = last[2:]
            numeric = all(char in "0123456789abcdefABCDEF" for char in digits)
        else:
            numeric = all(char.isdigit() and char.isascii() for char in last)
        if numeric:
            return ""
        try:
            ipaddress.ip_address(host)
            return ""
        except ValueError:
            return host

    @classmethod
    def parse_proxy_link(cls, value: str) -> ProxyEndpoint:
        raw = cls._strip_wrapping(value)
        if not raw:

            raise ValueError("пустая строка")
        if re.fullmatch(r"[^\s:]+:\d+:[0-9A-Fa-f]{32,}", raw):
            server, port_text, secret = raw.split(":", 2)
            raw = f"tg://proxy?server={urllib.parse.quote(server)}&port={port_text}&secret={secret}"
        if raw.lower().startswith(("t.me/", "telegram.me/", "telegram.dog/")):
            raw = "https://" + raw
        parsed = urllib.parse.urlsplit(raw)
        scheme = parsed.scheme.lower()
        host_path = parsed.path.lower()
        query = urllib.parse.parse_qs(parsed.query, keep_blank_values=True)
        telegram_domains = {"t.me", "telegram.me", "telegram.dog"}
        is_mt = scheme == "tg" and parsed.netloc.lower() == "proxy"
        is_mt = is_mt or scheme in {"http", "https"} and parsed.netloc.lower() in telegram_domains and host_path.rstrip("/") == "/proxy"
        is_web = scheme == "tg" and parsed.netloc.lower() == "webproxy"
        is_web = is_web or scheme in {"http", "https"} and parsed.netloc.lower() in telegram_domains and host_path.rstrip("/") == "/webproxy"
        is_socks_link = scheme == "tg" and parsed.netloc.lower() == "socks"
        is_socks_link = is_socks_link or scheme in {"http", "https"} and parsed.netloc.lower() in telegram_domains and host_path.rstrip("/") == "/socks"
        if is_mt:
            server = urllib.parse.unquote(query.get("server", [""])[0]).strip().strip("[]")
            port_text = query.get("port", [""])[0]
            secret_text = query.get("secret", [""])[0]
            if not server or not cls._valid_hostname(server):
                raise ValueError("некорректный адрес MTProxy")
            try:
                port = int(port_text)
            except Exception as exc:
                raise ValueError("некорректный порт") from exc
            if not 1 <= port <= 65535:
                raise ValueError("порт вне диапазона 1..65535")
            secret_raw = cls._decode_mtproxy_secret(secret_text)
            if not secret_raw:
                raise ValueError("пустой секрет")
            return ProxyEndpoint("mtproto", server, port, secret_raw.hex(), scheme=scheme)
        if is_web:
            server_text = urllib.parse.unquote(query.get("server", query.get("host", [""]))[0])
            server = cls._normalize_web_proxy_host(server_text)
            if not server:
                raise ValueError("некорректный адрес WEB proxy")
            if query.get("port", [""])[0].strip():
                raise ValueError("WEB proxy использует фиксированный порт 443")
            secret_text = query.get("secret", [""])[0]
            secret_raw = cls._decode_mtproxy_secret(secret_text)
            if not secret_raw:
                raise ValueError("пустой секрет WEB proxy")
            return ProxyEndpoint("web", server, 443, secret_raw.hex(), scheme=scheme)
        if is_socks_link:
            server = urllib.parse.unquote(query.get("server", [""])[0]).strip().strip("[]")
            port_text = query.get("port", [""])[0]
            if not server or not cls._valid_hostname(server):
                raise ValueError("некорректный адрес SOCKS5")
            try:
                port = int(port_text)
            except Exception as exc:
                raise ValueError("некорректный порт") from exc
            if not 1 <= port <= 65535:
                raise ValueError("порт вне диапазона 1..65535")
            username = urllib.parse.unquote(query.get("user", [""])[0])
            password = urllib.parse.unquote(query.get("pass", [""])[0])
            return ProxyEndpoint("socks5", server, port, username=username, password=password, scheme=scheme)
        if scheme in {"socks5", "socks5h"}:
            if parsed.hostname is None or parsed.port is None:
                raise ValueError("некорректный SOCKS5 URL")
            return ProxyEndpoint("socks5", parsed.hostname, parsed.port, username=urllib.parse.unquote(parsed.username or ""), password=urllib.parse.unquote(parsed.password or ""), scheme=scheme)
        if scheme in {"http", "https"} and parsed.hostname and parsed.port:
            return ProxyEndpoint("http", parsed.hostname, parsed.port, username=urllib.parse.unquote(parsed.username or ""), password=urllib.parse.unquote(parsed.password or ""), scheme=scheme)
        raise ValueError("поддерживаются tg://proxy, tg://webproxy, t.me/proxy, t.me/webproxy, tg://socks, SOCKS5 URL и HTTP CONNECT URL")

    @classmethod
    def extract_proxies_from_text(cls, text: str) -> list[str]:
        candidates: list[str] = []
        patterns = (
            r"(?:tg://proxy|https?://(?:t\.me|telegram\.me|telegram\.dog)/proxy)\?[^\s<>'\"]+",
            r"(?:tg://webproxy|https?://(?:t\.me|telegram\.me|telegram\.dog)/webproxy)\?[^\s<>'\"]+",
            r"(?:tg://socks|https?://(?:t\.me|telegram\.me|telegram\.dog)/socks)\?[^\s<>'\"]+",
            r"socks5h?://[^\s<>'\"]+",
            r"https?://(?:[^\s:@/]+(?::[^\s@/]*)?@)?(?:\[[0-9A-Fa-f:]+\]|[A-Za-z0-9._-]+):\d{1,5}",
            r"(?<![A-Za-z0-9._-])(?:[A-Za-z0-9._-]+):\d{1,5}:[0-9A-Fa-f]{32,}",
        )
        for pattern in patterns:
            candidates.extend(re.findall(pattern, text, flags=re.IGNORECASE))
        stripped = text.strip()
        if stripped.startswith("[") or stripped.startswith("{"):
            try:
                data = json.loads(stripped)
                stack = list(data if isinstance(data, list) else [data])
                while stack:
                    item = stack.pop()
                    if isinstance(item, dict):
                        link = item.get("link") or item.get("url")
                        if isinstance(link, str):
                            candidates.append(link)
                        server = item.get("server") or item.get("host")
                        port = item.get("port")
                        secret = item.get("secret")
                        kind = str(item.get("type") or item.get("kind") or item.get("protocol") or "").lower().replace("_", "").replace("-", "")
                        if server and secret and kind in {"web", "webproxy"}:
                            candidates.append(f"tg://webproxy?server={server}&secret={secret}")
                        elif server and port and secret:
                            candidates.append(f"tg://proxy?server={server}&port={port}&secret={secret}")
                        stack.extend(value for value in item.values() if isinstance(value, (list, dict)))
                    elif isinstance(item, list):
                        stack.extend(item)
            except Exception:
                pass
        unique: list[str] = []
        seen: set[str] = set()
        for candidate in candidates:
            try:
                endpoint = cls.parse_proxy_link(candidate)
                normalized = endpoint.normalized_link()
            except Exception:
                continue
            if normalized not in seen:
                seen.add(normalized)
                unique.append(normalized)
        return unique

    @classmethod
    def validate_web_secret(cls, secret_hex: str) -> dict[str, Any]:
        try:
            raw = bytes.fromhex(secret_hex)
        except ValueError:
            return {"valid": False, "type": "unknown", "message": "секрет WEB proxy не HEX", "length": 0, "cover_domain": ""}
        if len(raw) == 16:
            return {"valid": True, "type": "classic", "message": "WEB proxy: Classic, 16 байт", "length": 16, "cover_domain": ""}
        if len(raw) == 17 and raw[0] == 0xDD:
            return {"valid": True, "type": "padded", "message": "WEB proxy: Padded/DD, 16 байт ключа", "length": 17, "cover_domain": ""}
        if len(raw) >= 18 and raw[0] == 0xEE:
            return {"valid": False, "type": "fake_tls", "message": "WEB proxy не поддерживает FakeTLS/EE secret", "length": len(raw), "cover_domain": ""}
        return {"valid": False, "type": "unknown", "message": "WEB proxy ожидает 16 байт или DD+16 байт", "length": len(raw), "cover_domain": ""}

    @classmethod
    def validate_secret(cls, secret_hex: str) -> dict[str, Any]:
        try:
            raw = bytes.fromhex(secret_hex)
        except ValueError:
            return {"valid": False, "type": "unknown", "message": "секрет не HEX", "length": 0, "cover_domain": ""}
        if len(raw) == 16:
            return {"valid": True, "type": "classic", "message": "Classic, 16 байт", "length": 16, "cover_domain": ""}
        if len(raw) == 17 and raw[0] == 0xDD:
            return {"valid": True, "type": "padded", "message": "Padded/DD, 16 байт ключа", "length": 17, "cover_domain": ""}
        if len(raw) >= 18 and raw[0] == 0xEE:
            key = raw[1:17]
            suffix = raw[17:]
            try:
                domain = suffix.decode("ascii").strip().rstrip(".")
            except UnicodeDecodeError:
                return {"valid": False, "type": "fake_tls", "message": "SNI после EE не ASCII", "length": len(raw), "cover_domain": ""}
            if len(key) != 16 or not cls._valid_hostname(domain) or "." not in domain:
                return {"valid": False, "type": "fake_tls", "message": "некорректный FakeTLS SNI", "length": len(raw), "cover_domain": domain}
            return {"valid": True, "type": "fake_tls", "message": f"FakeTLS/EE, SNI {domain}", "length": len(raw), "cover_domain": domain}
        return {"valid": False, "type": "unknown", "message": "ожидается 16 байт, DD+16 байт или EE+16 байт+SNI", "length": len(raw), "cover_domain": ""}

    @classmethod
    def _resolve_doh(cls, host: str) -> list[str]:
        session = cls._get_http_session()
        if session is None:
            return []
        ips: list[str] = []
        headers = {"Accept": "application/dns-json"}
        for endpoint in DOH_ENDPOINTS:
            if len(ips) >= 4:
                break
            for record_type in ("A", "AAAA"):
                try:
                    response = session.get(endpoint, params={"name": host, "type": record_type}, headers=headers, timeout=3.0)
                    if response.status_code != 200:
                        continue
                    payload = response.json()
                    for answer in payload.get("Answer") or []:
                        if int(answer.get("type") or 0) not in {1, 28}:
                            continue
                        candidate = str(answer.get("data") or "").strip()
                        try:
                            ipaddress.ip_address(candidate)
                        except ValueError:
                            continue
                        if candidate not in ips:
                            ips.append(candidate)
                except Exception:
                    continue
        return ips

    @classmethod
    def resolve_host(cls, host: str) -> tuple[list[str], str]:
        cache_key = host.lower()
        cached = cls._dns_cache.get(cache_key)
        if cached is not None:
            return cached
        try:
            ip = str(ipaddress.ip_address(host.strip("[]")))
            result = ([ip], "IP указан напрямую")
            cls._dns_cache.set(cache_key, result)
            return result
        except ValueError:
            pass
        ips: list[str] = []
        dns_error = ""
        try:
            infos = socket.getaddrinfo(host, None, socket.AF_UNSPEC, socket.SOCK_STREAM)
            for family, _, _, _, sockaddr in infos:
                if family not in {socket.AF_INET, socket.AF_INET6}:
                    continue
                ip = sockaddr[0]
                if ip not in ips:
                    ips.append(ip)
        except socket.gaierror as exc:
            dns_error = str(exc)
        source = "DNS"
        if not ips:
            doh_ips = cls._resolve_doh(host)
            if doh_ips:
                ips = doh_ips
                source = "DoH"
        if ips:
            result = (ips, f"{source}: {', '.join(ips)}")
        else:
            result = ([], f"DNS ошибка: {dns_error}" if dns_error else "DNS не вернул адресов")
        cls._dns_cache.set(cache_key, result)
        return result

    @staticmethod
    def _connect_ip(ip: str, port: int, timeout: float) -> socket.socket:
        family = socket.AF_INET6 if ":" in ip else socket.AF_INET
        sock = socket.socket(family, socket.SOCK_STREAM)
        sock.settimeout(timeout)
        try:
            sock.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
        except OSError:
            pass
        if family == socket.AF_INET6:
            sock.connect((ip, port, 0, 0))
        else:
            sock.connect((ip, port))
        return sock

    @classmethod
    def _connect_endpoint(cls, host: str, port: int, timeout: float) -> socket.socket:
        ips, _ = cls.resolve_host(host)
        errors: list[str] = []
        for ip in ips[:4]:
            try:
                return cls._connect_ip(ip, port, timeout)
            except OSError as exc:
                errors.append(f"{ip}: {exc}")
        try:
            sock = socket.create_connection((host, port), timeout=timeout)
            sock.settimeout(timeout)
            try:
                sock.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
            except OSError:
                pass
            return sock
        except OSError as exc:
            detail = "; ".join(errors) if errors else str(exc)
            raise ConnectionError(detail) from exc

    @classmethod
    def measure_tcp(cls, ips: list[str], port: int, timeout: float, attempts: int) -> dict[str, Any]:
        samples: list[float] = []
        successes = 0
        errors: list[str] = []
        selected_ip = ""
        ordered_ips = ips[:4]
        for attempt in range(max(1, attempts)):
            connected = False
            for ip in ordered_ips:
                started = time.monotonic()
                try:
                    sock = cls._connect_ip(ip, port, timeout)
                    elapsed = (time.monotonic() - started) * 1000.0
                    sock.close()
                    samples.append(elapsed)
                    successes += 1
                    selected_ip = selected_ip or ip
                    connected = True
                    break
                except OSError as exc:
                    errors.append(f"{ip}: {exc}")
            if not connected and attempt + 1 < attempts:
                time.sleep(0.05)
        median = statistics.median(samples) if samples else None
        jitter = statistics.pstdev(samples) if len(samples) > 1 else (0.0 if samples else None)
        return {
            "ok": successes > 0,
            "selected_ip": selected_ip,
            "samples_ms": [round(value, 2) for value in samples],
            "median_ms": round(median, 2) if median is not None else None,
            "jitter_ms": round(jitter, 2) if jitter is not None else None,
            "successes": successes,
            "attempts": max(1, attempts),
            "loss_percent": round(100.0 * (1.0 - successes / max(1, attempts)), 1),
            "errors": errors[-4:],
        }

    @staticmethod
    def _message_id() -> int:
        now = time.time()
        seconds = int(now)
        fraction = int((now - seconds) * (1 << 32)) & 0xFFFFFFFF
        value = (seconds << 32) | fraction
        value &= ~3
        if value & 0xFFFFFFFF == 0:
            value |= 4
        return value

    @classmethod
    def _build_req_pq(cls) -> tuple[bytes, bytes, int]:
        nonce = secrets.token_bytes(16)
        body = struct.pack("<I", 0xBE7E8EF1) + nonce
        msg_id = cls._message_id()
        packet = b"\x00" * 8 + struct.pack("<Q", msg_id) + struct.pack("<I", len(body)) + body
        return packet, nonce, msg_id

    @staticmethod
    def _parse_res_pq(packet: bytes, nonce: bytes) -> tuple[bool, str]:
        if len(packet) < 72:
            return False, f"короткий MTProto ответ: {len(packet)} байт"
        if packet[:8] != b"\x00" * 8:
            return False, "ответ использует неожиданный auth_key_id"
        server_msg_id = struct.unpack("<Q", packet[8:16])[0]
        if server_msg_id % 2 == 0:
            return False, "некорректная чётность server msg_id"
        msg_len = struct.unpack("<I", packet[16:20])[0]
        if msg_len < 52 or msg_len > len(packet) - 20:
            return False, "некорректная длина MTProto body"
        body = packet[20:20 + msg_len]
        constructor = struct.unpack("<I", body[:4])[0]
        if constructor != 0x05162463:
            return False, f"ожидался resPQ, получен 0x{constructor:08x}"
        if body[4:20] != nonce:
            return False, "nonce в resPQ не совпал"
        offset = 36
        if offset >= len(body):
            return False, "resPQ не содержит pq"
        first = body[offset]
        if first < 254:
            pq_len = first
            header_len = 1
        elif first == 254 and offset + 4 <= len(body):
            pq_len = int.from_bytes(body[offset + 1:offset + 4], "little")
            header_len = 4
        else:
            return False, "некорректная TL-строка pq"
        if pq_len <= 0 or pq_len > 32:
            return False, "некорректный размер pq"
        padded = (header_len + pq_len + 3) & ~3
        vector_offset = offset + padded
        if vector_offset + 8 > len(body):
            return False, "resPQ не содержит fingerprints"
        vector_constructor = struct.unpack("<I", body[vector_offset:vector_offset + 4])[0]
        if vector_constructor != 0x1CB5C415:
            return False, "некорректный Vector fingerprints"
        count = struct.unpack("<I", body[vector_offset + 4:vector_offset + 8])[0]
        if count < 1 or count > 64 or vector_offset + 8 + count * 8 > len(body):
            return False, "некорректное число server_public_key_fingerprints"
        return True, f"корректный resPQ: nonce совпал, fingerprints={count}"

    @staticmethod
    def _secret_key(secret_hex: str) -> tuple[bytes, str]:
        raw = bytes.fromhex(secret_hex)
        if len(raw) == 16:
            return raw, "classic"
        if len(raw) == 17 and raw[0] == 0xDD:
            return raw[1:], "padded"
        if len(raw) >= 18 and raw[0] == 0xEE:
            return raw[1:17], "fake_tls"
        raise ValueError("неподдерживаемый секрет")

    @staticmethod
    def _build_mtproxy_header(secret_key: bytes, dc_id: int, randomized: bool) -> tuple[bytes, AESCTR, AESCTR]:
        forbidden = {b"PVrG", b"GET ", b"POST", b"HEAD", b"OPTI", b"\xee\xee\xee\xee", b"\xdd\xdd\xdd\xdd"}
        while True:
            random_data = bytearray(secrets.token_bytes(64))
            if random_data[0] == 0xEF:
                continue
            if bytes(random_data[:4]) in forbidden:
                continue
            if bytes(random_data[4:8]) == b"\x00\x00\x00\x00":
                continue
            break
        reversed_data = bytes(random_data[55:7:-1])
        enc_key = hashlib.sha256(bytes(random_data[8:40]) + secret_key).digest()
        enc_iv = bytes(random_data[40:56])
        dec_key = hashlib.sha256(reversed_data[:32] + secret_key).digest()
        dec_iv = reversed_data[32:48]
        encryptor = AESCTR(enc_key, enc_iv)
        decryptor = AESCTR(dec_key, dec_iv)
        random_data[56:60] = b"\xdd\xdd\xdd\xdd" if randomized else b"\xee\xee\xee\xee"
        random_data[60:62] = int(dc_id).to_bytes(2, "little", signed=True)
        encrypted = encryptor.update(bytes(random_data))
        random_data[56:64] = encrypted[56:64]
        return bytes(random_data), encryptor, decryptor

    @staticmethod
    def _recv_exact(sock: socket.socket, count: int) -> bytes:
        chunks = bytearray()
        while len(chunks) < count:
            chunk = sock.recv(count - len(chunks))
            if not chunk:
                raise ConnectionError("соединение закрыто до получения полного ответа")
            chunks.extend(chunk)
        return bytes(chunks)

    @classmethod
    def _mtproxy_req_pq_once(cls, ip: str, port: int, secret_hex: str, dc_id: int, timeout: float) -> tuple[bool, str, float]:
        key, secret_type = cls._secret_key(secret_hex)
        randomized = secret_type == "padded"
        started = time.monotonic()
        sock = cls._connect_ip(ip, port, timeout)
        try:
            header, encryptor, decryptor = cls._build_mtproxy_header(key, dc_id, randomized)
            sock.sendall(header)
            packet, nonce, _ = cls._build_req_pq()
            padding = secrets.token_bytes(secrets.randbelow(4)) if randomized else b""
            framed = struct.pack("<i", len(packet) + len(padding)) + packet + padding
            sock.sendall(encryptor.update(framed))
            enc_len = cls._recv_exact(sock, 4)
            plain_len = decryptor.update(enc_len)
            frame_len = struct.unpack("<i", plain_len)[0]
            if frame_len <= 0 or frame_len > MAX_RESPONSE_BYTES:
                return False, f"некорректная длина MTProxy-фрейма: {frame_len}", 0.0
            enc_payload = cls._recv_exact(sock, frame_len)
            payload = decryptor.update(enc_payload)
            ok, message = cls._parse_res_pq(payload, nonce)
            elapsed = (time.monotonic() - started) * 1000.0
            return ok, message, elapsed
        finally:
            sock.close()

    @classmethod
    def _mtproxy_req_pq(cls, ips: list[str], port: int, secret_hex: str, timeout: float, attempts: int) -> dict[str, Any]:
        records: list[dict[str, Any]] = []
        successes = 0
        last_message = "нет попыток"
        for attempt in range(max(1, attempts)):
            dc_id = (2, 4, 1, 5, 3)[attempt % 5]
            for ip in ips[:3]:
                try:
                    ok, message, elapsed = cls._mtproxy_req_pq_once(ip, port, secret_hex, dc_id, timeout)
                except Exception as exc:
                    ok, message, elapsed = False, str(exc), 0.0
                records.append({"ip": ip, "dc_id": dc_id, "ok": ok, "message": message, "latency_ms": round(elapsed, 2) if elapsed else None})
                last_message = message
                if ok:
                    successes += 1
                    break
            if successes >= 1:
                break
        latencies = [item["latency_ms"] for item in records if item["ok"] and item["latency_ms"] is not None]
        required = 1
        return {
            "ok": successes >= required,
            "successes": successes,
            "required": required,
            "attempts": max(1, attempts),
            "latency_ms": round(statistics.median(latencies), 2) if latencies else None,
            "message": f"resPQ подтверждён: {successes}/{max(1, attempts)}" if successes else last_message,
            "records": records,
        }

    @staticmethod
    def _build_sni_extension(domain: str) -> bytes:
        sni = domain.encode("ascii")
        entry = b"\x00" + struct.pack(">H", len(sni)) + sni
        body = struct.pack(">H", len(entry)) + entry
        return b"\x00\x00" + struct.pack(">H", len(body)) + body

    @classmethod
    def _build_fake_tls_client_hello(cls, domain: str, random_field: bytes) -> bytes:
        session_id = secrets.token_bytes(32)
        cipher_suites = bytes.fromhex("130113021303c02bc02fc02cc030cca9cca8c013c014009c009d002f0035")
        extensions = cls._build_sni_extension(domain)
        extensions += b"\x00\x17\x00\x00"
        extensions += b"\xff\x01\x00\x01\x00"
        extensions += b"\x00\x0a\x00\x08\x00\x06\x00\x1d\x00\x17\x00\x18"
        extensions += b"\x00\x0b\x00\x02\x01\x00"
        extensions += b"\x00\x23\x00\x00"
        alpn = b"\x02h2\x08http/1.1"
        extensions += b"\x00\x10" + struct.pack(">H", len(alpn) + 2) + struct.pack(">H", len(alpn)) + alpn
        extensions += b"\x00\x05\x00\x05\x01\x00\x00\x00\x00"
        sig_algs = bytes.fromhex("040308040401050308050501080606010201")
        extensions += b"\x00\x0d" + struct.pack(">H", len(sig_algs) + 2) + struct.pack(">H", len(sig_algs)) + sig_algs
        extensions += b"\x00\x12\x00\x00"
        x25519 = secrets.token_bytes(32)
        key_share = b"\x00\x1d" + struct.pack(">H", len(x25519)) + x25519
        key_share_list = struct.pack(">H", len(key_share)) + key_share
        extensions += b"\x00\x33" + struct.pack(">H", len(key_share_list)) + key_share_list
        extensions += b"\x00\x2d\x00\x02\x01\x01"
        extensions += b"\x00\x2b\x00\x05\x04\x03\x04\x03\x03"
        extensions += b"\x00\x1b\x00\x03\x02\x00\x02"
        current_total = 5 + 4 + 2 + 32 + 1 + 32 + 2 + len(cipher_suites) + 2 + 2 + len(extensions)
        pad_needed = max(0, 517 - current_total - 4)
        extensions += b"\x00\x15" + struct.pack(">H", pad_needed) + b"\x00" * pad_needed
        body = b"\x03\x03" + random_field + bytes([len(session_id)]) + session_id
        body += struct.pack(">H", len(cipher_suites)) + cipher_suites + b"\x01\x00"
        body += struct.pack(">H", len(extensions)) + extensions
        handshake = b"\x01" + struct.pack(">I", len(body))[1:] + body
        return b"\x16\x03\x01" + struct.pack(">H", len(handshake)) + handshake


    @classmethod
    def _recv_tls_record(cls, sock: socket.socket) -> tuple[int, bytes, bytes]:
        header = cls._recv_exact(sock, 5)
        record_type = header[0]
        version = header[1:3]
        length = struct.unpack(">H", header[3:5])[0]
        if length > 65535:
            raise ValueError("слишком большой TLS record")
        return record_type, version, cls._recv_exact(sock, length)

    @classmethod
    def _fake_tls_once(cls, ip: str, port: int, secret_hex: str, timeout: float) -> tuple[bool, str, float, dict[str, Any]]:
        raw = bytes.fromhex(secret_hex)
        key = raw[1:17]
        domain = raw[17:].decode("ascii").strip().rstrip(".")
        zero_hello = cls._build_fake_tls_client_hello(domain, b"\x00" * TLS_DIGEST_LEN)
        client_hmac = hmac.new(key, zero_hello, hashlib.sha256).digest()
        timestamp = int(time.time()).to_bytes(4, "little")
        mask = b"\x00" * 28 + timestamp
        random_field = bytes(a ^ b for a, b in zip(client_hmac, mask))
        hello = bytearray(zero_hello)
        hello[TLS_DIGEST_POS:TLS_DIGEST_POS + TLS_DIGEST_LEN] = random_field
        started = time.monotonic()
        sock = cls._connect_ip(ip, port, timeout)
        try:
            sock.sendall(bytes(hello))
            record_type, version, payload = cls._recv_tls_record(sock)
            if record_type != 0x16 or not payload or payload[0] != 0x02:
                return False, "ответ не является FakeTLS ServerHello", 0.0, {"record_type": record_type}
            first_record = b"\x16" + version + struct.pack(">H", len(payload)) + payload
            if len(first_record) < TLS_DIGEST_POS + TLS_DIGEST_LEN:
                return False, "ServerHello слишком короткий", 0.0, {}
            server_digest = first_record[TLS_DIGEST_POS:TLS_DIGEST_POS + TLS_DIGEST_LEN]
            full_response = bytearray(first_record)
            sock.settimeout(min(1.5, max(0.3, timeout / 3)))
            while len(full_response) < 65536:
                try:
                    chunk = sock.recv(min(4096, 65536 - len(full_response)))
                    if not chunk:
                        break
                    full_response.extend(chunk)
                except socket.timeout:
                    break
                except (BlockingIOError, OSError, ConnectionError):
                    break
            zeroed = bytes(full_response[:TLS_DIGEST_POS]) + b"\x00" * TLS_DIGEST_LEN + bytes(full_response[TLS_DIGEST_POS + TLS_DIGEST_LEN:])
            expected = hmac.new(key, random_field + zeroed, hashlib.sha256).digest()
            elapsed = (time.monotonic() - started) * 1000.0
            if not hmac.compare_digest(expected, server_digest):
                return False, "HMAC ServerHello не совпал: секрет прокси не подтверждён", elapsed, {"domain": domain}
            return True, "FakeTLS HMAC подтверждён: сервер распознал секрет", elapsed, {"domain": domain, "response_bytes": len(full_response)}
        finally:
            sock.close()

    @classmethod
    def _fake_tls_check(cls, ips: list[str], port: int, secret_hex: str, timeout: float, attempts: int) -> dict[str, Any]:
        records: list[dict[str, Any]] = []
        successes = 0
        for attempt in range(max(1, attempts)):
            for ip in ips[:3]:
                try:
                    ok, message, elapsed, details = cls._fake_tls_once(ip, port, secret_hex, timeout)
                except Exception as exc:
                    ok, message, elapsed, details = False, str(exc), 0.0, {}
                records.append({"ip": ip, "ok": ok, "message": message, "latency_ms": round(elapsed, 2) if elapsed else None, **details})
                if ok:
                    successes += 1
                    break
            if successes >= 1:
                break
        latencies = [item["latency_ms"] for item in records if item["ok"] and item["latency_ms"] is not None]
        required = 1
        return {
            "ok": successes >= required,
            "successes": successes,
            "required": required,
            "attempts": max(1, attempts),
            "latency_ms": round(statistics.median(latencies), 2) if latencies else None,
            "message": f"FakeTLS HMAC подтверждён: {successes}/{max(1, attempts)}" if successes else (records[-1]["message"] if records else "нет попыток"),
            "records": records,
        }

    @classmethod
    def _socks5_open_tunnel(cls, endpoint: ProxyEndpoint, target_host: str, target_port: int, timeout: float) -> socket.socket:
        sock = cls._connect_endpoint(endpoint.server, endpoint.port, timeout)
        sock.settimeout(timeout)
        try:
            methods = [0x00]
            if endpoint.username:
                methods.append(0x02)
            sock.sendall(bytes([0x05, len(methods), *methods]))
            response = cls._recv_exact(sock, 2)
            if response[0] != 0x05 or response[1] == 0xFF:
                raise ConnectionError("SOCKS5 не принял метод авторизации")
            if response[1] == 0x02:
                username = endpoint.username.encode("utf-8")
                password = endpoint.password.encode("utf-8")
                if len(username) > 255 or len(password) > 255:
                    raise ValueError("слишком длинные SOCKS5 credentials")
                sock.sendall(bytes([0x01, len(username)]) + username + bytes([len(password)]) + password)
                auth = cls._recv_exact(sock, 2)
                if auth[1] != 0x00:
                    raise PermissionError("SOCKS5 авторизация отклонена")
            try:
                target_ip = ipaddress.ip_address(target_host)
                if target_ip.version == 4:
                    address = b"\x01" + target_ip.packed
                else:
                    address = b"\x04" + target_ip.packed
            except ValueError:
                encoded = target_host.encode("idna")
                address = b"\x03" + bytes([len(encoded)]) + encoded
            sock.sendall(b"\x05\x01\x00" + address + struct.pack(">H", target_port))
            head = cls._recv_exact(sock, 4)
            if head[0] != 0x05 or head[1] != 0x00:
                raise ConnectionError(f"SOCKS5 CONNECT отклонён, код {head[1]}")
            if head[3] == 0x01:
                cls._recv_exact(sock, 4 + 2)
            elif head[3] == 0x04:
                cls._recv_exact(sock, 16 + 2)
            elif head[3] == 0x03:
                size = cls._recv_exact(sock, 1)[0]
                cls._recv_exact(sock, size + 2)
            else:
                raise ConnectionError("SOCKS5 вернул неизвестный ATYP")
            return sock
        except Exception:
            sock.close()
            raise

    @classmethod
    def _http_open_tunnel(cls, endpoint: ProxyEndpoint, target_host: str, target_port: int, timeout: float) -> socket.socket:
        sock = cls._connect_endpoint(endpoint.server, endpoint.port, timeout)
        if endpoint.scheme == "https":
            context = ssl.create_default_context()
            try:
                sock = context.wrap_socket(sock, server_hostname=endpoint.server)
            except Exception:
                sock.close()
                raise
        sock.settimeout(timeout)
        try:
            try:
                parsed_ip = ipaddress.ip_address(target_host.strip("[]"))
                host_header = f"[{parsed_ip}]" if parsed_ip.version == 6 else str(parsed_ip)
            except ValueError:
                host_header = target_host
            target = f"{host_header}:{target_port}"
            headers = [f"CONNECT {target} HTTP/1.1", f"Host: {target}", "Proxy-Connection: keep-alive"]
            if endpoint.username:
                token = base64.b64encode(f"{endpoint.username}:{endpoint.password}".encode()).decode()
                headers.append(f"Proxy-Authorization: Basic {token}")
            request = "\r\n".join(headers) + "\r\n\r\n"
            sock.sendall(request.encode("ascii"))
            data = bytearray()
            while b"\r\n\r\n" not in data and len(data) < 16384:
                chunk = sock.recv(2048)
                if not chunk:
                    break
                data.extend(chunk)
            first_line = bytes(data).split(b"\r\n", 1)[0].decode("latin1", errors="replace")
            match = re.match(r"HTTP/\d(?:\.\d)?\s+(\d{3})", first_line)
            if not match or int(match.group(1)) // 100 != 2:
                raise ConnectionError(f"HTTP CONNECT отклонён: {first_line or 'нет ответа'}")
            return sock
        except Exception:
            sock.close()
            raise

    @classmethod
    def _telegram_req_pq_over_tunnel(cls, sock: socket.socket) -> tuple[bool, str, float]:
        started = time.monotonic()
        packet, nonce, _ = cls._build_req_pq()
        sock.sendall(b"\xef")
        words = len(packet) // 4
        if words < 127:
            frame = bytes([words]) + packet
        else:
            frame = b"\x7f" + struct.pack("<I", words)[:3] + packet
        sock.sendall(frame)
        first = cls._recv_exact(sock, 1)[0]
        if first < 127:
            length = first * 4
        else:
            length = int.from_bytes(cls._recv_exact(sock, 3) + b"\x00", "little") * 4
        if length <= 0 or length > MAX_RESPONSE_BYTES:
            return False, f"некорректный Telegram frame: {length}", 0.0
        response = cls._recv_exact(sock, length)
        ok, message = cls._parse_res_pq(response, nonce)
        elapsed = (time.monotonic() - started) * 1000.0
        return ok, message, elapsed

    @classmethod
    def _generic_proxy_telegram_check(cls, endpoint: ProxyEndpoint, timeout: float, attempts: int) -> dict[str, Any]:
        records: list[dict[str, Any]] = []
        successes = 0
        targets = list(TELEGRAM_DC_ENDPOINTS) + list(TELEGRAM_DC_MEDIA) + list(TELEGRAM_DC_ENDPOINTS_V6)
        limit = max(3, attempts + 2)
        for dc_id, host, port in targets:
            if len(records) >= limit:
                break
            sock: Optional[socket.socket] = None
            try:
                if endpoint.kind == "socks5":
                    sock = cls._socks5_open_tunnel(endpoint, host, port, timeout)
                else:
                    sock = cls._http_open_tunnel(endpoint, host, port, timeout)
                ok, message, elapsed = cls._telegram_req_pq_over_tunnel(sock)
            except Exception as exc:
                ok, message, elapsed = False, str(exc), 0.0
            finally:
                if sock is not None:
                    try:
                        sock.close()
                    except Exception:
                        pass
            records.append({"dc_id": dc_id, "target": host, "ok": ok, "message": message, "latency_ms": round(elapsed, 2) if elapsed else None})
            if ok:
                successes += 1
                if successes >= 1:
                    break
        latencies = [item["latency_ms"] for item in records if item["ok"] and item["latency_ms"] is not None]
        required = 1
        return {
            "ok": successes >= required,
            "successes": successes,
            "required": required,
            "attempts": len(records),
            "latency_ms": round(statistics.median(latencies), 2) if latencies else None,
            "message": f"Telegram resPQ через прокси: {successes}/{len(records)} DC" if successes else (records[-1]["message"] if records else "нет попыток"),
            "records": records,
        }

    @staticmethod
    def _web_frame(frame_type: int, stream_id: int, payload: bytes = b"") -> bytes:
        if not 0 <= stream_id <= 0xFFFFFF:
            raise ValueError("WEB stream_id вне диапазона")
        if len(payload) > 1024 * 1024:
            raise ValueError("WEB payload превышает 1 МБ")
        if frame_type == 0x01:
            if stream_id == 0 or payload:
                raise ValueError("некорректный WEB OPEN")
        elif frame_type == 0x02:
            if stream_id == 0 or not payload:
                raise ValueError("некорректный WEB DATA")
        elif frame_type == 0x03:
            if stream_id == 0 or payload:
                raise ValueError("некорректный WEB CLOSE")
        elif frame_type == 0x04:
            if stream_id == 0 or len(payload) != 4 or int.from_bytes(payload, "big") == 0:
                raise ValueError("некорректный WEB WINDOW")
        elif frame_type in {0x05, 0x06}:
            if stream_id != 0:
                raise ValueError("некорректный WEB PING/PONG")
        elif frame_type == 0x10:
            if stream_id != 0 or payload != b"\x01":
                raise ValueError("некорректный WEB HELLO")
        elif frame_type == 0x11:
            if stream_id != 0 or payload:
                raise ValueError("некорректный WEB WELCOME")
        elif frame_type == 0x1F:
            if stream_id != 0:
                raise ValueError("некорректный WEB BYE")
        else:
            raise ValueError(f"неизвестный WEB frame type 0x{frame_type:02x}")
        return bytes([frame_type]) + stream_id.to_bytes(3, "big") + len(payload).to_bytes(4, "big") + payload

    @classmethod
    def _web_parse_frames(cls, data: bytes) -> list[tuple[int, int, bytes]]:
        frames: list[tuple[int, int, bytes]] = []
        offset = 0
        while offset < len(data):
            if len(frames) >= 4096:
                raise ValueError("WEB frame batch превышает 4096 кадров")
            if len(data) - offset < 8:
                raise ValueError("неполный WEB frame header")
            frame_type = data[offset]
            stream_id = int.from_bytes(data[offset + 1:offset + 4], "big")
            length = int.from_bytes(data[offset + 4:offset + 8], "big")
            if length > 1024 * 1024:
                raise ValueError("WEB frame payload превышает 1 МБ")
            end = offset + 8 + length
            if end > len(data):
                raise ValueError("неполный WEB frame payload")
            payload = data[offset + 8:end]
            cls._web_frame(frame_type, stream_id, payload)
            frames.append((frame_type, stream_id, payload))
            offset = end
        if not frames:
            raise ValueError("пустой WEB frame batch")
        return frames

    @staticmethod
    def _web_token_valid(value: str) -> bool:
        if re.fullmatch(r"[A-Za-z0-9_-]{43}", value) is None:
            return False
        try:
            decoded = base64.urlsafe_b64decode(value + "=")
        except Exception:
            return False
        return len(decoded) == 32 and base64.urlsafe_b64encode(decoded).rstrip(b"=").decode("ascii") == value

    @classmethod
    def _web_bridge_capability(cls, host: str, secret_hex: str) -> str:
        canonical_host = cls._normalize_web_proxy_host(host)
        if canonical_host != host:
            raise ValueError("WEB hostname не канонический")
        secret_info = cls.validate_web_secret(secret_hex)
        if not secret_info.get("valid"):
            raise ValueError(secret_info.get("message") or "некорректный WEB secret")
        secret = bytes.fromhex(secret_hex)
        context = f"tdesktop-web-proxy-bridge-v1\n{canonical_host}".encode("utf-8")
        digest = hmac.new(secret, context, hashlib.sha256).digest()
        return base64.urlsafe_b64encode(digest).rstrip(b"=").decode("ascii")

    @classmethod
    def _web_https_request(cls, host: str, method: str, path: str, timeout: float, headers: Optional[dict[str, str]] = None, body: Optional[bytes] = None) -> dict[str, Any]:
        context = ssl.create_default_context()
        connection = http.client.HTTPSConnection(host, 443, timeout=timeout, context=context)
        started = time.monotonic()
        try:
            connection.connect()
            tls_version = connection.sock.version() if connection.sock is not None else ""
            cipher_info = connection.sock.cipher() if connection.sock is not None else None
            cipher = cipher_info[0] if cipher_info else ""
            request_headers = {
                "User-Agent": f"{APP_FAMILY}/{VERSION}",
                "Accept": "*/*",
                "Accept-Encoding": "identity",
                "Connection": "close",
            }
            if headers:
                request_headers.update(headers)
            connection.request(method, path, body=body, headers=request_headers)
            response = connection.getresponse()
            payload = response.read(MAX_RESPONSE_BYTES + 1)
            if len(payload) > MAX_RESPONSE_BYTES:
                raise ValueError("ответ WEB proxy превышает лимит")
            response_headers: dict[str, str] = {}
            for key, value in response.getheaders():
                normalized = key.lower()
                if normalized in response_headers:
                    response_headers[normalized] += ", " + value
                else:
                    response_headers[normalized] = value
            return {
                "status": response.status,
                "reason": response.reason,
                "headers": response_headers,
                "body": payload,
                "latency_ms": round((time.monotonic() - started) * 1000.0, 2),
                "tls_version": tls_version,
                "cipher": cipher,
            }
        finally:
            connection.close()

    @classmethod
    def _web_https_request_retry(cls, host: str, method: str, path: str, timeout: float, headers: Optional[dict[str, str]] = None, body: Optional[bytes] = None) -> dict[str, Any]:
        deadline = time.monotonic() + max(6.0, min(90.0, timeout * 4.0))
        delay = 0.25
        last_error: Optional[Exception] = None
        while True:
            try:
                response = cls._web_https_request(host, method, path, timeout, headers, body)
                last_error = None
            except Exception as exc:
                last_error = exc
                response = None
            if response is not None and response["status"] != 503:
                return response
            if response is not None:
                retry_after = response["headers"].get("retry-after", "")
                try:
                    wait = max(0.0, min(30.0, float(retry_after)))
                except ValueError:
                    wait = delay + secrets.randbelow(100) / 1000.0
            else:
                wait = delay + secrets.randbelow(100) / 1000.0
            if time.monotonic() + wait >= deadline:
                if response is not None:
                    return response
                if last_error is not None:
                    raise last_error
                raise TimeoutError("WEB carrier retry budget исчерпан")
            time.sleep(wait)
            delay = min(5.0, delay * 2.0)

    @staticmethod
    def _web_bridge_bootstrap(body: bytes) -> tuple[str, str]:
        text = body.decode("utf-8", errors="replace")
        bootstrap_match = re.search(r'\bbootstrap\s*=\s*("(?:\\.|[^"\\])*")', text)
        carrier_match = re.search(r'\bcarrierMode\s*=\s*("(?:\\.|[^"\\])*")', text)
        if not bootstrap_match or not carrier_match:
            raise ValueError("bridge page не содержит bootstrap/carrier mode")
        bootstrap = json.loads(bootstrap_match.group(1))
        carrier_mode = json.loads(carrier_match.group(1))
        if not isinstance(bootstrap, str) or not ProxyChecker._web_token_valid(bootstrap):
            raise ValueError("некорректный bootstrap token WEB proxy")
        if carrier_mode not in {"https", "https-lanes", "websocket", "websocket-lanes"}:
            raise ValueError("неизвестный carrier mode WEB proxy")
        if "TelegramWebProxy" not in text or "/api/v1/session" not in text:
            raise ValueError("ответ не похож на WEB proxy bridge")
        return bootstrap, carrier_mode

    @staticmethod
    def _web_is_bridge_page(body: bytes) -> bool:
        text = body.decode("utf-8", errors="ignore")
        return "TelegramWebProxy" in text and "/api/v1/session" in text and re.search(r'\bbootstrap\s*=', text) is not None

    @classmethod
    def _web_public_surface_probe(cls, endpoint: ProxyEndpoint, timeout: float) -> dict[str, Any]:
        root = cls._web_https_request(endpoint.server, "GET", "/", timeout, {"Accept": "text/html"})
        invalid_capability = base64.urlsafe_b64encode(secrets.token_bytes(32)).rstrip(b"=").decode("ascii")
        invalid = cls._web_https_request(endpoint.server, "GET", "/?bridge=" + invalid_capability, timeout, {"Accept": "text/html"})
        if root["status"] != 200:
            raise ConnectionError(f"WEB public site HTTP {root['status']} {root['reason']}")
        if invalid["status"] != 200:
            raise ConnectionError(f"WEB invalid bridge HTTP {invalid['status']} {invalid['reason']}")
        if cls._web_is_bridge_page(root["body"]) or cls._web_is_bridge_page(invalid["body"]):
            raise ConnectionError("обычная WEB-страница раскрывает bridge transport")
        return {
            "public_http": root["status"],
            "public_latency_ms": root["latency_ms"],
            "invalid_bridge_http": invalid["status"],
            "invalid_bridge_latency_ms": invalid["latency_ms"],
            "invalid_bridge_decoy_ok": True,
            "public_same_body": hmac.compare_digest(hashlib.sha256(root["body"]).digest(), hashlib.sha256(invalid["body"]).digest()),
            "public_content_type": root["headers"].get("content-type", ""),
        }

    @classmethod
    def _web_bridge_security(cls, endpoint: ProxyEndpoint, response: dict[str, Any]) -> dict[str, Any]:
        headers = response["headers"]
        cache_control = headers.get("cache-control", "").lower()
        csp = headers.get("content-security-policy", "").lower()
        content_type = headers.get("content-type", "").lower()
        required_csp = (
            "default-src 'none'",
            "connect-src 'self'",
            "frame-ancestors http://127.0.0.1:*",
            "script-src 'nonce-",
            "sandbox allow-same-origin allow-scripts",
        )
        checks = {
            "no_store": "no-store" in cache_control,
            "content_type": content_type.startswith("text/html"),
            "csp": all(item in csp for item in required_csp),
            "referrer_policy": headers.get("referrer-policy", "").lower() == "no-referrer",
            "nosniff": headers.get("x-content-type-options", "").lower() == "nosniff",
            "dns_prefetch_off": headers.get("x-dns-prefetch-control", "").lower() == "off",
            "no_cookie": "set-cookie" not in headers,
            "no_redirect": "location" not in headers,
            "same_origin_wss": f"wss://{endpoint.server}" in csp,
        }
        checks["ok"] = bool(checks["no_store"] and checks["content_type"] and checks["csp"] and checks["no_cookie"] and checks["no_redirect"])
        return checks

    @classmethod
    def _web_create_session(cls, endpoint: ProxyEndpoint, timeout: float) -> tuple[str, str, str, dict[str, Any]]:
        capability = cls._web_bridge_capability(endpoint.server, endpoint.secret)
        bridge_path = "/?bridge=" + urllib.parse.quote(capability, safe="-_")
        bridge = cls._web_https_request(endpoint.server, "GET", bridge_path, timeout, {"Accept": "text/html"})
        if bridge["status"] != 200:
            raise ConnectionError(f"WEB bridge HTTP {bridge['status']} {bridge['reason']}")
        security = cls._web_bridge_security(endpoint, bridge)
        if not security["ok"]:
            raise ConnectionError("WEB bridge не подтвердил защищённый bridge response")
        bootstrap, page_mode = cls._web_bridge_bootstrap(bridge["body"])
        hello = cls._web_frame(0x10, 0, b"\x01")
        created = cls._web_https_request_retry(
            endpoint.server,
            "POST",
            "/api/v1/session",
            timeout,
            {
                "Authorization": f"Bearer {bootstrap}",
                "Content-Type": "application/octet-stream",
                "Origin": f"https://{endpoint.server}",
            },
            hello,
        )
        if created["status"] != 200:
            raise ConnectionError(f"WEB session HTTP {created['status']} {created['reason']}")
        session_token = created["headers"].get("x-session-token", "")
        down_cursor = created["headers"].get("x-down-cursor", "")
        carrier_mode = created["headers"].get("x-carrier-mode", "")
        if not cls._web_token_valid(session_token):
            raise ConnectionError("WEB session не вернул корректный X-Session-Token")
        if not down_cursor.isdigit():
            raise ConnectionError("WEB session не вернул корректный X-Down-Cursor")
        if carrier_mode != page_mode:
            raise ConnectionError("carrier mode bridge/session не совпадает")
        if "no-store" not in created["headers"].get("cache-control", "").lower():
            raise ConnectionError("WEB session response не помечен no-store")
        frames = cls._web_parse_frames(created["body"])
        if frames != [(0x11, 0, b"")]:
            raise ConnectionError("WEB relay не вернул корректный WELCOME")
        details = {
            "bridge_http": bridge["status"],

            "bridge_latency_ms": bridge["latency_ms"],
            "session_latency_ms": created["latency_ms"],
            "tls_version": bridge["tls_version"],
            "tls_cipher": bridge["cipher"],
            "carrier_mode": carrier_mode,
            "bridge_headers_ok": True,
            "bridge_security": security,
            "welcome_ok": True,
        }
        return session_token, down_cursor, carrier_mode, details

    @classmethod
    def _web_delete_session(cls, endpoint: ProxyEndpoint, session_token: str, timeout: float) -> None:
        if not session_token:
            return
        try:
            cls._web_https_request(
                endpoint.server,
                "DELETE",
                "/api/v1/session",
                min(timeout, 4.0),
                {"Authorization": f"Bearer {session_token}", "Origin": f"https://{endpoint.server}"},
            )
        except Exception:
            pass

    @staticmethod
    def _websocket_send(sock: socket.socket, opcode: int, payload: bytes) -> None:
        if opcode >= 0x8 and len(payload) > 125:
            raise ValueError("слишком большой WebSocket control frame")
        first = 0x80 | (opcode & 0x0F)
        length = len(payload)
        if length < 126:
            header = bytes([first, 0x80 | length])
        elif length <= 0xFFFF:
            header = bytes([first, 0x80 | 126]) + struct.pack(">H", length)
        else:
            header = bytes([first, 0x80 | 127]) + struct.pack(">Q", length)
        mask = secrets.token_bytes(4)
        masked = bytes(value ^ mask[index & 3] for index, value in enumerate(payload))
        sock.sendall(header + mask + masked)

    @classmethod
    def _websocket_recv_message(cls, sock: socket.socket) -> bytes:
        parts: list[bytes] = []
        total = 0
        active = False
        while True:
            head = cls._recv_exact(sock, 2)
            if head[0] & 0x70:
                raise ValueError("неподдерживаемые WebSocket RSV bits")
            fin = bool(head[0] & 0x80)
            opcode = head[0] & 0x0F
            masked = bool(head[1] & 0x80)
            if masked:
                raise ValueError("сервер прислал masked WebSocket frame")
            length = head[1] & 0x7F
            if length == 126:
                length = struct.unpack(">H", cls._recv_exact(sock, 2))[0]
            elif length == 127:
                length = struct.unpack(">Q", cls._recv_exact(sock, 8))[0]
            if length > MAX_RESPONSE_BYTES or total + length > MAX_RESPONSE_BYTES:
                raise ValueError("WebSocket message превышает лимит")
            payload = cls._recv_exact(sock, length) if length else b""
            if opcode >= 0x8 and (not fin or length > 125):
                raise ValueError("некорректный WebSocket control frame")
            if opcode == 0x9:
                cls._websocket_send(sock, 0xA, payload)
                continue
            if opcode == 0xA:
                continue
            if opcode == 0x8:
                raise ConnectionError("WEB WebSocket закрыт relay-сервером")
            if opcode == 0x2:
                if active:
                    raise ValueError("вложенный WebSocket binary message")
                parts = [payload]
                total = len(payload)
                active = not fin
                if fin:
                    return payload
                continue
            if opcode == 0x0 and active:
                parts.append(payload)
                total += len(payload)
                if fin:
                    return b"".join(parts)
                continue
            raise ValueError("неподдерживаемый WebSocket opcode")

    @classmethod
    def _websocket_connect(cls, endpoint: ProxyEndpoint, session_token: str, carrier_mode: str, stream_id: int, timeout: float) -> socket.socket:
        raw = cls._connect_endpoint(endpoint.server, 443, timeout)
        context = ssl.create_default_context()
        try:
            sock = context.wrap_socket(raw, server_hostname=endpoint.server)
        except Exception:
            raw.close()
            raise
        sock.settimeout(timeout)
        key = base64.b64encode(secrets.token_bytes(16)).decode("ascii")
        if carrier_mode == "websocket-lanes":
            if not 1 <= stream_id <= 0xFFFFFF:
                sock.close()
                raise ValueError("некорректный WEB lane stream_id")
            subprotocol = f"tproxy-lane-v1.{session_token}.{stream_id}"
        else:
            subprotocol = f"tproxy-v1.{session_token}"
        request = "\r\n".join([
            "GET /api/v1/ws HTTP/1.1",
            f"Host: {endpoint.server}",
            "Upgrade: websocket",
            "Connection: Upgrade",
            f"Sec-WebSocket-Key: {key}",
            "Sec-WebSocket-Version: 13",
            f"Sec-WebSocket-Protocol: {subprotocol}",
            f"Origin: https://{endpoint.server}",
            f"User-Agent: {APP_FAMILY}/{VERSION}",
            "",
            "",
        ]).encode("ascii")
        try:
            sock.sendall(request)
            header = bytearray()
            while not header.endswith(b"\r\n\r\n") and len(header) < 16384:
                chunk = sock.recv(1)
                if not chunk:
                    break
                header.extend(chunk)
            if not header.endswith(b"\r\n\r\n"):
                raise ConnectionError("неполный WebSocket handshake")
            lines = bytes(header).decode("latin1").split("\r\n")
            match = re.match(r"HTTP/\d(?:\.\d)?\s+(\d{3})", lines[0])
            if not match or int(match.group(1)) != 101:
                raise ConnectionError(f"WebSocket upgrade отклонён: {lines[0]}")
            response_headers: dict[str, str] = {}
            for line in lines[1:]:
                if ":" in line:
                    name, value = line.split(":", 1)
                    response_headers[name.strip().lower()] = value.strip()
            expected = base64.b64encode(hashlib.sha1((key + "258EAFA5-E914-47DA-95CA-C5AB0DC85B11").encode("ascii")).digest()).decode("ascii")
            if response_headers.get("sec-websocket-accept", "") != expected:
                raise ConnectionError("неверный Sec-WebSocket-Accept")
            if response_headers.get("sec-websocket-protocol", "") != subprotocol:
                raise ConnectionError("relay не подтвердил WebSocket subprotocol")
            if response_headers.get("upgrade", "").lower() != "websocket":
                raise ConnectionError("relay не подтвердил WebSocket Upgrade")
            connection_tokens = {item.strip().lower() for item in response_headers.get("connection", "").split(",")}
            if "upgrade" not in connection_tokens:
                raise ConnectionError("relay не подтвердил Connection: Upgrade")
            if "sec-websocket-extensions" in response_headers:
                raise ConnectionError("relay неожиданно включил WebSocket extension")
            return sock
        except Exception:
            sock.close()
            raise

    @classmethod
    def _web_mtproxy_payload(cls, secret_hex: str, dc_id: int) -> tuple[bytes, AESCTR, bytes]:
        key, secret_type = cls._secret_key(secret_hex)
        randomized = secret_type == "padded"
        header, encryptor, decryptor = cls._build_mtproxy_header(key, dc_id, randomized)
        packet, nonce, _ = cls._build_req_pq()
        padding = secrets.token_bytes(secrets.randbelow(4)) if randomized else b""
        framed = struct.pack("<i", len(packet) + len(padding)) + packet + padding
        return header + encryptor.update(framed), decryptor, nonce

    @classmethod
    def _web_consume_mtproxy_frames(cls, frames: list[tuple[int, int, bytes]], stream_id: int, decryptor: AESCTR, plain: bytearray) -> tuple[Optional[bool], str, bytes, bytes]:
        session_controls = bytearray()
        stream_controls = bytearray()
        consumed = 0
        close_seen = False
        for frame_type, frame_stream, payload in frames:
            if frame_type == 0x05:
                if frame_stream != 0:
                    return False, "WEB PING имеет неверный stream_id", b"", b""
                session_controls.extend(cls._web_frame(0x06, 0, payload))
                continue
            if frame_type == 0x1F:
                reason = payload.decode("utf-8", errors="replace").strip()
                return False, "WEB relay завершил carrier" + (f": {reason}" if reason else ""), bytes(session_controls), bytes(stream_controls)
            if frame_stream != stream_id:
                return False, f"WEB relay прислал кадр неизвестного stream_id {frame_stream}", bytes(session_controls), bytes(stream_controls)
            if frame_type == 0x02:
                if len(payload) > 64 * 1024:
                    return False, "WEB relay DATA превышает 64 КиБ", bytes(session_controls), bytes(stream_controls)
                plain.extend(decryptor.update(payload))
                consumed += len(payload)
            elif frame_type == 0x03:
                close_seen = True
            elif frame_type == 0x04:
                pass
            else:
                return False, f"WEB relay прислал недопустимый кадр 0x{frame_type:02x}", bytes(session_controls), bytes(stream_controls)
        if consumed:
            stream_controls.extend(cls._web_frame(0x04, stream_id, consumed.to_bytes(4, "big")))
        if len(plain) >= 4:
            frame_len = struct.unpack("<i", bytes(plain[:4]))[0]
            if frame_len <= 0 or frame_len > MAX_RESPONSE_BYTES:
                return False, f"некорректная длина MTProxy-фрейма через WEB: {frame_len}", bytes(session_controls), bytes(stream_controls)
            if len(plain) >= 4 + frame_len:
                stream_controls.extend(cls._web_frame(0x03, stream_id))
                return True, "", bytes(session_controls), bytes(stream_controls)
        if close_seen:
            return False, "WEB relay закрыл поток до resPQ", bytes(session_controls), bytes(stream_controls)
        return None, "", bytes(session_controls), bytes(stream_controls)

    @classmethod
    def _web_http_upload_frames(cls, endpoint: ProxyEndpoint, session_token: str, carrier_mode: str, lane_id: int, sequence: int, payload: bytes, timeout: float) -> int:
        if not payload:
            return sequence
        headers = {
            "Authorization": f"Bearer {session_token}",
            "Content-Type": "application/octet-stream",
            "Origin": f"https://{endpoint.server}",
            "X-Up-Seq": str(sequence),
        }
        if carrier_mode == "https-lanes":
            headers["X-Lane-ID"] = str(lane_id)
        response = cls._web_https_request_retry(endpoint.server, "POST", "/api/v1/up", timeout, headers, payload)
        if response["status"] != 204 or response["headers"].get("x-up-ack", "") != str(sequence):
            raise ConnectionError(f"WEB uplink отклонён: HTTP {response['status']}")
        return sequence + 1

    @classmethod
    def _web_http_stream_probe(cls, endpoint: ProxyEndpoint, session_token: str, down_cursor: str, carrier_mode: str, dc_id: int, timeout: float) -> tuple[bool, str, float]:
        stream_id = 1
        mtproxy_data, decryptor, nonce = cls._web_mtproxy_payload(endpoint.secret, dc_id)
        batch = cls._web_frame(0x01, stream_id) + cls._web_frame(0x02, stream_id, mtproxy_data)
        started = time.monotonic()
        global_sequence = 1
        stream_sequence = 1
        session_sequence = 1
        if carrier_mode == "https":
            global_sequence = cls._web_http_upload_frames(endpoint, session_token, carrier_mode, 0, global_sequence, batch, timeout)
        else:
            stream_sequence = cls._web_http_upload_frames(endpoint, session_token, carrier_mode, stream_id, stream_sequence, batch, timeout)
        plain = bytearray()
        cursor = down_cursor or "0"
        for _ in range(6):
            down_headers = {
                "Authorization": f"Bearer {session_token}",
                "Origin": f"https://{endpoint.server}",
                "X-Down-Cursor": cursor,
            }
            if carrier_mode == "https-lanes":
                down_headers["X-Lane-ID"] = str(stream_id)
            response = cls._web_https_request_retry(endpoint.server, "POST", "/api/v1/down", timeout, down_headers)
            next_cursor = response["headers"].get("x-down-cursor", "")
            if next_cursor:
                if not next_cursor.isdigit():
                    return False, "WEB downlink вернул некорректный cursor", 0.0
                cursor = next_cursor
            if response["status"] == 204:
                if carrier_mode == "https-lanes" and response["headers"].get("x-lane-closed") == "1":
                    return False, "WEB lane закрыт до resPQ", 0.0
                continue
            if response["status"] != 200:
                return False, f"WEB downlink отклонён: HTTP {response['status']}", 0.0
            if not next_cursor:
                return False, "WEB downlink не вернул cursor", 0.0
            frames = cls._web_parse_frames(response["body"])
            state, message, session_controls, stream_controls = cls._web_consume_mtproxy_frames(frames, stream_id, decryptor, plain)
            try:
                if carrier_mode == "https":
                    global_sequence = cls._web_http_upload_frames(endpoint, session_token, carrier_mode, 0, global_sequence, session_controls + stream_controls, timeout)
                else:
                    session_sequence = cls._web_http_upload_frames(endpoint, session_token, carrier_mode, 0, session_sequence, session_controls, timeout)
                    stream_sequence = cls._web_http_upload_frames(endpoint, session_token, carrier_mode, stream_id, stream_sequence, stream_controls, timeout)
            except Exception as exc:
                return False, str(exc), 0.0
            if state is False:
                return False, message, 0.0
            if state is True:
                frame_len = struct.unpack("<i", bytes(plain[:4]))[0]
                payload = bytes(plain[4:4 + frame_len])
                ok, parsed_message = cls._parse_res_pq(payload, nonce)
                elapsed = (time.monotonic() - started) * 1000.0
                return ok, parsed_message, elapsed
        return False, "WEB downlink не вернул полный resPQ", 0.0

    @classmethod
    def _web_websocket_stream_probe(cls, endpoint: ProxyEndpoint, session_token: str, carrier_mode: str, dc_id: int, timeout: float) -> tuple[bool, str, float]:
        stream_id = 1
        mtproxy_data, decryptor, nonce = cls._web_mtproxy_payload(endpoint.secret, dc_id)
        batch = cls._web_frame(0x01, stream_id) + cls._web_frame(0x02, stream_id, mtproxy_data)
        sock = cls._websocket_connect(endpoint, session_token, carrier_mode, stream_id, timeout)
        started = time.monotonic()
        try:
            cls._websocket_send(sock, 0x2, batch)
            plain = bytearray()
            for _ in range(16):
                message = cls._websocket_recv_message(sock)
                frames = cls._web_parse_frames(message)
                state, error, session_controls, stream_controls = cls._web_consume_mtproxy_frames(frames, stream_id, decryptor, plain)
                if carrier_mode == "websocket-lanes" and session_controls:
                    return False, "WEB websocket lane получил session-level frame", 0.0
                controls = session_controls + stream_controls
                if controls:
                    cls._websocket_send(sock, 0x2, controls)
                if state is False:
                    return False, error, 0.0
                if state is True:
                    frame_len = struct.unpack("<i", bytes(plain[:4]))[0]
                    payload = bytes(plain[4:4 + frame_len])
                    ok, parsed_message = cls._parse_res_pq(payload, nonce)
                    elapsed = (time.monotonic() - started) * 1000.0
                    return ok, parsed_message, elapsed
            return False, "WEB WebSocket не вернул полный resPQ", 0.0
        finally:
            try:
                cls._websocket_send(sock, 0x8, struct.pack(">H", 1000))
            except Exception:
                pass
            sock.close()

    @classmethod
    def _web_proxy_req_pq_once(cls, endpoint: ProxyEndpoint, dc_id: int, timeout: float, preflight: Optional[dict[str, Any]] = None) -> tuple[bool, str, float, dict[str, Any]]:
        session_token = ""
        started = time.monotonic()
        details: dict[str, Any] = dict(preflight or {})
        try:
            session_token, down_cursor, carrier_mode, session_details = cls._web_create_session(endpoint, timeout)
            details.update(session_details)
            if carrier_mode in {"https", "https-lanes"}:
                ok, message, protocol_ms = cls._web_http_stream_probe(endpoint, session_token, down_cursor, carrier_mode, dc_id, timeout)
            else:
                ok, message, protocol_ms = cls._web_websocket_stream_probe(endpoint, session_token, carrier_mode, dc_id, timeout)
            details["telegram_res_pq"] = ok
            details["protocol_latency_ms"] = round(protocol_ms, 2) if protocol_ms else None
            elapsed = (time.monotonic() - started) * 1000.0
            return ok, message, elapsed, details
        finally:
            cls._web_delete_session(endpoint, session_token, timeout)

    @classmethod
    def _web_proxy_telegram_check(cls, endpoint: ProxyEndpoint, timeout: float, attempts: int) -> dict[str, Any]:
        records: list[dict[str, Any]] = []
        successes = 0
        last_message = "нет попыток"
        try:
            preflight = cls._web_public_surface_probe(endpoint, timeout)
        except Exception as exc:
            return {
                "ok": False,
                "successes": 0,
                "required": 1,
                "attempts": 1,
                "latency_ms": None,
                "message": str(exc),
                "records": [{"host": endpoint.server, "ok": False, "message": str(exc), "public_surface_ok": False}],
            }
        for attempt in range(max(1, attempts)):
            dc_id = (2, 4, 1, 5, 3)[attempt % 5]
            try:
                ok, message, elapsed, details = cls._web_proxy_req_pq_once(endpoint, dc_id, timeout, preflight)
            except Exception as exc:
                ok, message, elapsed, details = False, str(exc), 0.0, dict(preflight)
            records.append({
                "host": endpoint.server,
                "dc_id": dc_id,
                "ok": ok,
                "message": message,
                "latency_ms": round(elapsed, 2) if elapsed else None,
                "carrier_mode": details.get("carrier_mode", ""),
                "tls_version": details.get("tls_version", ""),
                "bridge_http": details.get("bridge_http"),
                "public_surface_ok": details.get("public_http") == 200,
                "invalid_bridge_decoy_ok": details.get("invalid_bridge_decoy_ok", False),
                "bridge_headers_ok": details.get("bridge_headers_ok", False),
                "welcome_ok": details.get("welcome_ok", False),
                "telegram_res_pq": details.get("telegram_res_pq", False),
            })
            last_message = message
            if ok:
                successes += 1
                break
        latencies = [item["latency_ms"] for item in records if item["ok"] and item["latency_ms"] is not None]
        return {
            "ok": successes >= 1,
            "successes": successes,
            "required": 1,
            "attempts": len(records),
            "latency_ms": round(statistics.median(latencies), 2) if latencies else None,
            "message": f"WEB proxy: Telegram resPQ подтверждён {successes}/{len(records)}" if successes else last_message,
            "records": records,
        }

    @classmethod
    def _get_http_session(cls) -> Any:
        if requests is None:
            return None
        with cls._http_lock:
            if cls._http_session is None:
                session = requests.Session()
                session.headers.update({"User-Agent": f"{APP_FAMILY}/{VERSION}"})
                cls._http_session = session
            return cls._http_session

    @classmethod
    def get_geolocation(cls, ip: str, timeout: float = 3.0) -> dict[str, Any]:
        cached = cls._geo_cache.get(ip)
        if cached is not None:
            return cached
        session = cls._get_http_session()
        if session is None:
            return {"error": "requests не установлен"}
        urls = (
            f"https://ipwho.is/{ip}?security=1",
            f"https://ipapi.co/{ip}/json/",
            f"http://ip-api.com/json/{ip}?fields=status,country,countryCode,region,regionName,city,zip,lat,lon,timezone,offset,isp,org,as,asname,proxy,hosting,query",
        )
        with cls._geo_sema:
            cached = cls._geo_cache.get(ip)
            if cached is not None:
                return cached
            for url in urls:
                try:
                    response = session.get(url, timeout=timeout)
                    if response.status_code != 200:
                        continue
                    data = response.json()
                    if data.get("success") is False or data.get("error") is True or data.get("status") == "fail":
                        continue
                    connection = data.get("connection") if isinstance(data.get("connection"), dict) else {}
                    timezone_data = data.get("timezone") if isinstance(data.get("timezone"), dict) else {}
                    security = data.get("security") if isinstance(data.get("security"), dict) else {}
                    timezone_id = timezone_data.get("id") or (data.get("timezone") if isinstance(data.get("timezone"), str) else "")
                    utc_offset = timezone_data.get("utc") or data.get("utc_offset") or data.get("offset") or ""
                    if isinstance(utc_offset, int):
                        sign = "+" if utc_offset >= 0 else "-"
                        hours, minutes = divmod(abs(utc_offset), 3600)
                        minutes = minutes // 60
                        utc_offset = f"{sign}{hours:02d}:{minutes:02d}"
                    asn_value = connection.get("asn") or data.get("asn") or data.get("as") or ""
                    if "ipwho.is" in url:
                        provider = "ipwho.is"
                    elif "ipapi.co" in url:
                        provider = "ipapi.co"
                    else:
                        provider = "ip-api.com"
                    result = {
                        "country": data.get("country") or data.get("country_name") or "",
                        "country_code": data.get("country_code") or data.get("countryCode") or data.get("country_code2") or "",
                        "region": data.get("region") or data.get("regionName") or data.get("region_name") or "",
                        "region_code": data.get("region_code") or data.get("regionName") or "",
                        "city": data.get("city") or "",
                        "postal": data.get("postal") or data.get("zip") or "",
                        "latitude": data.get("latitude") if data.get("latitude") is not None else data.get("lat"),
                        "longitude": data.get("longitude") if data.get("longitude") is not None else data.get("lon"),
                        "isp": connection.get("isp") or data.get("isp") or data.get("org") or "",
                        "org": connection.get("org") or data.get("org") or "",
                        "asn": asn_value,
                        "network_domain": connection.get("domain") or "",
                        "network": data.get("network") or "",
                        "timezone": timezone_id,
                        "utc_offset": utc_offset,
                        "proxy": bool(security.get("proxy", False) or data.get("proxy", False)),
                        "vpn": bool(security.get("vpn", False)),
                        "tor": bool(security.get("tor", False)),
                        "hosting": bool(security.get("hosting", False) or data.get("hosting", False)),
                        "anonymous": bool(security.get("anonymous", False)),
                        "provider": provider,
                    }
                    cls._geo_cache.set(ip, result)
                    return result
                except Exception:
                    continue
        result = {"error": "геолокация недоступна"}
        cls._geo_cache.set(ip, result)
        return result

    @classmethod
    def check_cover_domain(cls, domain: str, timeout: float = 3.0) -> dict[str, Any]:
        if not domain:
            return {}
        normalized = domain.strip().rstrip(".").lower()
        try:
            ascii_domain = normalized.encode("idna").decode("ascii")
        except Exception:
            ascii_domain = normalized
        ips, dns_status = cls.resolve_host(ascii_domain)
        result: dict[str, Any] = {
            "domain": normalized,
            "ascii_domain": ascii_domain,
            "sni_ok": bool(cls._valid_hostname(ascii_domain) and "." in ascii_domain),
            "sni_source": "FakeTLS secret",
            "dns_ok": bool(ips),
            "dns_status": dns_status,
            "ips": ips,
            "tls_ok": None,
            "tls_version": "",
            "tls_state": "not_checked",
            "tls_attempts": [],
        }
        if not result["sni_ok"]:
            result["message"] = "SNI в секрете имеет некорректный формат"
            return result
        if not ips:

            result["tls_state"] = "dns_unavailable"
            result["message"] = "SNI извлечён из FakeTLS secret; DNS домена сейчас недоступен"
            return result
        context = ssl.SSLContext(ssl.PROTOCOL_TLS_CLIENT)
        context.check_hostname = False
        context.verify_mode = ssl.CERT_NONE
        context.minimum_version = ssl.TLSVersion.TLSv1_2
        try:
            context.set_alpn_protocols(["h2", "http/1.1"])
        except Exception:
            pass
        if hasattr(ssl, "OP_IGNORE_UNEXPECTED_EOF"):
            try:
                context.options |= ssl.OP_IGNORE_UNEXPECTED_EOF
            except Exception:
                pass
        attempts: list[dict[str, Any]] = []
        for ip_value in ips[:4]:
            raw_sock: Optional[socket.socket] = None
            tls_sock: Optional[ssl.SSLSocket] = None
            started = time.monotonic()
            try:
                raw_sock = socket.create_connection((ip_value, 443), timeout=timeout)
                raw_sock.settimeout(timeout)
                tls_sock = context.wrap_socket(raw_sock, server_hostname=ascii_domain)
                version = tls_sock.version() or "TLS"
                cipher = tls_sock.cipher()
                alpn = tls_sock.selected_alpn_protocol() or ""
                elapsed = round((time.monotonic() - started) * 1000.0, 2)
                attempt = {
                    "ip": ip_value,
                    "ok": True,
                    "state": "handshake_ok",
                    "tls_version": version,
                    "cipher": cipher[0] if cipher else "",
                    "alpn": alpn,
                    "latency_ms": elapsed,
                    "message": f"TLS handshake подтверждён по {version}",
                }
                attempts.append(attempt)
                result.update({
                    "tls_ok": True,
                    "tls_version": version,
                    "tls_state": "handshake_ok",
                    "tls_ip": ip_value,
                    "tls_cipher": attempt["cipher"],
                    "tls_alpn": alpn,
                    "tls_latency_ms": elapsed,
                    "message": f"SNI извлечён; DNS OK; HTTPS отвечает по {version}",
                })
                break
            except ssl.SSLEOFError:
                elapsed = round((time.monotonic() - started) * 1000.0, 2)
                attempts.append({
                    "ip": ip_value,
                    "ok": None,
                    "state": "unexpected_eof",
                    "latency_ms": elapsed,
                    "message": "сервер закрыл TLS handshake без close_notify",
                })
            except (socket.timeout, TimeoutError):
                elapsed = round((time.monotonic() - started) * 1000.0, 2)
                attempts.append({
                    "ip": ip_value,
                    "ok": None,
                    "state": "timeout",
                    "latency_ms": elapsed,
                    "message": "таймаут TLS handshake",
                })
            except ssl.SSLError as exc:
                elapsed = round((time.monotonic() - started) * 1000.0, 2)
                error_text = str(exc)
                eof_like = "eof" in error_text.lower()
                attempts.append({
                    "ip": ip_value,
                    "ok": None,
                    "state": "unexpected_eof" if eof_like else "ssl_error",
                    "latency_ms": elapsed,
                    "message": "сервер закрыл TLS handshake без close_notify" if eof_like else error_text.split(" [", 1)[0],
                })
            except OSError as exc:
                elapsed = round((time.monotonic() - started) * 1000.0, 2)
                attempts.append({
                    "ip": ip_value,
                    "ok": None,
                    "state": "network_error",
                    "latency_ms": elapsed,
                    "message": str(exc),
                })
            finally:
                if tls_sock is not None:
                    try:
                        tls_sock.close()
                    except Exception:
                        pass
                elif raw_sock is not None:
                    try:
                        raw_sock.close()
                    except Exception:
                        pass
        result["tls_attempts"] = attempts
        if result.get("tls_ok") is True:
            return result
        states = [str(item.get("state") or "") for item in attempts]
        if "unexpected_eof" in states:
            result["tls_state"] = "unexpected_eof"
            result["message"] = "SNI извлечён; DNS OK; HTTPS endpoint закрыл handshake. Это не ошибка получения SNI"
        elif "timeout" in states:
            result["tls_state"] = "timeout"
            result["message"] = "SNI извлечён; DNS OK; HTTPS handshake не ответил вовремя"
        elif states:
            result["tls_state"] = states[-1]
            result["message"] = "SNI извлечён; DNS OK; HTTPS handshake не подтверждён"
        else:
            result["tls_state"] = "not_attempted"
            result["message"] = "SNI извлечён; DNS OK; HTTPS проверка не выполнена"
        return result

    @staticmethod
    def _latency_points(latency: Optional[float]) -> int:
        if latency is None:
            return 0
        if latency <= 80:
            return 15
        if latency <= 150:
            return 12
        if latency <= 300:
            return 8
        if latency <= 500:
            return 4
        return 1

    @staticmethod
    def _jitter_points(jitter: Optional[float]) -> int:
        if jitter is None:
            return 0
        if jitter <= 15:
            return 5
        if jitter <= 40:
            return 3
        if jitter <= 100:
            return 1
        return 0

    @classmethod
    def check_single(cls, link: str, timeout: float = DEFAULT_TIMEOUT, attempts: int = DEFAULT_ATTEMPTS, include_geo: bool = True, check_cover: bool = True) -> tuple[bool, dict[str, Any]]:
        started = time.monotonic()
        stages: list[CheckStage] = []
        result: dict[str, Any] = {
            "app_version": VERSION,
            "link": link,
            "normalized_link": "",
            "timestamp": datetime.now(timezone.utc).astimezone().isoformat(timespec="seconds"),
            "valid": False,
            "verdict": "НЕ ПРОВЕРЕН",
            "confidence": "низкая",
            "error": None,
            "proxy": {},
            "proxy_type": "",
            "ip": None,
            "ips": [],
            "dns_status": "",
            "port_open": False,
            "port_status": "",
            "ping": None,
            "jitter": None,
            "packet_loss": None,
            "ping_status": "Не проверен",
            "advanced_test": {},
            "telegram_ip_range": False,
            "protocol_ok": False,
            "protocol_msg": "",
            "protocol_probe": {},
            "mtproto_ok": False,
            "mtproto_msg": "",
            "telethon_ok": False,
            "telethon_msg": "Протокольная проверка без Telethon",
            "carriers": {},
            "secret_valid": False,
            "secret_msg": "",
            "secret_info": {},
            "cover_domain": "",
            "cover_check": {},
            "geo": {},
            "connection_score": 0,
            "quality_score": 0,
            "is_whitelist": False,
            "whitelist_status": "БС/SNI ещё не проверены",
            "whitelist_check": {},
            "bs_compat_info": {},
            "checks": [],
            "elapsed_ms": None,
        }
        try:
            endpoint = cls.parse_proxy_link(link)
            result["normalized_link"] = endpoint.normalized_link()
            result["proxy"] = asdict(endpoint)
            result["proxy_type"] = {"mtproto": "MTPROTO", "web": "WEB", "socks5": "SOCKS5", "http": "HTTP CONNECT"}.get(endpoint.kind, endpoint.kind.upper())
            stages.append(CheckStage("Формат", True, "Ссылка разобрана и нормализована"))
        except Exception as exc:
            result["error"] = str(exc)
            stages.append(CheckStage("Формат", False, str(exc)))
            result["checks"] = [asdict(stage) for stage in stages]
            result["verdict"] = "НЕВАЛИДНЫЙ ФОРМАТ"
            result["elapsed_ms"] = round((time.monotonic() - started) * 1000.0, 2)
            return False, result

        if endpoint.kind in {"mtproto", "web"}:
            secret_info = cls.validate_web_secret(endpoint.secret) if endpoint.kind == "web" else cls.validate_secret(endpoint.secret)
            result["secret_info"] = secret_info
            result["secret_valid"] = bool(secret_info["valid"])
            result["secret_msg"] = secret_info["message"]
            result["cover_domain"] = secret_info.get("cover_domain", "")
            stages.append(CheckStage("Секрет", bool(secret_info["valid"]), secret_info["message"]))
            if not secret_info["valid"]:
                result["error"] = secret_info["message"]
                result["verdict"] = "НЕВАЛИДНЫЙ СЕКРЕТ"
                result["checks"] = [asdict(stage) for stage in stages]
                result["elapsed_ms"] = round((time.monotonic() - started) * 1000.0, 2)
                return False, result
        else:
            result["secret_valid"] = True
            result["secret_msg"] = "Секрет MTProxy не требуется"
            result["secret_info"] = {"valid": True, "type": endpoint.kind, "message": result["secret_msg"], "length": 0, "cover_domain": ""}

        ips, dns_status = cls.resolve_host(endpoint.server)
        result["ips"] = ips
        result["dns_status"] = dns_status
        stages.append(CheckStage("DNS", bool(ips), dns_status, details={"ips": ips}))
        if not ips:
            result["error"] = dns_status
            result["verdict"] = "DNS ОШИБКА"
            result["checks"] = [asdict(stage) for stage in stages]
            result["elapsed_ms"] = round((time.monotonic() - started) * 1000.0, 2)
            return False, result

        tcp = cls.measure_tcp(ips, endpoint.port, timeout, attempts)
        result["ip"] = tcp["selected_ip"] or ips[0]
        result["port_open"] = bool(tcp["ok"])
        result["port_status"] = f"TCP {tcp['successes']}/{tcp['attempts']}"
        result["ping"] = tcp["median_ms"]
        result["jitter"] = tcp["jitter_ms"]
        result["packet_loss"] = tcp["loss_percent"]
        result["ping_status"] = f"RTT {tcp['median_ms']} мс" if tcp["median_ms"] is not None else "Нет успешных TCP-проб"
        result["telegram_ip_range"] = cls.is_telegram_ip(result["ip"]) if result["ip"] else False
        result["advanced_test"] = {
            "tcp_connect": bool(tcp["ok"]),
            "tcp_latency": tcp["median_ms"],
            "response_time": tcp["median_ms"],
            "packet_loss": tcp["loss_percent"],
            "jitter": tcp["jitter_ms"],
            "samples": tcp.get("samples_ms", []),
            "errors": tcp.get("errors", []),
        }
        stages.append(CheckStage("TCP", bool(tcp["ok"]), result["port_status"], tcp["median_ms"], tcp))
        if not tcp["ok"]:
            result["error"] = "TCP-порт недоступен"
            result["verdict"] = "НЕДОСТУПЕН"
            result["checks"] = [asdict(stage) for stage in stages]
            result["elapsed_ms"] = round((time.monotonic() - started) * 1000.0, 2)
            return False, result

        protocol_attempts = max(2, min(3, attempts))
        if endpoint.kind == "mtproto":
            secret_type = result["secret_info"]["type"]
            if secret_type == "fake_tls":
                protocol = cls._fake_tls_check(ips, endpoint.port, endpoint.secret, timeout, protocol_attempts)
                result["confidence"] = "высокая: FakeTLS secret подтверждён HMAC"
            else:
                protocol = cls._mtproxy_req_pq(ips, endpoint.port, endpoint.secret, timeout, protocol_attempts)
                result["confidence"] = "очень высокая: Telegram resPQ подтверждён"
        elif endpoint.kind == "web":
            protocol = cls._web_proxy_telegram_check(endpoint, timeout, protocol_attempts)
            result["confidence"] = "очень высокая: WEB relay и Telegram resPQ подтверждены"
        else:
            protocol = cls._generic_proxy_telegram_check(endpoint, timeout, protocol_attempts)
            result["confidence"] = "очень высокая: Telegram resPQ получен через туннель"
        result["protocol_probe"] = protocol
        result["protocol_ok"] = bool(protocol["ok"])
        result["protocol_msg"] = protocol["message"]
        result["mtproto_ok"] = bool(protocol["ok"])
        result["mtproto_msg"] = protocol["message"]
        stages.append(CheckStage("Telegram", bool(protocol["ok"]), protocol["message"], protocol.get("latency_ms"), {"records": protocol.get("records", [])}))

        if result["cover_domain"] and check_cover:
            cover = cls.check_cover_domain(result["cover_domain"], min(timeout, 4.0))
            result["cover_check"] = cover
            stages.append(CheckStage("SNI", bool(cover.get("sni_ok")), cover.get("message", "SNI извлечён"), details=cover))

        whitelist_domain = endpoint.server if endpoint.kind == "web" else result["cover_domain"]
        whitelist_check = cls.check_russia_whitelist(result["ip"] or "", whitelist_domain, timeout=min(12.0, max(4.0, timeout + 2.0)))
        result["whitelist_check"] = whitelist_check
        result["is_whitelist"] = bool(whitelist_check.get("matched"))
        result["whitelist_status"] = whitelist_check.get("status", "БС/SNI не определены")
        sni_match_info = whitelist_check.get("sni", {})
        ip_match_info = whitelist_check.get("ip", {})
        compat_source = "repo:sni+ip" if sni_match_info.get("matched") and ip_match_info.get("matched") else "repo:sni" if sni_match_info.get("matched") else "repo:ip" if ip_match_info.get("matched") else "repo:none"
        service_name = sni_match_info.get("matched_entry") or ip_match_info.get("matched_entry") or ""
        result["bs_compat_info"] = {
            "source_repo": whitelist_check.get("repo", RUSSIA_WHITELIST_REPO),
            "source_counts": whitelist_check.get("counts", {}),
            "source_loaded": whitelist_check.get("loaded", False),
            "sni_domain": whitelist_domain,
            "sni_match": sni_match_info,
            "ip_match": ip_match_info,
            "combined_match": whitelist_check.get("combined_match", False),
            "cover_sni_ok": result.get("cover_check", {}).get("sni_ok", False),
            "cover_dns_ok": result.get("cover_check", {}).get("dns_ok", False),
            "cover_tls_ok": result.get("cover_check", {}).get("tls_ok"),
            "cover_tls_state": result.get("cover_check", {}).get("tls_state", ""),
            "cover_tls_version": result.get("cover_check", {}).get("tls_version", ""),
            "is_bs_compat": bool(whitelist_check.get("matched")),
            "service_name": service_name,
            "compat_source": compat_source,
            "is_blocked_sni": False,
            "note": "Репозиторий универсальный и не гарантирует доступность у конкретного оператора или в конкретном регионе",
        }
        stages.append(CheckStage("БС/SNI", bool(whitelist_check.get("loaded")), result["whitelist_status"], whitelist_check.get("elapsed_ms"), {
            "sni": whitelist_check.get("sni", {}),
            "ip": whitelist_check.get("ip", {}),
            "counts": whitelist_check.get("counts", {}),
            "repo": whitelist_check.get("repo", RUSSIA_WHITELIST_REPO),
        }))

        if include_geo and result["ip"]:
            result["geo"] = cls.get_geolocation(result["ip"], min(timeout, 3.0))

        score = 0
        if result["protocol_ok"]:
            score += 60
        score += round(15 * tcp["successes"] / max(1, tcp["attempts"]))
        score += cls._latency_points(result["ping"])
        score += cls._jitter_points(result["jitter"])
        if ips:
            score += 5
        if result["secret_info"].get("type") == "fake_tls" and result["protocol_ok"]:
            score = min(score, 95)
        result["connection_score"] = min(100, int(score))
        result["quality_score"] = result["connection_score"]
        result["valid"] = bool(result["protocol_ok"])
        if result["valid"]:
            result["verdict"] = "РАБОТАЕТ"
        else:
            result["verdict"] = "НЕ РАБОТАЕТ"
            result["error"] = result["protocol_msg"] or "Telegram-протокол не подтверждён"
        result["checks"] = [asdict(stage) for stage in stages]
        result["elapsed_ms"] = round((time.monotonic() - started) * 1000.0, 2)
        return result["valid"], result

    @classmethod
    def check_single_fast(cls, link: str) -> tuple[bool, dict[str, Any]]:
        return cls.check_single(link, timeout=4.0, attempts=1, include_geo=False, check_cover=False)

    @classmethod
    def check_many(cls, links: Iterable[str], workers: int = DEFAULT_WORKERS, timeout: float = DEFAULT_TIMEOUT, attempts: int = DEFAULT_ATTEMPTS, include_geo: bool = False, cancel_event: Optional[threading.Event] = None, callback: Optional[Callable[[int, int, dict[str, Any]], None]] = None) -> list[dict[str, Any]]:
        normalized: list[str] = []
        seen: set[str] = set()
        for link in links:
            value = str(link).strip()
            if not value:
                continue
            try:
                key = cls.parse_proxy_link(value).normalized_link()
            except Exception:
                key = value
            if key not in seen:
                seen.add(key)
                normalized.append(value)
        total = len(normalized)
        if not total:
            return []
        max_workers = max(1, min(int(workers), MAX_WORKERS, total))
        results: list[dict[str, Any]] = []
        completed = 0
        with concurrent.futures.ThreadPoolExecutor(max_workers=max_workers, thread_name_prefix="proxy-check") as executor:
            future_map = {
                executor.submit(cls.check_single, link, timeout, attempts, include_geo, False): link
                for link in normalized
            }
            for future in concurrent.futures.as_completed(future_map):
                if cancel_event is not None and cancel_event.is_set():
                    for pending in future_map:
                        pending.cancel()
                    break
                try:
                    _, result = future.result()
                except Exception as exc:
                    result = {"link": future_map[future], "valid": False, "verdict": "ОШИБКА", "error": str(exc), "connection_score": 0}
                results.append(result)
                completed += 1
                if callback is not None:
                    callback(completed, total, result)
        results.sort(key=lambda item: (not item.get("valid", False), -int(item.get("connection_score", 0)), item.get("ping") if item.get("ping") is not None else math.inf))
        return results

    @staticmethod
    def _source_mirrors(url: str) -> list[str]:
        mirrors = [url]
        prefix = "https://raw.githubusercontent.com/"
        if url.startswith(prefix):
            rest = url[len(prefix):]
            parts = rest.split("/", 2)
            if len(parts) == 3:
                owner, repo, remainder = parts
                chunks = remainder.split("/", 1)
                if len(chunks) == 2:
                    branch, path = chunks
                    mirrors.append(f"https://cdn.jsdelivr.net/gh/{owner}/{repo}@{branch}/{path}")
                    alt = "master" if branch == "main" else "main" if branch == "master" else ""
                    if alt:
                        mirrors.append(f"{prefix}{owner}/{repo}/{alt}/{path}")
                        mirrors.append(f"https://cdn.jsdelivr.net/gh/{owner}/{repo}@{alt}/{path}")
        unique: list[str] = []
        seen: set[str] = set()
        for item in mirrors:
            if item not in seen:
                seen.add(item)
                unique.append(item)
        return unique

    @classmethod
    def fetch_proxies_from_sources(cls, sources: Iterable[str], timeout: float = 8.0) -> tuple[list[str], list[dict[str, Any]]]:
        source_list = [str(item).strip() for item in sources if str(item).strip()]
        if not source_list:
            return [], []
        session = cls._get_http_session()
        has_remote_sources = any(item.lower().startswith(("http://", "https://")) for item in source_list)
        if has_remote_sources and session is None:
            return [], [{"source": item, "ok": False, "message": "requests не установлен"} for item in source_list]
        proxies: list[str] = []
        seen: set[str] = set()
        reports: list[dict[str, Any]] = []
        for url in source_list:
            try:
                direct_link = cls.parse_proxy_link(url).normalized_link()
            except Exception:
                direct_link = ""
            if direct_link:
                added = 0 if direct_link in seen else 1
                if added:
                    seen.add(direct_link)
                    proxies.append(direct_link)
                reports.append({"source": url, "mirror": "", "kind": "direct", "ok": True, "found": 1, "added": added})
                continue
            last_error = ""
            loaded = False
            candidates = cls._source_mirrors(url) if url.lower().startswith(("http://", "https://")) else [url]
            for candidate in candidates:
                try:
                    if candidate.lower().startswith(("http://", "https://")):
                        response = session.get(candidate, timeout=timeout)
                        response.raise_for_status()
                        if len(response.content) > 8 * 1024 * 1024:
                            last_error = "файл превышает лимит 8 МБ"
                            continue
                        source_text = response.text
                    else:
                        source_path = os.path.abspath(os.path.expanduser(candidate))
                        if not os.path.isfile(source_path):
                            raise FileNotFoundError(f"файл не найден: {candidate}")
                        with open(source_path, "rb") as handle:
                            payload = handle.read(8 * 1024 * 1024 + 1)
                        if len(payload) > 8 * 1024 * 1024:
                            last_error = "файл превышает лимит 8 МБ"
                            continue
                        source_text = payload.decode("utf-8", errors="replace")
                    found = cls.extract_proxies_from_text(source_text)
                    added = 0
                    for link in found:
                        if link not in seen:
                            seen.add(link)
                            proxies.append(link)
                            added += 1
                    reports.append({"source": url, "mirror": candidate if candidate != url else "", "kind": "remote" if candidate.lower().startswith(("http://", "https://")) else "local", "ok": True, "found": len(found), "added": added})
                    loaded = True
                    break
                except Exception as exc:
                    last_error = str(exc)
            if not loaded:
                reports.append({"source": url, "ok": False, "message": last_error or "источник недоступен"})
        return proxies, reports

    @classmethod
    def fetch_public_proxies(cls, timeout: float = 8.0) -> tuple[list[str], list[dict[str, Any]]]:
        return cls.fetch_proxies_from_sources(GITHUB_PROXY_SOURCES, timeout)

    @staticmethod
    def is_telegram_ip(ip: str) -> bool:
        try:
            address = ipaddress.ip_address(ip)
        except ValueError:
            return False
        return any(address in network for network in TELEGRAM_IP_RANGES)


    @staticmethod
    def summarize_results(results: list[dict[str, Any]] | dict[str, Any]) -> dict[str, Any]:
        items = results if isinstance(results, list) else [results]
        total = len(items)
        working = sum(1 for item in items if item.get("valid"))

        not_working = total - working
        bs = 0
        not_bs = 0
        bs_unknown = 0
        sni_ip = 0
        sni_only = 0
        ip_only = 0
        no_match = 0
        protocol_counts: dict[str, int] = {}
        country_counts: dict[str, int] = {}
        pings: list[float] = []
        jitters: list[float] = []
        losses: list[float] = []
        scores: list[float] = []
        for item in items:
            whitelist = item.get("whitelist_check") or {}
            loaded = bool(whitelist.get("loaded"))
            sni_match = bool((whitelist.get("sni") or {}).get("matched"))
            ip_match = bool((whitelist.get("ip") or {}).get("matched"))
            if loaded:
                if item.get("is_whitelist") or sni_match or ip_match:
                    bs += 1
                else:
                    not_bs += 1
                if sni_match and ip_match:
                    sni_ip += 1
                elif sni_match:
                    sni_only += 1
                elif ip_match:
                    ip_only += 1
                else:
                    no_match += 1
            else:
                bs_unknown += 1
            proxy_type = str(item.get("proxy_type") or "UNKNOWN")
            protocol_counts[proxy_type] = protocol_counts.get(proxy_type, 0) + 1
            geo = item.get("geo") or {}
            if isinstance(geo, dict):
                country = str(geo.get("country") or "").strip()
                if country:
                    country_counts[country] = country_counts.get(country, 0) + 1
            for key, target in (("ping", pings), ("jitter", jitters), ("packet_loss", losses), ("connection_score", scores)):
                value = item.get(key)
                if isinstance(value, (int, float)) and not isinstance(value, bool):
                    target.append(float(value))
        def avg(values: list[float]) -> float | None:
            return round(sum(values) / len(values), 2) if values else None
        return {
            "total": total,
            "working": working,
            "not_working": not_working,
            "working_percent": round(100.0 * working / total, 2) if total else 0.0,
            "bs": bs,
            "not_bs": not_bs,
            "bs_unknown": bs_unknown,
            "sni_ip": sni_ip,
            "sni_only": sni_only,
            "ip_only": ip_only,
            "no_match": no_match,
            "avg_ping_ms": avg(pings),
            "avg_jitter_ms": avg(jitters),
            "avg_loss_percent": avg(losses),
            "avg_score": avg(scores),
            "protocols": dict(sorted(protocol_counts.items())),
            "countries": dict(sorted(country_counts.items(), key=lambda pair: (-pair[1], pair[0]))),
        }

    @staticmethod
    def _export_payload(results: list[dict[str, Any]] | dict[str, Any]) -> dict[str, Any]:
        items = results if isinstance(results, list) else [results]
        return {
            "app": APP_FAMILY,
            "version": VERSION,
            "exported_at": datetime.now(timezone.utc).astimezone().isoformat(timespec="seconds"),
            "summary": ProxyChecker.summarize_results(items),
            "results": items,
        }

