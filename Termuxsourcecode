    def _get_export_path(self, test_type, ext="txt"):
        script_dir = self._get_script_dir()
        base_dir = os.path.join(script_dir, "results")
        os.makedirs(base_dir, exist_ok=True)
        time_str = datetime.now().strftime('%Y%m%d-%H%M%S')
        filename = f"Tgproxycheck_{time_str}_{test_type}.{ext}"
        return os.path.join(base_dir, filename)

    def _format_full_result(self, res):
        lines = [
            f"ССЫЛКА: {res.get('link', 'N/A')}",
            "",
            f"Сервер: {res.get('proxy', {}).get('server', 'N/A')}:{res.get('proxy', {}).get('port', 'N/A')}",
            f"Протокол: {res.get('proxy', {}).get('protocol', 'N/A').upper()}",
        ]
        if res.get('proxy', {}).get('type') == 'socks5':
            lines.append("Тип: SOCKS5")
        else:
            lines.append(f"Тип обфускации: {res.get('proxy_type', 'N/A')}")
            lines.append(f"Статус БС: {res.get('whitelist_status', 'N/A')}")
            if res.get('is_whitelist'):
                lines.append("В БС: Да")
            else:
                lines.append("В БС: Нет")
            bs_compat = res.get('bs_compat_info', {})
            if bs_compat.get('is_bs_compat'):
                lines.append(f"БС-совместимый: {bs_compat.get('service_name', 'N/A')} ({bs_compat.get('compat_source', 'N/A')})")
            if bs_compat.get('is_blocked_sni'):
                lines.append(f"Заблокированный SNI: {bs_compat.get('service_name', 'N/A')} - не подходит для РФ")
            if res.get('proxy', {}).get('secret', '').startswith('ee'):
                sni = self.checker._extract_sni_from_secret(res.get('proxy', {}).get('secret', ''))
                if sni:
                    lines.append(f"SNI домен: {sni}")
        secret_info = res.get('secret_info', {})
        lines.append(f"Длина секрета: {secret_info.get('length', 0)}")
        lines.append(f"Тип секрета: {secret_info.get('type', 'unknown').upper()}")
        lines.append(f"HEX валидация: {'Валидный' if secret_info.get('hex_valid') else 'Невалидный'}")
        lines.append(f"Secret статус: {res.get('secret_msg', 'N/A')}")
        lines.append(f"DNS: {res.get('dns_status', 'N/A')}")
        lines.append(f"IP: {res.get('ip', 'N/A')}")
        lines.append(f"Порт: {res.get('port_status', 'N/A')}")
        lines.append(f"Пинг: {res.get('ping', 'N/A')} мс (Джиттер: {res.get('jitter', 'N/A')} мс)")
        lines.append(f"Рукопожатие: {res.get('mtproto_msg', 'N/A')}")
        carriers = res.get('carriers', {})
        if carriers:
            c_mts = f"{G}+{R}" if carriers.get("MTS") else f"{RED}-{R}"
            c_bee = f"{Y}+{R}" if carriers.get("Beeline") else f"{RED}-{R}"
            c_meg = f"{G}+{R}" if carriers.get("Megafon") else f"{RED}-{R}"
            c_t2 = f"{PINK}+{R}" if carriers.get("Tele2") else f"{RED}-{R}"
            c_str = f"МТС:{c_mts} БИЛ:{c_bee} МЕГ:{c_meg} ТЕЛ2:{c_t2}"
            lines.append(f"Операторы: {c_str}")
        lines.append(f"Оценка качества: {res.get('connection_score', 0)}/100")
        lines.append(f"Статус: {'РАБОЧИЙ' if res.get('valid') else 'НЕРАБОЧИЙ'}")
        if res.get('error'):
            lines.append(f"Ошибка: {res.get('error')}")
        adv = res.get('advanced_test', {})
        if adv.get('tcp_connect'):
            lines.append(f"TCP задержка: {adv.get('tcp_latency', 'N/A')} мс")
        geo = res.get('geo', {})
        if isinstance(geo, dict) and 'error' not in geo:
            lines.append(f"Страна: {geo.get('country', 'N/A')} ({geo.get('countryCode', 'N/A')})")
            lines.append(f"Регион: {geo.get('region', 'N/A')} ({geo.get('regionCode', 'N/A')})")
            lines.append(f"Город: {geo.get('city', 'N/A')}")
            lines.append(f"Индекс: {geo.get('zip', 'N/A')}")
            lines.append(f"Провайдер: {geo.get('isp', 'N/A')}")
            lines.append(f"Организация: {geo.get('org', 'N/A')}")
            lines.append(f"AS: {geo.get('as', 'N/A')}")
            lines.append(f"Часовой пояс: {geo.get('timezone', 'N/A')}")
            lines.append(f"Координаты: {geo.get('lat', 'N/A')}, {geo.get('lon', 'N/A')}")
            if geo.get('proxy'):
                lines.append("Тип IP: Proxy/VPN")
            if geo.get('hosting'):
                lines.append("Хостинг: Да (дата-центр)")
            if geo.get('mobile'):
                lines.append("Мобильная сеть: Да")
        lines.append("=" * 50)
        return "\n".join(lines)

    def export_single(self, res):
        filepath = self._get_export_path("Single", "txt")
        try:
            with open(filepath, 'w', encoding='utf-8') as f:
                f.write(f"Отчёт проверки TG прокси v{VERSION}\n")
                f.write(f"Сгенерирован: {res.get('timestamp', 'N/A')}\n")
                f.write("=" * 50 + "\n\n")
                working_list = [res] if res.get('valid') else []
                failed_list = [res] if not res.get('valid') else []
                if working_list:
                    f.write("=== РАБОЧИЕ ПРОКСИ ===\n\n")
                    for idx, result in enumerate(working_list, 1):
                        f.write(f"{idx}.   ")
                        f.write(self._format_full_result(result))
                        f.write("\n")
                if failed_list:
                    f.write("=== НЕРАБОЧИЕ ПРОКСИ ===\n\n")
                    for idx, result in enumerate(failed_list, 1):
                        f.write(f"{idx}.   ")
                        f.write(self._format_full_result(result))
                        f.write("\n")
        except Exception as e:
            print(f"{RED}Ошибка сохранения: {e}{R}")
        return filepath

    def export_single_json(self, res):
        filepath = self._get_export_path("Single", "json")
        try:
            with open(filepath, 'w', encoding='utf-8') as f:
                json.dump(res, f, ensure_ascii=False, indent=2, default=str)
        except Exception as e:
            print(f"{RED}Ошибка сохранения JSON: {e}{R}")
        return filepath

    def export_batch(self, results):
        filepath = self._get_export_path("Batch", "txt")
        sorted_results = sorted(results, key=lambda r: (0 if r.get('valid', False) else 1, -r.get('connection_score', 0)))
        working = [r for r in sorted_results if r.get('valid')]
        failed = [r for r in sorted_results if not r.get('valid')]
        try:
            with open(filepath, 'w', encoding='utf-8') as f:
                f.write(f"Отчёт пакетной проверки TG прокси v{VERSION}\n")
                f.write(f"Сгенерирован: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}\n")
                f.write(f"Всего прокси: {len(results)}\n")
                f.write(f"Рабочих: {len(working)}\n")
                f.write(f"В БС: {sum(1 for r in sorted_results if r.get('is_whitelist'))}\n")
                f.write("=" * 50 + "\n\n")
                if working:
                    f.write("=== РАБОЧИЕ ПРОКСИ ===\n\n")
                    for idx, res in enumerate(working, 1):
                        f.write(f"{idx}.   ")
                        f.write(self._format_full_result(res))
                        f.write("\n")
                if failed:
                    f.write("=== НЕРАБОЧИЕ ПРОКСИ ===\n\n")
                    for idx, res in enumerate(failed, 1):
                        f.write(f"{idx}.   ")
                        f.write(self._format_full_result(res))
                        f.write("\n")
        except Exception as e:
            print(f"{RED}Ошибка сохранения: {e}{R}")
        return filepath

    def export_batch_json(self, results):
        filepath = self._get_export_path("Batch", "json")
        sorted_results = sorted(results, key=lambda r: (not r.get('valid', False), -r.get('connection_score', 0)))
        try:
            with open(filepath, 'w', encoding='utf-8') as f:
                json.dump(sorted_results, f, ensure_ascii=False, indent=2, default=str)
        except Exception as e:
            print(f"{RED}Ошибка сохранения JSON: {e}{R}")
        return filepath

