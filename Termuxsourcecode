def _decode_domain(secret: str) -> Optional[str]:
    if not secret.startswith('ee') or len(secret) <= 34:
        return None
    domain_hex = secret[34:]
    if len(domain_hex) % 2 != 0:
        return None
    try:
        raw = bytes.fromhex(domain_hex)
        text = raw.decode('ascii', errors='ignore').rstrip('\x00').strip()
        return text.lower() if text else None
    except Exception:
        return None

def _is_blocked(secret: str, domain: Optional[str]) -> bool:
    if len(secret) < 32:
        return True
    if domain and any(b in domain for b in BLOCKED_SNI_LIST):
        return True
    return False

def apply_gradient(text, start_color=(0, 180, 200), end_color=(0, 220, 150)):
    result = ""
    for i, char in enumerate(text):
        ratio = i / max(1, len(text) - 1) if len(text) > 1 else 0
        r = int(start_color[0] + (end_color[0] - start_color[0]) * ratio)
        g = int(start_color[1] + (end_color[1] - start_color[1]) * ratio)
        b = int(start_color[2] + (end_color[2] - start_color[2]) * ratio)
        result += f"\033[38;2;{r};{g};{b}m{char}"
    return result + R

class Spinner:
    def __init__(self, message="Проверка"):
        self.message = message
        self.spinning = False
        self.thread = None
        self.stop_event = threading.Event()

    def _spin(self):
        chars = ['|', '/', '-', '\\']
        i = 0
        while not self.stop_event.is_set():
            sys.stdout.write(f"\r{Y}{self.message} {chars[i % len(chars)]} {R}")
            sys.stdout.flush()
            time.sleep(0.1)
            i += 1

    def start(self):
        self.stop_event.clear()
        self.thread = threading.Thread(target=self._spin, daemon=True)
        self.thread.start()

    def stop(self):
        if self.thread and self.thread.is_alive():
            self.stop_event.set()
            self.thread.join(timeout=0.5)
        sys.stdout.write("\r" + " " * (len(self.message) + 4) + "\r")
        sys.stdout.flush()

def _try_aes_ctr(data: bytes, key: bytes, iv: bytes) -> Optional[bytes]:
    padded_key = (key + b'\x00' * 32)[:32]
    padded_iv = (iv + b'\x00' * 16)[:16]
    try:
        from Crypto.Cipher import AES as _AES
        c = _AES.new(padded_key, _AES.MODE_CTR, initial_value=padded_iv, nonce=b'')
        return c.encrypt(data)
    except Exception:
        pass
    try:
        from cryptography.hazmat.primitives.ciphers import Cipher as _Cipher, algorithms as _alg, modes as _modes
        enc = _Cipher(_alg.AES(padded_key), _modes.CTR(padded_iv)).encryptor()
        return enc.update(data) + enc.finalize()
    except Exception:
        pass
    return None

def _install_asyncio_exception_handler(loop):
    def _handler(loop_ref, context):
        exc = context.get('exception')
        if exc is None: return
        if isinstance(exc, (ConnectionResetError, BrokenPipeError)): return
        if isinstance(exc, OSError) and getattr(exc, 'winerror', None) in (10054, 10053, 64, 232): return
        try:
            loop_ref.default_exception_handler(context)
        except Exception:
            pass
    try:
        loop.set_exception_handler(_handler)
    except Exception:
        pass

async def _safe_disconnect(client):
    if client is None: return
    try:
        if client.is_connected():
            try:
                await asyncio.wait_for(client.disconnect(), timeout=3.0)
            except (asyncio.TimeoutError, asyncio.CancelledError):
                pass
    except Exception:
        pass
    try:
        session = getattr(client, 'session', None)
        if session is not None and hasattr(session, 'close'):
            try:
                await session.close()
            except Exception:
                pass
    except Exception:
        pass

class InMemoryCache:
    def __init__(self, ttl=300):
        self._storage = {}
        self._ttl = ttl
        self._lock = threading.Lock()

    def get(self, key):
        with self._lock:
            if key in self._storage:
                val, ts = self._storage[key]
                if time.time() - ts < self._ttl:
                    return val
                del self._storage[key]
        return None

    def set(self, key, value):
        with self._lock:
            self._storage[key] = (value, time.time())

class RateLimiter:
    def __init__(self, max_calls=40, period=60.0):
        self.max_calls = max_calls
        self.period = period
        self.calls = []
        self.lock = threading.Lock()

    def wait(self):
        with self.lock:
            now = time.monotonic()
            self.calls = [t for t in self.calls if now - t <= self.period]
            if len(self.calls) >= self.max_calls:
                sleep_time = self.period - (now - self.calls[0]) + 0.1
                if sleep_time > 0:
                    time.sleep(sleep_time)
                now = time.monotonic()
                self.calls = [t for t in self.calls if now - t <= self.period]
            self.calls.append(now)

