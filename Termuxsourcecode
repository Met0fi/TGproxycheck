                    raise ValueError
                save_custom_sources(sources[:index] + sources[index + 1:])
                console.print("[green]Источник удалён.[/]")
            except ValueError:
                console.print("[yellow]Укажите корректный номер.[/]")
            wait_for_menu()
        elif choice == "3":
            save_custom_sources([])
            console.print("[green]Список очищен.[/]")
