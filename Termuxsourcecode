        table.add_row("Организация", str(geo.get("org") or "N/A"))
        table.add_row("ASN", str(geo.get("asn") or "N/A"))
        if geo.get("network_domain"):
            table.add_row("Домен сети", str(geo.get("network_domain")))
        if geo.get("network"):
            table.add_row("Сеть", str(geo.get("network")))
        timezone_value = str(geo.get("timezone") or "N/A")
