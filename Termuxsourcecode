        selected_custom = list(args.source)
        if not args.no_custom:
            selected_custom = load_custom_sources() + selected_custom
        results = check_sources(max(1, min(128, args.workers)), max(1.0, args.timeout), max(1, min(5, args.attempts)), max(0, args.limit), selected_custom)
        if args.output:
            save_results(results, args.output)
        raise SystemExit(0 if results else 1)
