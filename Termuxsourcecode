@dataclass(frozen=True)
class ProxyEndpoint:
    kind: str
    server: str
    port: int
    secret: str = ""
    username: str = ""
    password: str = ""
    scheme: str = ""

    def normalized_link(self) -> str:
        host = urllib.parse.quote(self.server, safe=".:[]-")
        if self.kind == "mtproto":
            query = urllib.parse.urlencode({"server": self.server, "port": self.port, "secret": self.secret})
            return f"tg://proxy?{query}"
        if self.kind == "web":
            query = urllib.parse.urlencode({"server": self.server, "secret": self.secret})
            return f"tg://webproxy?{query}"
        if self.kind == "socks5":
            params: dict[str, Any] = {"server": self.server, "port": self.port}
            if self.username:
                params["user"] = self.username
            if self.password:
                params["pass"] = self.password
            return f"tg://socks?{urllib.parse.urlencode(params)}"
        auth = ""
        if self.username:
            user = urllib.parse.quote(self.username, safe="")
            password = urllib.parse.quote(self.password, safe="")
            auth = f"{user}:{password}@"
        scheme = "https" if self.scheme == "https" else "http"
        return f"{scheme}://{auth}{host}:{self.port}"


