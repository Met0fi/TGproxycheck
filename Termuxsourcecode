        if isinstance(geo, dict) and geo and "error" not in geo:
            lines.extend([
                f"Страна: {geo.get('country') or 'N/A'} ({geo.get('country_code') or 'N/A'})",
                f"Регион: {geo.get('region') or 'N/A'} ({geo.get('region_code') or 'N/A'})",
                f"Город: {geo.get('city') or 'N/A'}",
                f"Индекс: {geo.get('postal') or 'N/A'}",
                f"Координаты: {geo.get('latitude') if geo.get('latitude') is not None else 'N/A'}, {geo.get('longitude') if geo.get('longitude') is not None else 'N/A'}",
                f"ISP: {geo.get('isp') or 'N/A'}",
                f"Организация: {geo.get('org') or 'N/A'}",
                f"ASN: {geo.get('asn') or 'N/A'}",
                f"Сеть: {geo.get('network') or 'N/A'}",
                f"Домен сети: {geo.get('network_domain') or 'N/A'}",
                f"Часовой пояс: {geo.get('timezone') or 'N/A'} | UTC {geo.get('utc_offset') or 'N/A'}",
                f"Geo provider: {geo.get('provider') or 'N/A'}",
            ])
            flags = [name for name, key in (("Proxy", "proxy"), ("VPN", "vpn"), ("Tor", "tor"), ("Hosting", "hosting"), ("Anonymous", "anonymous")) if geo.get(key)]
            lines.append(f"Тип IP: {', '.join(flags) if flags else 'Обычный'}")
        elif isinstance(geo, dict) and geo.get("error"):
            lines.append(f"Геоданные: {geo.get('error')}")
        if protocol:
            records = protocol.get("records") or []
            lines.append(f"Протокольных попыток: {len(records)}")
            for number, record in enumerate(records, 1):
                if isinstance(record, dict):
                    target = record.get("dc") or record.get("target") or record.get("ip") or ""
                    state = "OK" if record.get("ok") else "FAIL"
                    latency = record.get("latency_ms")
                    message = record.get("message") or record.get("error") or ""
                    lines.append(f"  Попытка {number}: {state} | {target} | {latency if latency is not None else 'N/A'} мс | {message}")
        checks = result.get("checks") or []
        if checks:
            lines.append("Этапы:")
            for stage in checks:
                if isinstance(stage, dict):
                    latency = stage.get("latency_ms")
                    lines.append(f"  {stage.get('name', 'N/A')}: {'OK' if stage.get('ok') else 'FAIL'} | {latency if latency is not None else 'N/A'} мс | {stage.get('message', '')}")
        if result.get("elapsed_ms") is not None:
            lines.append(f"Общее время проверки: {result.get('elapsed_ms')} мс")
        if result.get("error"):
            lines.append(f"Ошибка: {result.get('error')}")
        return lines

    @staticmethod
    def export_csv(path: str, results: list[dict[str, Any]] | dict[str, Any]) -> None:
        import csv
        items = results if isinstance(results, list) else [results]
        fields = ("valid", "verdict", "server", "port", "type", "ip", "ping", "jitter", "packet_loss", "score", "protocol", "bs", "sni", "country", "city", "isp", "link")
        with open(path, "w", encoding="utf-8-sig", newline="") as handle:
            writer = csv.DictWriter(handle, fieldnames=fields, extrasaction="ignore")
            writer.writeheader()
            for item in items:
                proxy = item.get("proxy") or {}
                geo = item.get("geo") if isinstance(item.get("geo"), dict) else {}
                whitelist = item.get("whitelist_check") or {}
                sni_match = bool((whitelist.get("sni") or {}).get("matched"))
                ip_match = bool((whitelist.get("ip") or {}).get("matched"))
                if sni_match and ip_match:
                    bs = "SNI+IP"
                elif sni_match:
                    bs = "SNI"
                elif ip_match:
                    bs = "IP"
                else:
                    bs = "НЕ БС" if whitelist.get("loaded") else ""
                writer.writerow({
                    "valid": "1" if item.get("valid") else "0",
                    "verdict": item.get("verdict", ""),
                    "server": proxy.get("server", ""),
                    "port": proxy.get("port", ""),
                    "type": item.get("proxy_type", ""),
                    "ip": item.get("ip") or "",
                    "ping": item.get("ping") if item.get("ping") is not None else "",
                    "jitter": item.get("jitter") if item.get("jitter") is not None else "",
                    "packet_loss": item.get("packet_loss") if item.get("packet_loss") is not None else "",
                    "score": item.get("connection_score", 0),
                    "protocol": item.get("protocol_msg") or item.get("error") or "",
                    "bs": bs,
                    "sni": item.get("cover_domain") or "",
                    "country": geo.get("country", ""),
                    "city": geo.get("city", ""),
                    "isp": geo.get("isp", ""),
                    "link": item.get("normalized_link") or item.get("link") or "",
                })

    @staticmethod
    def export_json(path: str, results: list[dict[str, Any]] | dict[str, Any]) -> None:
        payload = ProxyChecker._export_payload(results)
        with open(path, "w", encoding="utf-8") as handle:
            json.dump(payload, handle, ensure_ascii=False, indent=2, default=str)

    @staticmethod
    def export_txt(path: str, results: list[dict[str, Any]] | dict[str, Any]) -> None:
        items = results if isinstance(results, list) else [results]
        summary = ProxyChecker.summarize_results(items)
        ordered = sorted(items, key=lambda item: (not bool(item.get("valid")), -int(item.get("connection_score", 0) or 0)))
        with open(path, "w", encoding="utf-8") as handle:
            handle.write(f"TG proxy check {VERSION}\n")
            handle.write(f"Экспортировано: {datetime.now(timezone.utc).astimezone().isoformat(timespec='seconds')}\n")
            handle.write("=" * 100 + "\n")
            handle.write(f"Всего проверено: {summary['total']}\n")
            handle.write(f"Рабочих: {summary['working']}\n")
            handle.write(f"Нерабочих: {summary['not_working']}\n")
            handle.write(f"В БС: {summary['bs']}\n")
            handle.write(f"Не в БС: {summary['not_bs']}\n")
            handle.write(f"БС не определён: {summary['bs_unknown']}\n")
            handle.write(f"SNI+IP: {summary['sni_ip']} | только SNI: {summary['sni_only']} | только IP: {summary['ip_only']} | без совпадения: {summary['no_match']}\n")
            handle.write(f"Средний RTT: {summary['avg_ping_ms'] if summary['avg_ping_ms'] is not None else 'N/A'} мс\n")
            handle.write(f"Средний jitter: {summary['avg_jitter_ms'] if summary['avg_jitter_ms'] is not None else 'N/A'} мс\n")
            handle.write(f"Средние потери: {summary['avg_loss_percent'] if summary['avg_loss_percent'] is not None else 'N/A'}%\n")
            handle.write(f"Средний score: {summary['avg_score'] if summary['avg_score'] is not None else 'N/A'}\n")
            if summary["protocols"]:
                handle.write("Типы: " + ", ".join(f"{key}={value}" for key, value in summary["protocols"].items()) + "\n")
            handle.write("=" * 100 + "\n\n")
            groups = (
                ("РАБОЧИЕ ПРОКСИ", [item for item in ordered if item.get("valid")]),
                ("НЕРАБОЧИЕ ПРОКСИ", [item for item in ordered if not item.get("valid")]),
            )
            index = 1
            for title, group in groups:
                if not group:
                    continue
                handle.write(f"=== {title} ===\n\n")
                for result in group:
                    handle.write("\n".join(ProxyChecker._result_report_lines(result, index)))
                    handle.write("\n\nПОЛНЫЙ JSON РЕЗУЛЬТАТА\n")
                    handle.write(json.dumps(result, ensure_ascii=False, indent=2, default=str))
                    handle.write("\n\n" + "-" * 100 + "\n\n")
                    index += 1

