def clear_screen() -> None:
    try:
        console.clear()
    except Exception:
        os.system("cls" if os.name == "nt" else "clear")


def gradient_text(value: str, bold: bool = False) -> Text:
    text = Text()
    total = max(1, len(value))
    for index, char in enumerate(value):
        palette_index = min(len(GRADIENT_STYLES) - 1, int(index * len(GRADIENT_STYLES) / total))
        style = GRADIENT_STYLES[palette_index]
        if bold:
            style = f"bold {style}"
        text.append(char, style=style)
    return text


def header_panel() -> Panel:
    return Panel.fit(gradient_text(APP_NAME, True), border_style="bright_cyan", padding=(0, 3))


def animate_opening() -> None:
    clear_screen()
    delay = 0.012
    if os.environ.get("TGPROXY_NO_ANIMATION") == "1":
        console.print(header_panel())
        return
    with Live(Panel.fit(Text(" "), border_style="bright_cyan", padding=(0, 3)), console=console, refresh_per_second=60, transient=True) as live:
        for index in range(1, len(APP_NAME) + 1):
            live.update(Panel.fit(gradient_text(APP_NAME[:index], True), border_style="bright_cyan", padding=(0, 3)))
            time.sleep(delay)
    console.print(header_panel())


def status_style(result: dict[str, Any]) -> str:
    if result.get("valid"):
        return "bold green"
    if result.get("verdict") in {"НЕВАЛИДНЫЙ ФОРМАТ", "НЕВАЛИДНЫЙ СЕКРЕТ"}:
        return "bold yellow"
    return "bold red"


def yes_no(value: Any) -> Text:
    return Text("Да" if value else "Нет", style="green" if value else "red")


def format_coordinates(geo: dict[str, Any]) -> str:
    lat = geo.get("latitude")
    lon = geo.get("longitude")
    if lat is None or lon is None or lat == "" or lon == "":
        return "N/A"
    return f"{lat}, {lon}"


