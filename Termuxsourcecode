    def start_batch_check(self):
        os.system('clear' if os.name != 'nt' else 'cls')
        print(apply_gradient("=== Пакетная проверка ==="))
        script_dir = self._get_script_dir()
        default_path = os.path.join(script_dir, "proxies.txt")
        path = input(f"{B}Путь к файлу (Enter для {default_path}):\n      > {R}").strip()
        if not path:
            path = default_path
        if not os.path.exists(path):
            print(f"{RED}Файл не найден: {path}{R}")
            input(f"{C}Нажмите Enter...{R}")
            return
        try:
            with open(path, 'r', encoding='utf-8') as f:
                raw_links = [line.strip() for line in f if line.strip()]
        except Exception as e:
            print(f"{RED}Ошибка чтения: {e}{R}")
            input(f"{C}Нажмите Enter...{R}")
            return
        if not raw_links:
            print(f"{RED}Файл пуст.{R}")
            input(f"{C}Нажмите Enter...{R}")
            return
        
        valid_links = []
        seen_proxies = set()
        duplicates_count = 0
        for link in raw_links:
            proxy_data = MTProtoChecker.parse_proxy_link(link)
            if proxy_data:
                proxy_key = (
                    proxy_data.get('type'),
                    proxy_data.get('server'),
                    proxy_data.get('port'),
                    proxy_data.get('secret'),
                    proxy_data.get('user'),
                    proxy_data.get('password')
                )
                if proxy_key not in seen_proxies:
                    seen_proxies.add(proxy_key)
                    valid_links.append(link)
                else:
                    duplicates_count += 1
                    
        if not valid_links:
            print(f"{RED}Нет валидных прокси-ссылок в файле.{R}")
            input(f"{C}Нажмите Enter...{R}")
            return
        print(f"{G}Загружено валидных прокси: {len(valid_links)} (Удалено дублей: {duplicates_count}){R}")
        
        results = []
        completed = 0
        total = len(valid_links)
        
        with ThreadPoolExecutor(max_workers=MAX_PROXY_WORKERS) as executor:
            future_to_link = {executor.submit(self.checker.check_single, link): link for link in valid_links}
            self._draw_progress(0, total)
            for future in as_completed(future_to_link):
                try:
                    valid, result = future.result()
                except Exception as e:
                    valid, result = False, {'link': future_to_link[future], 'error': str(e)[:100]}
                results.append(result)
                completed += 1
                self._draw_progress(completed, total)
        
        sys.stdout.write("\r" + "    " * 100 + "\r")
        sys.stdout.flush()
        
        self.print_batch_summary(results)
        print(f"\n{G}Сохранить результаты?{R}")
        print(f"  {G}1.{R} TXT")
        print(f"  {G}2.{R} JSON")
        print(f"  {G}3.{R} Нет")
        save = input(f"{Y}Выбор (1/2/3): {R}").strip()
        if save == '1':
            filepath = self.export_batch(results)
            print(apply_gradient(f"Сохранено в: {filepath}"))
        elif save == '2':
            filepath = self.export_batch_json(results)
            print(apply_gradient(f"Сохранено в: {filepath}"))
        else:
            print(f"{Y}Сохранение пропущено.{R}")
        input(f"\n{C}Нажмите Enter...{R}")

    def start_github_check(self):
        os.system('clear' if os.name != 'nt' else 'cls')
        print(apply_gradient("=== Проверка прокси с GitHub ==="))
        print(f"{Y}Загрузка списков прокси из открытых источников...{R}")
        spinner = Spinner("Загрузка")
        spinner.start()
        try:
            raw_proxies = self.checker.fetch_github_proxies()
