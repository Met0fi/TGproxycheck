    def _write_full_proxy_report(self, f, idx, result):
        f.write(f"{idx}. ССЫЛКА: {result.get('link', 'N/A')}\n\n")
        if result.get('proxy'):
            proxy = result['proxy']
            f.write(f"   Сервер: {proxy.get('server', 'N/A')}\n")
            f.write(f"   Порт: {proxy.get('port', 'N/A')}\n")
            f.write(f"   Протокол: {proxy.get('protocol', 'N/A').upper()}\n")
            if proxy.get('type') == 'socks5':
                f.write("   Тип: SOCKS5\n")
            else:
                f.write(f"   Тип обфускации: {result.get('proxy_type', 'N/A')}\n")
                f.write(f"   Тип секрета: {result.get('secret_info', {}).get('type', 'N/A').upper()}\n")
                if proxy.get('secret', '').startswith('ee'):
                    sni = _decode_domain(proxy['secret'])
                    if sni:
                        f.write(f"   SNI домен: {sni}\n")
        f.write(f"\n   IP адрес: {result.get('ip', 'N/A')}\n")
        f.write(f"   DNS статус: {result.get('dns_status', 'N/A')}\n")
        f.write(f"   Статус порта: {result.get('port_status', 'N/A')}\n")
        if result.get('ping') is not None:
            f.write(f"   Пинг: {result.get('ping')} мс (Джиттер: {result.get('jitter')} мс)\n")
        else:
            f.write(f"   Пинг: {result.get('ping_status', 'N/A')}\n")
        f.write(f"   Рукопожатие: {result.get('mtproto_msg', 'N/A')}\n")
        carriers = result.get('carriers', {})
        if carriers:
            c_str = f"МТС:{'+' if carriers.get('MTS') else '-'} БИЛ:{'+' if carriers.get('Beeline') else '-'} МЕГ:{'+' if carriers.get('Megafon') else '-'} ТЕЛ2:{'+' if carriers.get('Tele2') else '-'}"
            f.write(f"   Операторы: {c_str}\n")
        f.write(f"   Оценка: {result.get('connection_score', 0)}/100\n")
        geo = result.get('geo', {})
        if isinstance(geo, dict) and 'error' not in geo:
            f.write(f"   Страна: {geo.get('country', 'N/A')} ({geo.get('countryCode', 'N/A')})\n")
            f.write(f"   Регион: {geo.get('region', 'N/A')} ({geo.get('regionCode', 'N/A')})\n")
            f.write(f"   Город: {geo.get('city', 'N/A')}\n")
            f.write(f"   Индекс: {geo.get('zip', 'N/A')}\n")
            f.write(f"   Провайдер: {geo.get('isp', 'N/A')}\n")
            f.write(f"   Организация: {geo.get('org', 'N/A')}\n")
            f.write(f"   AS: {geo.get('as', 'N/A')}\n")
            f.write(f"   Часовой пояс: {geo.get('timezone', 'N/A')}\n")
            f.write(f"   Координаты: {geo.get('lat', 'N/A')}, {geo.get('lon', 'N/A')}\n")
            if geo.get('proxy'):
                f.write("   Тип IP: Proxy/VPN\n")
            if geo.get('hosting'):
                f.write("   Хостинг: Да (дата-центр)\n")
            if geo.get('mobile'):
                f.write("   Мобильная сеть: Да\n")
        advanced = result.get('advanced_test', {})
        if advanced and advanced.get('tcp_connect'):
            f.write(f"   TCP задержка: {advanced.get('tcp_latency', 'N/A')} мс\n")
        if result.get('proxy', {}).get('type') != 'socks5':
            f.write(f"\n   Белый список: {result.get('whitelist_status', 'N/A')}\n")
            f.write(f"   В БС: {'Да' if result.get('is_whitelist') else 'Нет'}\n")
            bs_compat = result.get('bs_compat_info', {})
            if bs_compat.get('is_bs_compat'):
                f.write(f"   БС-совместимый: {bs_compat.get('service_name', 'N/A')} ({bs_compat.get('compat_source', 'N/A')})\n")
            if bs_compat.get('is_blocked_sni'):
                f.write(f"   Заблокированный SNI: {bs_compat.get('service_name', 'N/A')}\n")
        f.write(f"\n   Статус: {'РАБОЧИЙ' if result.get('valid') else 'НЕРАБОЧИЙ'}\n")
        if result.get('error'):
            f.write(f"   Ошибка: {result.get('error')}\n")
        f.write("\n" + "=" * 100 + "\n\n")

