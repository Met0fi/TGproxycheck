    @staticmethod
    def _build_fake_tls_client_hello(sni_domain: str, secret_bytes: bytes) -> bytes:
        grease_values = [0x0a, 0x1a, 0x2a, 0x3a, 0x4a, 0x5a, 0x6a, 0x7a, 0x8a, 0x9a, 0xaa, 0xba, 0xca, 0xda, 0xea, 0xfa]
        grease_b = random.choice(grease_values)
        grease = bytes([grease_b, grease_b])
        client_random = struct.pack('>I', int(time.time())) + secrets.token_bytes(28)
        session_id = secrets.token_bytes(32)
        cipher_suites = grease + b'\x13\x01\x13\x02\x13\x03\xc0\x2b\xc0\x2f\xc0\x2c\xc0\x30\xcc\xa9\xcc\xa8\xc0\x13\xc0\x14\x00\x9c\x00\x9d\x00\x2f\x00\x35\x00\x0a'
        compression = b'\x01\x00'
        exts = b''
        exts += grease + b'\x00\x00'
        if sni_domain:
            sni_b = sni_domain.encode('ascii')
            sni_entry = b'\x00' + struct.pack('>H', len(sni_b)) + sni_b
            sni_list = struct.pack('>H', len(sni_entry)) + sni_entry
            exts += b'\x00\x00' + struct.pack('>H', len(sni_list)) + sni_list
        exts += b'\x00\x17\x00\x00'
        exts += b'\xff\x01\x00\x01\x00'
        groups = grease + b'\x00\x1d\x00\x17\x00\x18\x00\x19\x01\x00\x01\x01'
        groups_data = struct.pack('>H', len(groups)) + groups
        exts += b'\x00\x0a' + struct.pack('>H', len(groups_data)) + groups_data
        exts += b'\x00\x0b\x00\x02\x01\x00'
        exts += b'\x00\x23\x00\x00'
        proto_list = b'\x02h2\x08http/1.1'
        alpn_data = struct.pack('>H', len(proto_list)) + proto_list
        exts += b'\x00\x10' + struct.pack('>H', len(alpn_data)) + alpn_data
        exts += b'\x00\x05\x00\x05\x01\x00\x00\x00\x00'
        sig_list = bytes.fromhex('0403080404010503080508060601020104020202')
        sig_data = struct.pack('>H', len(sig_list)) + sig_list
        exts += b'\x00\x0d' + struct.pack('>H', len(sig_data)) + sig_data
        exts += b'\x00\x12\x00\x00'
        x25519_pub = secrets.token_bytes(32)
        ks_grease = grease + b'\x00\x01\x00'
        ks_x25519 = b'\x00\x1d' + struct.pack('>H', 32) + x25519_pub
        ks_list = ks_grease + ks_x25519
        ks_data = struct.pack('>H', len(ks_list)) + ks_list
        exts += b'\x00\x33' + struct.pack('>H', len(ks_data)) + ks_data
        exts += b'\x00\x2d\x00\x02\x01\x01'
        sv_list = grease + b'\x03\x04\x03\x03'
        sv_data = struct.pack('B', len(sv_list)) + sv_list
        exts += b'\x00\x2b' + struct.pack('>H', len(sv_data)) + sv_data
        exts += b'\x00\x1b\x00\x03\x02\x00\x02'
        alps_proto = b'\x00\x03\x02h2'
        exts += b'\x44\x69' + struct.pack('>H', len(alps_proto)) + alps_proto
        exts += grease + b'\x00\x01\x00'
        exts_block = struct.pack('>H', len(exts)) + exts
        hello_body = b'\x03\x03' + client_random + struct.pack('B', 32) + session_id + struct.pack('>H', len(cipher_suites)) + cipher_suites + compression + exts_block
        handshake_msg = b'\x01' + struct.pack('>I', len(hello_body))[1:] + hello_body
        return b'\x16\x03\x01' + struct.pack('>H', len(handshake_msg)) + handshake_msg

    @staticmethod
    def _build_obfuscated_init(protocol_tag: bytes) -> Tuple[bytes, bytes, bytes, bytes, bytes]:
        FORBIDDEN_FIRST = {0xef, 0x44, 0x53, 0x20, 0x47, 0x50, 0x4f, 0x16, 0x80, 0x00}
        FORBIDDEN_4 = [
            b'GET ', b'POST', b'HEAD', b'OPTI',
            bytes([0xee] * 4), bytes([0xdd] * 4), bytes([0xef] * 4),
            b'\x16\x03\x01\x00', b'\x16\x03\x03\x00',
        ]
        while True:
            init = bytearray(secrets.token_bytes(64))
            if init[0] in FORBIDDEN_FIRST: continue
            if any(bytes(init[:4]).startswith(h) for h in FORBIDDEN_4): continue
            if bytes(init[4:8]) == b'\x00\x00\x00\x00': continue
            break
        init[56:60] = protocol_tag
        encrypt_key = bytes(init[8:40])
        encrypt_iv = bytes(init[40:56])
        decrypt_key = bytes(reversed(init[8:40]))
        decrypt_iv = bytes(reversed(init[40:56]))
        encrypted = _try_aes_ctr(bytes(init), encrypt_key, encrypt_iv)
        packet = bytes(init[:56]) + encrypted[56:64] if encrypted else bytes(init)
        return packet, encrypt_key, encrypt_iv, decrypt_key, decrypt_iv

    @staticmethod
    def _classify_handshake_response(response: bytes, secret_type: str) -> Tuple[bool, str]:
        if not response: return False, "Нет ответа (FIN сброс)"
        head = response[:4]
        if head == b'\xff\xff\xff\xff': return False, "MTProto отклонено"
        low = response[:16].lower()
        if b'HTTP/' in response[:8] or b'<html' in low or b'<!doc' in low:
            return False, "Перехват: HTTP-страница"
        if head[:2] == b'\x15\x03': return False, "TLS Alert (Блокировка)"
        if secret_type == MT_PROTO_SECRET_TYPES['fake_tls']:
            if response[0:1] == b'\x16' and response[1:3] in (b'\x03\x01', b'\x03\x03') and len(response) >= 50:
                return True, f"TLS ServerHello ({len(response)} байт)"
            return False, f"Слишком короткий ответ ({len(response)} байт)"
        if secret_type in (MT_PROTO_SECRET_TYPES['padded'], MT_PROTO_SECRET_TYPES['plain'], ''):
            if len(response) >= 64: return True, f"MTProto ответ ({len(response)} байт)"
            if len(response) >= 16 and response[0] not in (0x14, 0x15, 0x16, 0x17):
                return True, f"MTProto короткий ({len(response)} байт)"
            return False, f"Слишком короткий ответ ({len(response)} байт)"
        return False, f"Неопознанный ответ ({len(response)} байт)"

    @staticmethod
    def mtproto_handshake_test(host: str, port: int, secret: str, timeout: float = 10.0) -> Tuple[bool, str]:
        secret_type = secret[:2] if len(secret) >= 2 else ''
        for attempt in range(3):
            try:
                with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as sock:
                    sock.settimeout(timeout)
                    sock.connect((host, port))
                    if secret_type == MT_PROTO_SECRET_TYPES['fake_tls']:
                        raw_key = secret[2:34]
                        secret_bytes = bytes.fromhex(raw_key) if len(raw_key) == 32 else secrets.token_bytes(16)
                        sni_domain = _decode_domain(secret)
                        if not sni_domain or '.' not in sni_domain:
                            sni_domain = random.choice(BS_COMPAT_SNI_RU)
                        header = MTProtoChecker._build_fake_tls_client_hello(sni_domain, secret_bytes)
                    elif secret_type == MT_PROTO_SECRET_TYPES['padded']:
                        header, *_ = MTProtoChecker._build_obfuscated_init(b'\xdd\xdd\xdd\xdd')
                    else:
                        header, *_ = MTProtoChecker._build_obfuscated_init(b'\xef\xef\xef\xef')
                    sock.sendall(header)
                    sock.settimeout(5.0)
                    try:
                        response = sock.recv(2048)
                        return MTProtoChecker._classify_handshake_response(response, secret_type)
                    except socket.timeout:
                        return False, "Таймаут чтения ответа"
                    except ConnectionResetError:
                        return False, "Соединение сброшено (RST)"
                    except OSError:
                        if attempt < 2:
                            timeout = min(timeout * 1.5, 15.0)
                            time.sleep(0.1 * (attempt + 1))
                            continue
                        return False, "Сетевая ошибка при чтении"
            except socket.timeout:
                if attempt < 2:
                    timeout = min(timeout * 1.5, 15.0)
                    time.sleep(0.1 * (attempt + 1))
                    continue
                return False, "Таймаут подключения"
            except ConnectionRefusedError:
                return False, "В соединении отказано (Закрыто)"
            except ConnectionResetError:
                if attempt < 2:
                    time.sleep(0.1 * (attempt + 1))
                    continue
                return False, "RST на connect"
            except socket.error as e:
                return False, f"Ошибка сокета: {str(e)[:40]}"
            except Exception as e:
                return False, f"Ошибка: {str(e)[:40]}"
        return False, "Отказ после попыток"

    @staticmethod
    def _create_aes_ctr(key: bytes, iv: bytes):
        padded_key = (key + b'\x00' * 32)[:32]
        padded_iv = (iv + b'\x00' * 16)[:16]
        if HAS_PYCRYPTODOME:
            try:
                return _AES.new(padded_key, _AES.MODE_CTR, initial_value=padded_iv, nonce=b'')
            except Exception:
                pass
        if HAS_CRYPTOGRAPHY:
            try:
                return _Cipher(_alg.AES(padded_key), _modes.CTR(padded_iv)).encryptor()
            except Exception:
                pass
        return None

    @staticmethod
    def _aes_ctr_update(cipher, data: bytes) -> bytes:
        if cipher is None: return data
        return cipher.update(data)

    @staticmethod
    def fast_mtproto_req_pq_test(host: str, port: int, secret: str, timeout: float = 5.0) -> Tuple[bool, str, float]:
        start_time = time.monotonic()
        try:
            secret_hex = secret[2:] if secret[:2] in ('dd', 'ee', '') else secret
            if secret.startswith('ee'):
                return False, "FakeTLS не поддерживается в быстром тесте", 0.0
            
            secret_bytes = bytes.fromhex(secret_hex)
            proto_tag = b'\xdd\xdd\xdd\xdd' if secret.startswith('dd') else b'\xee\xee\xee\xee'
            mode = 'secure' if secret.startswith('dd') else 'intermediate'
            
            dc_id = 1
            while True:
                init = bytearray(os.urandom(64))
                if init[0] == 0xEF: continue 
                if bytes(init[:4]) in [b'GET ', b'POST', b'HEAD', b'OPTI', b'\x00\x00\x00\x00', b'\xef\xef\xef\xef', b'\xee\xee\xee\xee', b'\xdd\xdd\xdd\xdd']: continue
                if bytes(init[4:8]) == b'\x00\x00\x00\x00': continue
                break
            
            init[56:60] = proto_tag
            init[60] = dc_id & 0xFF
            init[61:64] = b'\x00\x00\x00'
            
            encrypt_key_material = bytes(init[8:40])
            encrypt_iv = bytes(init[40:56])
            decrypt_key_material = bytes(init[55:23:-1])
            decrypt_iv = bytes(init[23:7:-1])
            
            enc_key = hashlib.sha256(encrypt_key_material + secret_bytes).digest()
            dec_key = hashlib.sha256(decrypt_key_material + secret_bytes).digest()
            
            enc = MTProtoChecker._create_aes_ctr(enc_key, encrypt_iv)
            dec = MTProtoChecker._create_aes_ctr(dec_key, decrypt_iv)
            if not enc or not dec:
                return False, "AES не поддерживается", 0.0
                
            encrypted_init = MTProtoChecker._aes_ctr_update(enc, bytes(init))
            init[56:64] = encrypted_init[56:64]
            
            with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as sock:
                sock.settimeout(timeout)
                sock.connect((host, port))
                sock.sendall(bytes(init))
                
                nonce = os.urandom(16)
                req_payload = struct.pack('<I', 0xBE7E8EF1) + nonce
                
                if mode == 'secure':
                    padding_len = os.urandom(1)[0] % 4
                    padding = os.urandom(padding_len)
                    frame = struct.pack('<I', len(req_payload) + padding_len) + req_payload + padding
                elif mode == 'intermediate':
                    frame = struct.pack('<I', len(req_payload)) + req_payload
                else:
                    l = len(req_payload) // 4
                    frame = (bytes([l]) if l < 127 else b'\x7f' + struct.pack('<I', l)[1:]) + req_payload
                    
                encrypted_req = MTProtoChecker._aes_ctr_update(enc, frame)
                sock.sendall(encrypted_req)
                
                if mode in ('secure', 'intermediate'):
                    enc_len = sock.recv(4)
                    if len(enc_len) < 4: return False, "Обрыв при чтении длины", 0.0
                    dec_len = MTProtoChecker._aes_ctr_update(dec, enc_len)
                    frame_len = struct.unpack('<I', dec_len)[0]
                    if frame_len > 2 * 1024 * 1024: return False, "Слишком большой фрейм", 0.0
                    
                    enc_payload = b''
                    while len(enc_payload) < frame_len:
                        chunk = sock.recv(frame_len - len(enc_payload))
                        if not chunk: break
                        enc_payload += chunk
                    if len(enc_payload) < frame_len: return False, "Обрыв при чтении фрейма", 0.0
                    payload = MTProtoChecker._aes_ctr_update(dec, enc_payload)
                else:
                    enc_first = sock.recv(1)
                    if not enc_first: return False, "Обрыв", 0.0
                    first = MTProtoChecker._aes_ctr_update(dec, enc_first)[0]
                    if first < 127:
                        frame_len = first * 4
                    else:
                        enc_rest = sock.recv(3)
                        rest = MTProtoChecker._aes_ctr_update(dec, enc_rest)
                        frame_len = struct.unpack('<I', b'\x00' + rest)[0]
                    
                    enc_payload = b''
                    while len(enc_payload) < frame_len:
                        chunk = sock.recv(frame_len - len(enc_payload))
                        if not chunk: break
                        enc_payload += chunk
                    payload = MTProtoChecker._aes_ctr_update(dec, enc_payload)
                    
                if len(payload) < 24: return False, "Короткий ответ", 0.0
                if payload[:8] != b'\x00' * 8: return False, "Не MTProto ответ", 0.0
                msg_len = struct.unpack('<I', payload[16:20])[0]
                if msg_len > len(payload) - 20: return False, "Неверная длина сообщения", 0.0
                body = payload[20:20+msg_len]
                if len(body) < 36: return False, "Короткое тело", 0.0
                constructor = struct.unpack('<I', body[:4])[0]
                if constructor != 0x05162463: return False, f"Не resPQ (0x{constructor:08x})", 0.0
                res_nonce = body[4:20]
                if res_nonce != nonce: return False, "Nonce не совпадает", 0.0
                
                elapsed = (time.monotonic() - start_time) * 1000
                return True, f"resPQ получен ({elapsed:.1f}мс)", elapsed
                
        except socket.timeout:
            return False, "Таймаут", 0.0
        except Exception as e:
            return False, f"Ошибка: {str(e)[:40]}", 0.0

    @staticmethod
    async def _test_single_carrier(proxy: Dict, carrier: str, prof: Dict, timeout: float) -> Tuple[str, bool]:
        if proxy.get('type') == 'socks5' and HAS_CURL_CFFI:
            try:
                if proxy.get('user'):
                    proxies = {
                        "http": f"socks5://{proxy['user']}:{proxy['password']}@{proxy['server']}:{proxy['port']}",
                        "https": f"socks5://{proxy['user']}:{proxy['password']}@{proxy['server']}:{proxy['port']}"
                    }
                else:
                    proxies = {
                        "http": f"socks5://{proxy['server']}:{proxy['port']}",
                        "https": f"socks5://{proxy['server']}:{proxy['port']}"
                    }
                r = _cffi_requests.get(
                    "https://api.telegram.org",
                    proxies=proxies,
                    impersonate=prof["impersonate"],
                    headers={"User-Agent": prof["ua"]},
                    timeout=timeout
                )
                if r.status_code in (200, 401, 404, 302):
                    return carrier, True
            except Exception:
                pass
        client = None
        try:
            if proxy.get('type') == 'mtproto':
                proxy_config = (proxy['server'], proxy['port'], proxy['secret'])
                client = TelegramClient(
                    StringSession(), api_id=prof["api_id"], api_hash=prof["api_hash"],
                    connection=ChromeFingerprintFakeTLSConnection,
                    proxy=proxy_config, timeout=timeout, connection_retries=2,
                    device_model=prof["model"], system_version=prof["sys_ver"],
                    app_version=prof["app_ver"], lang_code="ru",
                    system_lang_code="ru_RU"
                )
            elif proxy.get('type') == 'socks5':
                if not HAS_PYSOCKS: return carrier, False
                proxy_config = {
                    'proxy_type': 'socks5', 'addr': proxy['server'],
                    'port': proxy['port'], 'username': proxy.get('user'),
                    'password': proxy.get('password')
                }
                client = TelegramClient(
                    StringSession(), api_id=prof["api_id"], api_hash=prof["api_hash"],
                    connection=ConnectionTcpFull, proxy=proxy_config,
                    timeout=timeout, connection_retries=2,
                    device_model=prof["model"], system_version=prof["sys_ver"],
                    app_version=prof["app_ver"], lang_code="ru",
                    system_lang_code="ru_RU"
                )
            else:
                return carrier, False
            try:
                await asyncio.wait_for(client.connect(), timeout=timeout)
            except (ConnectionResetError, OSError, asyncio.CancelledError, asyncio.TimeoutError):
                return carrier, False
            except Exception:
                return carrier, False
            is_conn = False
            try:
                is_conn = client.is_connected()
                if is_conn:
                    auth_key = getattr(client.session, 'auth_key', None) or getattr(client, 'auth_key', None)
                    if auth_key is None:
                        is_conn = False
            except Exception:
                is_conn = False
            return carrier, is_conn
        except Exception:
            return carrier, False
        finally:
            await _safe_disconnect(client)

    @staticmethod
    async def _check_carriers_async(proxy: Dict, timeout: float = 8.0) -> Dict[str, bool]:
        results = {"MTS": False, "Beeline": False, "Megafon": False, "Tele2": False}
        tasks = []
        for carrier, profiles in CARRIER_PROFILES.items():
            prof = random.choice(profiles)
            tasks.append(MTProtoChecker._test_single_carrier(proxy, carrier, prof, timeout))
        res_list = await asyncio.gather(*tasks, return_exceptions=True)
        for r in res_list:
            if isinstance(r, tuple) and len(r) == 2:
                results[r[0]] = r[1]
        return results

    @staticmethod
    def run_carrier_checks(proxy: Dict, timeout: float = 8.0) -> Dict[str, bool]:
        loop = None
        try:
            loop = asyncio.new_event_loop()
            asyncio.set_event_loop(loop)
            _install_asyncio_exception_handler(loop)
            return loop.run_until_complete(MTProtoChecker._check_carriers_async(proxy, timeout))
        except Exception:
            return {"MTS": False, "Beeline": False, "Megafon": False, "Tele2": False}
        finally:
            if loop is not None:
                try:
                    pending = asyncio.all_tasks(loop)
                    for task in pending:
                        task.cancel()
                    if pending:
                        loop.run_until_complete(asyncio.gather(*pending, return_exceptions=True))
                    try:
                        loop.run_until_complete(asyncio.sleep(0.05))
                    except Exception:
                        pass
                except Exception:
                    pass
                finally:
                    try:
                        loop.close()
                    except Exception:
                        pass
                    try:
                        asyncio.set_event_loop(None)
                    except Exception:
                        pass

    @classmethod
    def get_geolocation(cls, ip: str) -> Dict[str, str]:
        cached = cls._geo_cache.get(ip)
        if cached: return cached
        cls._rate_limiter.wait()
        with cls._geo_lock:
            now = time.time()
            elapsed = now - cls._last_geo_request
            if elapsed < GEO_REQUEST_DELAY:
                time.sleep(GEO_REQUEST_DELAY - elapsed)
            cls._last_geo_request = time.time()
        session = cls._get_session()
        for api_url in GEO_API_URLS:
            try:
                response = session.get(api_url.format(ip), timeout=5)
                if response.status_code == 429: continue
                if response.status_code == 200:
                    data = response.json()
                    if isinstance(data, dict):
                        if data.get('success') or data.get('status') == 'success' or 'country' in data or 'country_name' in data:
                            country = data.get('country') or data.get('country_name') or data.get('countryName', 'N/A')
                            region = data.get('region') or data.get('regionName', 'N/A')
                            isp = (data.get('isp') or data.get('org') or data.get('connection', {}).get('isp', 'N/A'))
                            result = {
                                'country': country, 'countryCode': data.get('countryCode') or data.get('country_code', 'N/A'),
                                'region': region, 'regionCode': data.get('regionCode') or data.get('region_code', 'N/A'),
                                'city': data.get('city', 'N/A'), 'zip': data.get('zip') or data.get('postal', 'N/A'),
                                'isp': isp, 'org': data.get('org') or data.get('connection', {}).get('org', 'N/A'),
                                'as': (data.get('as') or data.get('asn') or data.get('connection', {}).get('asn', 'N/A')),
                                'timezone': (data.get('timezone', 'N/A') if isinstance(data.get('timezone'), str) else data.get('timezone', {}).get('id', 'N/A')),
                                'lat': data.get('lat') or data.get('latitude', 'N/A'),
                                'lon': data.get('lon') or data.get('longitude', 'N/A'),
                                'proxy': data.get('proxy') or data.get('security', {}).get('proxy', False),
                                'hosting': data.get('hosting') or data.get('security', {}).get('hosting', False),
                                'mobile': data.get('mobile', False)
                            }
                            cls._geo_cache.set(ip, result)
                            return result
            except Exception:
                continue
        result = {'error': 'Не удалось получить геолокацию'}
        cls._geo_cache.set(ip, result)
        return result

    @staticmethod
    def resolve_ip(hostname: str) -> Tuple[Optional[str], str]:
        cached_ip = MTProtoChecker._dns_cache.get(hostname)
        if cached_ip is not None:
            if cached_ip == _DNS_FAIL:
                return None, "DNS не разрешён (кэш)"
            return cached_ip, "OK (кэш)"
        try:
            ip = socket.gethostbyname(hostname)
            MTProtoChecker._dns_cache.set(hostname, ip)
            return ip, "OK"
        except socket.gaierror:
            MTProtoChecker._dns_cache.set(hostname, _DNS_FAIL)
            return None, "DNS не разрешён"
        except Exception as e:
            return None, str(e)[:50]

    @staticmethod
    def detect_proxy_type(secret: str) -> str:
        if secret.startswith(MT_PROTO_SECRET_TYPES['fake_tls']):
            return "Fake-TLS (обфускация под HTTPS)"
        elif secret.startswith(MT_PROTO_SECRET_TYPES['padded']):
            return "Padded (дополнение пакетов)"
        return "Standard (базовая обфускация)"

    @staticmethod
    def check_secret_format(secret: str) -> Dict[str, Any]:
        result = {'valid': False, 'type': 'unknown', 'length': len(secret), 'hex_valid': False, 'message': ''}
        if len(secret) < 32:
            result['message'] = f"Секрет слишком короткий ({len(secret)} < 32)"
            return result
        clean_secret = secret
        if secret[:2] in MT_PROTO_SECRET_TYPES.values():
            result['type'] = next((k for k, v in MT_PROTO_SECRET_TYPES.items() if v == secret[:2]), 'unknown')
            clean_secret = secret[2:]
        else:
            result['type'] = 'plain'
        if re.match(r'^[0-9a-fA-F]+$', clean_secret):
            result['hex_valid'] = True
            try:
                decoded = bytes.fromhex(clean_secret)
                result['valid'] = True
                result['message'] = f"Валидный {result['type']} секрет ({len(decoded)} байт)"
            except ValueError:
                result['message'] = "Ошибка декодирования HEX"
        else:
            result['message'] = "Неверный формат HEX"
        return result

    @staticmethod
    def advanced_connection_test(host: str, port: int, secret: str, timeout: float = 8.0) -> Tuple[bool, str, Dict]:
        test_results = {'tcp_connect': False, 'tcp_latency': None, 'ssl_test': False, 'http_probe': False, 'response_time': None}
        try:
            start_time = time.monotonic()
            with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as sock:
                sock.settimeout(timeout)
                connect_result = sock.connect_ex((host, port))
                test_results['tcp_connect'] = (connect_result == 0)
                if test_results['tcp_connect']:
                    test_results['tcp_latency'] = round((time.monotonic() - start_time) * 1000, 2)
                    try:
                        sock.sendall(b'\x16\x03\x01')
                        sock.settimeout(2.0)
                        response = sock.recv(5)
                        test_results['ssl_test'] = (len(response) > 0)
                    except Exception:
                        pass
            if test_results['tcp_connect']:
                try:
                    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as http_sock:
                        http_sock.settimeout(3.0)
                        http_sock.connect((host, port))
                        http_sock.sendall(f"HEAD / HTTP/1.1\r\nHost: {host}\r\n\r\n".encode())
                        http_sock.settimeout(3.0)
                        http_response = http_sock.recv(1024)
                        test_results['http_probe'] = (len(http_response) > 0)
                except Exception:
                    pass
                test_results['response_time'] = round((time.monotonic() - start_time) * 1000, 2)
                return True, "Соединение установлено", test_results
            return False, "TCP соединение не удалось", test_results
        except Exception as e:
            return False, str(e)[:60], test_results

