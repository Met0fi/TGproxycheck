                f.write(f"Всего проверено: {len(self.batch_results)}\n")
                f.write(f"Рабочих: {working}\n")
                f.write(f"В белых списках: {whitelist}\n")
                f.write("=" * 100 + "\n\n")
                working_list = [r for r in self.batch_results if r.get('valid')]
                failed_list = [r for r in self.batch_results if not r.get('valid')]
                if working_list:
                    f.write("=== РАБОЧИЕ ПРОКСИ ===\n\n")
                    for idx, result in enumerate(working_list, 1):
                        self._write_full_proxy_report(f, idx, result)
                if failed_list:
                    f.write("=== НЕРАБОЧИЕ ПРОКСИ ===\n\n")
                    for idx, result in enumerate(failed_list, 1):
                        self._write_full_proxy_report(f, idx, result)
            messagebox.showinfo("Успех", f"Результаты сохранены:\n{filepath}")
        except Exception as e:
            messagebox.showerror("Ошибка", str(e))

    def export_all_batch_json(self):
        if not self.batch_results:
            messagebox.showinfo("Информация", "Нет результатов для экспорта!")
            return
        filepath = filedialog.asksaveasfilename(defaultextension=".json", filetypes=[("JSON files", "*.json")])
        if not filepath: return
        try:
            sorted_results = sorted(self.batch_results, key=lambda r: (not r.get('valid', False), -r.get('connection_score', 0)))
            with open(filepath, 'w', encoding='utf-8') as f:
                json.dump(sorted_results, f, ensure_ascii=False, indent=2, default=str)
            messagebox.showinfo("Успех", f"Результаты сохранены:\n{filepath}")
        except Exception as e:
            messagebox.showerror("Ошибка", str(e))

    def clear_batch_results(self):
        for item in self.batch_tree.get_children():
            self.batch_tree.delete(item)
        self.batch_results = []
        self.batch_progress_var.set("Готово: 0/0")

