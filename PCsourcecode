                return False, result
            bs_compat_info = cls._detect_bs_compat_proxy(proxy_data['secret'])
            result['bs_compat_info'] = bs_compat_info
            ip, dns_status = cls.resolve_ip(proxy_data['server'])
            result['dns_status'] = dns_status
            if not ip:
                result['error'] = f"DNS ошибка: {dns_status}"
                return False, result
            result['ip'] = ip
            result['geo'] = cls.get_geolocation(ip)
            port_open, port_status = cls.check_port_open(ip, proxy_data['port'], timeout=5.0)
            result['port_open'] = port_open
            result['port_status'] = port_status
            advanced_ok, advanced_msg, advanced_data = cls.advanced_connection_test(ip, proxy_data['port'], proxy_data['secret'], timeout=8.0)
            result['advanced_test'] = advanced_data
            if not port_open:
                result['error'] = f"Порт закрыт: {port_status}"
                return False, result
            ping, jitter, ping_status = cls.measure_ping(ip, proxy_data['port'], timeout=5.0)
            result['ping'] = ping
            result['jitter'] = jitter
            result['ping_status'] = ping_status
            
            secret = proxy_data.get('secret', '')
            if not secret.startswith('ee'):
                mtproto_ok, mtproto_msg, _ = cls.fast_mtproto_req_pq_test(ip, proxy_data['port'], secret, timeout=8.0)
            else:
                mtproto_ok, mtproto_msg = cls.mtproto_handshake_test(ip, proxy_data['port'], secret, timeout=8.0)
            result['mtproto_ok'] = mtproto_ok
            result['mtproto_msg'] = mtproto_msg
            
            carriers_res = cls.run_carrier_checks(proxy_data, timeout=6.0)
            result['carriers'] = carriers_res
            telethon_ok = any(carriers_res.values())
            result['telethon_ok'] = telethon_ok
            result['telethon_msg'] = "Успех" if telethon_ok else "Отказ"
            whitelist_msg, is_wl = cls._test_whitelist_status(proxy_data, mtproto_ok, port_open, ip, ping)
            result['whitelist_status'] = whitelist_msg
            result['is_whitelist'] = is_wl
            if not telethon_ok and not mtproto_ok:
                result['error'] = mtproto_msg
                cls._collect_all_available_data(result)
                return False, result
            score = 0
            if port_open: score += 20
            if mtproto_ok: score += 15
            if telethon_ok: score += 20
            if ping is not None:
                if ping < 80: score += 20
                elif ping < 150: score += 15
                elif ping < 300: score += 10
                elif ping < 500: score += 5
            if is_wl: score += 15
            if bs_compat_info.get('is_bs_compat') and bs_compat_info.get('is_russian_service'):
                score += 10
            result['connection_score'] = min(score, 100)
            result['valid'] = telethon_ok or mtproto_ok
            if not result['valid']:
                result['error'] = "Провалены тесты соединения"
            cls._collect_all_available_data(result)
            return result['valid'], result
        except Exception as e:
            result['error'] = str(e)[:100]
            cls._collect_all_available_data(result)
            return False, result

