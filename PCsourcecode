    @staticmethod
    def measure_ping(host: str, port: int, timeout: float = 5.0) -> Tuple[Optional[float], Optional[float], str]:
        pings = []
        for _ in range(3):
            try:
                start = time.monotonic()
                with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as sock:
                    sock.settimeout(timeout)
                    sock.connect((host, port))
                pings.append((time.monotonic() - start) * 1000)
            except Exception:
                pass
        if not pings:
            return None, None, "Таймаут"
        avg_ping = round(sum(pings) / len(pings), 2)
        jitter = round(max(pings) - min(pings), 2) if len(pings) > 1 else 0.0
        return avg_ping, jitter, "OK"

