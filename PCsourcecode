    def _run_github_check(self):
        try:
            raw_proxies = self.checker.fetch_github_proxies()
            self.root.after(0, lambda: self.github_count_var.set(f"Найдено: {len(raw_proxies)}"))
            valid_results = []
            total = len(raw_proxies)
            completed = 0
            with ThreadPoolExecutor(max_workers=MAX_WORKERS * 3) as executor:
                future_to_link = {executor.submit(self.checker.check_single_fast, link): link for link in raw_proxies}
                for future in as_completed(future_to_link):
                    try:
                        is_valid, result = future.result()
                        if is_valid:
                            valid_results.append(result)
                    except Exception:
                        pass
                    completed += 1
            valid_results.sort(key=lambda x: x.get('connection_score', 0), reverse=True)
            top_results = valid_results[:15]
            self.github_results = top_results
            self.root.after(0, self._populate_github_tree, top_results)
            self.root.after(0, lambda: self.status_var.set(f"Готово. Найдено лучших: {len(top_results)}"))
        except Exception as e:
            self.root.after(0, lambda: self.status_var.set(f"Ошибка: {e}"))
        finally:
            self.root.after(0, self.progress.stop)
            self.root.after(0, lambda: self.github_fetch_btn.config(state=tk.NORMAL))

    def _populate_github_tree(self, results):
        for item in self.github_tree.get_children():
            self.github_tree.delete(item)
        for i, res in enumerate(results, 1):
            proxy = res.get('proxy', {})
            server = proxy.get('server', 'N/A')
            port = proxy.get('port', 'N/A')
            protocol = proxy.get('protocol', 'N/A').upper()
            ping = res.get('ping')
            ping_str = f"{ping:.0f}" if ping is not None else "N/A"
            score = res.get('connection_score', 0)
            geo = res.get('geo', {})
            country = geo.get('country', 'N/A') if isinstance(geo, dict) else 'N/A'
            self.github_tree.insert("", tk.END, values=(i, server, port, protocol, ping_str, score, country), tags=('ok',))

