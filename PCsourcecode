    def _try_extract_server_port(self, link: str) -> Tuple[str, str]:
        try:
            parsed = urllib.parse.urlparse(link)
            params = urllib.parse.parse_qs(parsed.query)
            return params.get('server', ['N/A'])[0], params.get('port', ['N/A'])[0]
        except Exception:
            pass
        try:
            match = re.search(r'server=([^&]+)&port=(\d+)', link)
            if match:
                return match.group(1), match.group(2)
        except Exception:
            pass
        return 'N/A', 'N/A'

    def start_single_check(self):
        link = self.single_link_entry.get().strip()
        if not link:
            messagebox.showwarning("Внимание", "Введите ссылку на прокси!")
            return
        self.status_var.set("Проверка...")
        self.clear_single_results()
        self.progress.start(15)
        threading.Thread(target=self._run_single_check, args=(link,), daemon=True).start()

    def _run_single_check(self, link: str):
        def add(param, value, status):
            status_map = {
                "success": "[OK]", "error": "[FAIL]",
                "warning": "[WARN]", "info": "[*]"
            }
            status_text = status_map.get(status, "[?]")
            self.root.after(
                0, lambda p=param, v=value, s=status, st=status_text: self.single_tree.insert(
                    "", tk.END, values=(p, v, f"{st} {s}"), tags=(s,)
                )
            )
        try:
            add("Ссылка", link, "info")
            valid, result = self.checker.check_single(link)
            proxy = result.get('proxy')
            if proxy:
                add("Парсинг ссылки", "Успешно", "success")
                add("Сервер", proxy['server'], "info")
                add("Порт", str(proxy['port']), "info")
                add("Протокол", proxy.get('protocol', 'N/A').upper(), "info")
                if proxy.get('type') == 'socks5':
                    add("Тип", "SOCKS5", "info")
                else:
                    add("Тип обфускации", result['proxy_type'], "info")
                    whitelist_status = result.get('whitelist_status', 'N/A')
                    add("Статус белых списков", whitelist_status, "success" if result.get('is_whitelist') else "warning")
                    bs_compat = result.get('bs_compat_info', {})
                    if bs_compat.get('is_bs_compat'):
                        add("БС-совместимый", f"{bs_compat.get('service_name', 'N/A')} ({bs_compat.get('compat_source', 'N/A')})", "success")
                    if bs_compat.get('is_blocked_sni'):
                        add("Заблокированный SNI", f"{bs_compat.get('service_name', 'N/A')} - не подходит для РФ", "error")
            else:
                add("Парсинг ссылки", "Неудачно", "error")
            if proxy and proxy.get('type') != 'socks5':
                secret_info = result.get('secret_info', {})
                if secret_info:
                    add("Длина секрета", f"{secret_info.get('length', 0)} символов", "info")
                    add("Тип секрета", secret_info.get('type', 'unknown').upper(), "info")
                    hex_valid = secret_info.get('hex_valid', False)
                    add("HEX валидация", "Валидный" if hex_valid else "Невалидный", "success" if hex_valid else "error")
                    add("Secret статус", result.get('secret_msg', 'N/A'), "success" if result.get('secret_valid') else "error")
                    if proxy.get('secret', '').startswith('ee'):
                        sni = _decode_domain(proxy['secret'])
                        if sni:
                            add("SNI домен (Fake-TLS)", sni, "info")
            add("DNS разрешение", result.get('dns_status', 'N/A'), "success" if result.get('ip') else "error")
            if result.get('ip'):
                add("IP адрес", result['ip'], "success")
            add("Статус порта", result.get('port_status', 'N/A'), "success" if result.get('port_open') else "error")
            if result.get('ping') is not None:
                color = "success" if result['ping'] < 200 else "warning" if result['ping'] < 500 else "error"
                j_str = f" (Джиттер: {result.get('jitter')} мс)" if result.get('jitter') is not None else ""
                add("Пинг (мс)", f"{result['ping']}{j_str}", color)
            else:
                add("Пинг (мс)", result.get('ping_status', 'N/A'), "warning")
            add("Рукопожатие", result.get('mtproto_msg', 'N/A'), "success" if result.get('mtproto_ok') else "error")
            carriers = result.get('carriers', {})
            if carriers:
                c_str = f"МТС:{'+' if carriers.get('MTS') else '-'} БИЛ:{'+' if carriers.get('Beeline') else '-'} МЕГ:{'+' if carriers.get('Megafon') else '-'} ТЕЛ2:{'+' if carriers.get('Tele2') else '-'}"
                add("Маскировка операторов", c_str, "success" if any(carriers.values()) else "error")
            advanced = result.get('advanced_test', {})
            if advanced:
                if advanced.get('tcp_connect'):
                    add("TCP соединение", "Установлено", "success")
                if advanced.get('tcp_latency'):
                    add("TCP задержка (мс)", f"{advanced['tcp_latency']}", "info")
                if advanced.get('ssl_test'):
                    add("SSL/TLS тест", "Поддерживается", "info")
                if advanced.get('http_probe'):
                    add("HTTP проба", "Отвечает", "info")
                if advanced.get('response_time'):
                    add("Время отклика (мс)", f"{advanced['response_time']}", "info")
            geo = result.get('geo', {})
            if 'error' not in geo:
                add("Страна", f"{geo.get('country', 'N/A')} ({geo.get('countryCode', 'N/A')})", "info")
                add("Регион", f"{geo.get('region', 'N/A')} ({geo.get('regionCode', 'N/A')})", "info")
                add("Город", geo.get('city', 'N/A'), "info")
                add("Индекс", geo.get('zip', 'N/A'), "info")
                add("Провайдер (ISP)", geo.get('isp', 'N/A'), "info")
                add("Организация", geo.get('org', 'N/A'), "info")
                add("AS", geo.get('as', 'N/A'), "info")
                add("Часовой пояс", geo.get('timezone', 'N/A'), "info")
                add("Координаты", f"{geo.get('lat', 'N/A')}, {geo.get('lon', 'N/A')}", "info")
