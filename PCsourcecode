    @staticmethod
    def extract_proxies_from_text(text: str) -> List[str]:
        proxies_set = set()
        tg_pattern = re.compile(r'tg://proxy\?server=([^\s&]+)&port=(\d+)&secret=([A-Za-z0-9_=+/%-]+)', re.IGNORECASE)
        for h, p, s in tg_pattern.findall(text):
            if _valid_port(p):
                proxies_set.add(f"tg://proxy?server={h}&port={p}&secret={s}")
        tme_pattern = re.compile(r't\.me/proxy\?server=([^\s&]+)&port=(\d+)&secret=([A-Za-z0-9_=+/%-]+)', re.IGNORECASE)
        for h, p, s in tme_pattern.findall(text):
            if _valid_port(p):
                proxies_set.add(f"https://t.me/proxy?server={h}&port={p}&secret={s}")
        socks_pattern = re.compile(r'tg://socks\?server=([^\s&]+)&port=(\d+)(?:&user=([^\s&]+))?(?:&pass=([^\s&]+))?', re.IGNORECASE)
        for h, p, u, pw in socks_pattern.findall(text):
            if _valid_port(p):
                link = f"tg://socks?server={h}&port={p}"
                if u: link += f"&user={u}"
                if pw: link += f"&pass={pw}"
                proxies_set.add(link)
        simple_pattern = re.compile(r'([A-Za-z0-9\.-]+):(\d+):([A-Fa-f0-9]{32,})')
        for h, p, s in simple_pattern.findall(text):
            if _valid_port(p):
                proxies_set.add(f"tg://proxy?server={h}&port={p}&secret={s}")
        txt = text.strip()
        if txt.startswith('[') or txt.startswith('{'):
            try:
                data = json.loads(txt)
                if isinstance(data, list):
                    for item in data:
                        if isinstance(item, dict):
                            host = item.get('host') or item.get('server')
                            port = item.get('port')
                            secret = item.get('secret')
                            if host and port and secret and _valid_port(str(port)):
                                proxies_set.add(f"tg://proxy?server={host}&port={port}&secret={secret}")
                elif isinstance(data, dict) and 'results' in data:
                    for item in data['results']:
                        if isinstance(item, dict):
                            host = item.get('host') or item.get('server')
                            port = item.get('port')
                            secret = item.get('secret')
                            if host and port and secret and _valid_port(str(port)):
                                proxies_set.add(f"tg://proxy?server={host}&port={port}&secret={secret}")
            except Exception:
                pass
        return list(proxies_set)

    @classmethod
    def fetch_github_proxies(cls) -> List[str]:
        proxies_set = set()
        session = cls._get_session()
        for url in cls.GITHUB_PROXY_SOURCES:
            try:
                response = session.get(url, timeout=10)
                if response.status_code == 200:
                    found = cls.extract_proxies_from_text(response.text)
                    proxies_set.update(found)
            except Exception:
                continue
        return list(proxies_set)

    @classmethod
    def check_top_github_proxies(cls, limit: int = 15) -> List[Dict]:
        raw_proxies = cls.fetch_github_proxies()
        valid_results = []
        with ThreadPoolExecutor(max_workers=MAX_WORKERS * 3) as executor:
            future_to_link = {executor.submit(cls.check_single_fast, link): link for link in raw_proxies}
            for future in as_completed(future_to_link):
                try:
                    is_valid, result = future.result()
                    if is_valid:
                        valid_results.append(result)
                except Exception:
                    continue
        valid_results.sort(key=lambda x: x.get('connection_score', 0), reverse=True)
        return valid_results[:limit]

    @staticmethod
    def parse_proxy_link(url: str) -> Optional[Dict[str, str]]:
        try:
            parsed = urllib.parse.urlparse(url)
            params = urllib.parse.parse_qs(parsed.query)
            if 'proxy' in url or 'secret' in url:
                if not all(k in params for k in ['server', 'port', 'secret']):
                    match = re.search(r'server=([^&]+)&port=(\d+)&secret=([^&]+)', url)
                    if match:
                        server_val, port_val, secret_val = match.groups()
                    else:
                        return None
                else:
                    server_val = params['server'][0]
                    port_val = params['port'][0]
                    secret_val = params['secret'][0]
                secret = secret_val.strip()
                if not all(c in '0123456789abcdefABCDEF' for c in secret):
                    missing_padding = len(secret) % 4
                    if missing_padding:
                        secret += '=' * (4 - missing_padding)
                    try:
                        secret = base64.urlsafe_b64decode(secret).hex()
                    except Exception:
                        pass
                protocol = 'mtproto'
                if secret.startswith(MT_PROTO_SECRET_TYPES['fake_tls']):
                    protocol = 'mtproto-fake-tls'
                elif secret.startswith(MT_PROTO_SECRET_TYPES['padded']):
                    protocol = 'mtproto-padded'
                return {
                    'type': 'mtproto',
                    'server': server_val,  
                    'port': int(port_val),
                    'secret': secret,
                    'protocol': protocol,
                    'secret_type': secret[:2] if len(secret) >= 2 else 'plain'
                }
            elif 'socks' in url:
                if not all(k in params for k in ['server', 'port']):
                    return None
                return {
                    'type': 'socks5',
                    'server': params['server'][0],
                    'port': int(params['port'][0]),
                    'user': params.get('user', [None])[0],
                    'password': params.get('pass', [None])[0],
                    'protocol': 'socks5',
                    'secret_type': 'plain'
                }
            else:
                return None
        except Exception:
            return None

    @staticmethod
    def validate_secret(secret: str) -> Tuple[bool, str]:
        if len(secret) < 32:
            return False, "Секрет слишком короткий"
        clean_secret = secret
        prefix_type = 'plain'
        if secret[:2] in MT_PROTO_SECRET_TYPES.values():
            prefix_type = next((k for k, v in MT_PROTO_SECRET_TYPES.items() if v == secret[:2]), 'plain')
            clean_secret = secret[2:]
        if not re.match(r'^[0-9a-fA-F]+$', clean_secret):
            return False, "Неверный формат HEX"
        if len(clean_secret) < 32:
            return False, f"Слишком короткий ключ ({len(clean_secret)})"
        try:
            decoded = bytes.fromhex(clean_secret)
            if prefix_type == 'fake_tls' and len(decoded) < 17:
                return False, "Fake-TLS: недостаточная длина"
            return True, f"Валидный {prefix_type} секрет ({len(decoded)} байт)"
        except ValueError:
            return False, "Ошибка декодирования HEX"

    @staticmethod
    def check_port_open(host: str, port: int, timeout: float = 5.0) -> Tuple[bool, str]:
        try:
            with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as sock:
                sock.settimeout(timeout)
                result = sock.connect_ex((host, port))
            if result == 0:
                return True, "Открыт"
            return False, f"Закрыт (код: {result})"
        except socket.timeout:
            return False, "Таймаут подключения"
        except socket.gaierror:
            return False, "DNS не разрешён"
        except Exception as e:
