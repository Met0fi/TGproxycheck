class DNSCache:
    def __init__(self):
        self.cache = {}
        self.timestamps = {}
        self.lock = threading.Lock()

    def get(self, hostname):
        with self.lock:
            if hostname in self.cache:
                if time.time() - self.timestamps[hostname] < DNS_CACHE_TTL:
                    return self.cache[hostname]
                else:
                    del self.cache[hostname]
                    del self.timestamps[hostname]
        return None

    def set(self, hostname, ip):
        with self.lock:
            self.cache[hostname] = ip
            self.timestamps[hostname] = time.time()

class GeoCache:
    def __init__(self):
        self.cache = {}
        self.lock = threading.Lock()

    def get(self, ip):
        with self.lock:
            return self.cache.get(ip)

    def set(self, ip, data):
        with self.lock:
            self.cache[ip] = data

class RateLimiter:
    def __init__(self, max_calls=40, period=60.0):
        self.max_calls = max_calls
        self.period = period
        self.calls = []
        self.lock = threading.Lock()

    def wait(self):
        with self.lock:
            now = time.monotonic()
            self.calls = [t for t in self.calls if now - t <= self.period]
            if len(self.calls) >= self.max_calls:
                sleep_time = self.period - (now - self.calls[0]) + 0.1
                if sleep_time > 0:
                    time.sleep(sleep_time)
                now = time.monotonic()
                self.calls = [t for t in self.calls if now - t <= self.period]
            self.calls.append(now)

