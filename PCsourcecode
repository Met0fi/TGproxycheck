    def load_batch_file(self):
        filepath = filedialog.askopenfilename(filetypes=[("Text files", "*.txt"), ("JSON files", "*.json"), ("All files", "*.*")])
        if not filepath: return
        try:
            with open(filepath, 'r', encoding='utf-8', errors='ignore') as f:
                text_content = f.read()
            valid_links = self.checker.extract_proxies_from_text(text_content)
            unique_links = []
            seen_proxies = set()
            duplicates_count = 0
            for link in valid_links:
                proxy_data = self.checker.parse_proxy_link(link)
                if proxy_data:
                    proxy_key = (
                        proxy_data.get('type'),
                        proxy_data.get('server'),
                        proxy_data.get('port'),
                        proxy_data.get('secret'),
                        proxy_data.get('user'),
                        proxy_data.get('password')
                    )
                    if proxy_key not in seen_proxies:
                        seen_proxies.add(proxy_key)
                        unique_links.append(link)
                    else:
                        duplicates_count += 1
            self.batch_results = []
            for item in self.batch_tree.get_children():
                self.batch_tree.delete(item)
            self.batch_links = unique_links
            self.batch_count_var.set(f"Прокси: {len(unique_links)} (Удалено дублей: {duplicates_count})")
            self.batch_progress_var.set(f"Готово: 0/{len(unique_links)}")
            self.batch_start_btn.config(state=tk.NORMAL if unique_links else tk.DISABLED)
            messagebox.showinfo("Загрузка", f"Извлечено валидных прокси: {len(valid_links)}\nУникальных: {len(unique_links)}\nДубликатов удалено: {duplicates_count}")
        except Exception as e:
            messagebox.showerror("Ошибка", str(e))

    def start_batch_check(self):
        if not hasattr(self, 'batch_links') or not self.batch_links: return
        self.batch_running = True
        self._stop_requested = False
        self.batch_start_btn.config(state=tk.DISABLED)
        self.batch_stop_btn.config(state=tk.NORMAL)
        self.progress.start(15)
        self.status_var.set("Пакетная проверка...")
        self.batch_results = []
        for item in self.batch_tree.get_children():
            self.batch_tree.delete(item)
        while not self.gui_queue.empty():
            try:
                self.gui_queue.get_nowait()
            except queue.Empty:
                break
        self.processed_count = 0
        self.total_to_process = len(self.batch_links)
        self._process_gui_queue()
        threading.Thread(target=self._run_batch_check, daemon=True).start()

    def stop_batch_check(self):
        self._stop_requested = True
        self.batch_running = False
        self.progress.stop()
        self.status_var.set("Проверка остановлена пользователем")
        self.batch_start_btn.config(state=tk.NORMAL)
        self.batch_stop_btn.config(state=tk.DISABLED)
        self.root.update_idletasks()

    def _process_gui_queue(self):
        items_processed = 0
        while not self.gui_queue.empty() and items_processed < 50:
            try:
                result = self.gui_queue.get_nowait()
                valid = result.get('valid', False)
                if valid:
                    status_icon = "[OK]"
                    row_tag = 'ok'
                elif result.get('error') and 'Заблокированный' in str(result.get('error', '')):
                    status_icon = "[BAN]"
                    row_tag = 'ban'
                else:
                    status_icon = "[FAIL]"
                    row_tag = 'fail'
                proxy = result.get('proxy', {})
                if proxy and proxy.get('server'):
                    server = proxy['server']
                    port = str(proxy['port'])
                    protocol = proxy.get('protocol', 'N/A').upper()
                else:
                    server, port = self._try_extract_server_port(result.get('link', ''))
                    protocol = 'N/A'
                ping = result.get('ping')
                jitter = result.get('jitter')
                ping_str = f"{ping:.0f}" if ping is not None else "N/A"
                jitter_str = f"{jitter:.0f}" if jitter is not None else "N/A"
                mtproto_str = "[OK]" if result.get('mtproto_ok') else "[FAIL]"
                carriers = result.get('carriers', {})
                c_str = "N/A"
                if carriers:
                    c_str = f"М:{'+' if carriers.get('MTS') else '-'} Б:{'+' if carriers.get('Beeline') else '-'} МГ:{'+' if carriers.get('Megafon') else '-'} Т2:{'+' if carriers.get('Tele2') else '-'}"
                wl_str = "[БС]" if result.get('is_whitelist') else "Нет"
                geo = result.get('geo', {})
                if isinstance(geo, dict) and 'error' not in geo:
                    country = geo.get('country', 'N/A')
                else:
                    country = 'N/A'
                score = result.get('connection_score', 0)
                self.batch_tree.insert("", tk.END, tags=(row_tag,), values=(
                    status_icon, server, port, protocol, ping_str, jitter_str, c_str,
                    mtproto_str, wl_str, country, score
                ))
                self.batch_results.append(result)
                self.processed_count += 1
                items_processed += 1
            except queue.Empty:
                break
        self.batch_progress_var.set(f"Готово: {self.processed_count}/{self.total_to_process}")
        if self._stop_requested:
            self._batch_check_finished()
            return
        if self.batch_running or not self.gui_queue.empty():
            self.root.after(100, self._process_gui_queue)
        else:
            self._batch_check_finished()

    def _run_batch_check(self):
        links = self.batch_links
        with ThreadPoolExecutor(max_workers=MAX_WORKERS) as executor:
            future_to_link = {executor.submit(self.checker.check_single, link): link for link in links}
            for future in as_completed(future_to_link):
                if self._stop_requested:
                    executor.shutdown(wait=False, cancel_futures=True)
                    break
                try:
                    valid, result = future.result()
                except Exception as e:
                    result = {'link': future_to_link[future], 'valid': False, 'error': str(e)[:100]}
                self.gui_queue.put(result)
        self.batch_running = False

    def _batch_check_finished(self):
        self.progress.stop()
        self.batch_start_btn.config(state=tk.NORMAL)
        self.batch_stop_btn.config(state=tk.DISABLED)
        if self.batch_results:
            working = sum(1 for r in self.batch_results if r.get('valid'))
            whitelist = sum(1 for r in self.batch_results if r.get('is_whitelist'))
            self.status_var.set(f"Готово. Рабочих: {working}/{len(self.batch_results)}, В БС: {whitelist}")
        self.batch_results.sort(key=lambda r: (not r.get('valid', False), -r.get('connection_score', 0)))
        for item in self.batch_tree.get_children():
            self.batch_tree.delete(item)
        for result in self.batch_results:
            valid = result.get('valid', False)
            if valid:
                status_icon, row_tag = "[OK]", 'ok'
            elif result.get('error') and 'Заблокированный' in str(result.get('error', '')):
                status_icon, row_tag = "[BAN]", 'ban'
            else:
                status_icon, row_tag = "[FAIL]", 'fail'
            proxy = result.get('proxy', {})
            if proxy and proxy.get('server'):
                server = proxy['server']
                port = str(proxy['port'])
                protocol = proxy.get('protocol', 'N/A').upper()
            else:
                server, port = self._try_extract_server_port(result.get('link', ''))
                protocol = 'N/A'
            ping = result.get('ping')
            jitter = result.get('jitter')
            ping_str = f"{ping:.0f}" if ping is not None else "N/A"
            jitter_str = f"{jitter:.0f}" if jitter is not None else "N/A"
            mtproto_str = "[OK]" if result.get('mtproto_ok') else "[FAIL]"
            carriers = result.get('carriers', {})
            c_str = "N/A"
            if carriers:
                c_str = f"М:{'+' if carriers.get('MTS') else '-'} Б:{'+' if carriers.get('Beeline') else '-'} МГ:{'+' if carriers.get('Megafon') else '-'} Т2:{'+' if carriers.get('Tele2') else '-'}"
            wl_str = "[БС]" if result.get('is_whitelist') else "Нет"
            geo = result.get('geo', {})
            country = geo.get('country', 'N/A') if isinstance(geo, dict) and 'error' not in geo else 'N/A'
            score = result.get('connection_score', 0)
            self.batch_tree.insert("", tk.END, tags=(row_tag,), values=(
                status_icon, server, port, protocol, ping_str, jitter_str, c_str,
