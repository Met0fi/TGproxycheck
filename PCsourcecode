def _try_aes_ctr(data: bytes, key: bytes, iv: bytes) -> Optional[bytes]:
    padded_key = (key + b'\x00' * 32)[:32]
    padded_iv = (iv + b'\x00' * 16)[:16]
    if HAS_PYCRYPTODOME:
        try:
            c = _AES.new(padded_key, _AES.MODE_CTR, initial_value=padded_iv, nonce=b'')
            return c.encrypt(data)
        except Exception:
            pass
    if HAS_CRYPTOGRAPHY:
        try:
            enc = _Cipher(_alg.AES(padded_key), _modes.CTR(padded_iv)).encryptor()
            return enc.update(data) + enc.finalize()
        except Exception:
            pass
    return None

def _install_asyncio_exception_handler(loop):
    def _handler(loop_ref, context):
        exc = context.get('exception')
        if exc is None: return
        if isinstance(exc, (ConnectionResetError, BrokenPipeError)): return
        if isinstance(exc, OSError) and getattr(exc, 'winerror', None) in (10054, 10053, 64, 232): return
        try:
            loop_ref.default_exception_handler(context)
        except Exception:
            pass
    try:
        loop.set_exception_handler(_handler)
    except Exception:
        pass

async def _safe_disconnect(client):
    if client is None: return
    try:
        if client.is_connected():
            try:
                await asyncio.wait_for(client.disconnect(), timeout=3.0)
            except (asyncio.TimeoutError, asyncio.CancelledError):
                pass
    except Exception:
        pass
    try:
        session = getattr(client, 'session', None)
        if session is not None and hasattr(session, 'close'):
            try:
                await session.close()
            except Exception:
                pass
    except Exception:
        pass

def _valid_port(port_str: str) -> bool:
    try:
        return 1 <= int(port_str) <= 65535
    except (ValueError, TypeError):
        return False

def _decode_domain(secret: str) -> Optional[str]:
    if not secret.startswith('ee') or len(secret) <= 34:
        return None
    domain_hex = secret[34:]
    if len(domain_hex) % 2 != 0:
        return None
    try:
        raw = bytes.fromhex(domain_hex)
        text = raw.decode('ascii', errors='ignore').rstrip('\x00').strip()
        return text.lower() if text else None
    except Exception:
        return None

def _is_blocked(secret: str, domain: Optional[str]) -> bool:
    if len(secret) < 32: return True
    if domain and any(b in domain for b in BLOCKED_SNI_LIST): return True
    return False

