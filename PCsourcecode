    @staticmethod
    def _test_whitelist_status(proxy: Dict, mtproto_ok: bool = False, port_open: bool = False, ip: str = "", ping: Optional[float] = None) -> Tuple[str, bool]:
        if not proxy or not port_open or not mtproto_ok:
            return "Проверка не завершена", False
        secret = proxy.get('secret', '')
        if MTProtoChecker.check_ip_in_telegram_range(ip):
            sni = _decode_domain(secret) if secret.startswith('ee') else ""
            if sni and '.' in sni:
                return f"В БС (IP Telegram, SNI: {sni})", True
            return "В БС (IP Telegram)", True
        has_whitelisted_sni = False
        sni_domain = ""
        if secret.startswith('ee'):
            bs_compat = MTProtoChecker._detect_bs_compat_proxy(secret)
            sni_domain = bs_compat.get('sni_domain', '')
            if bs_compat.get('is_blocked_sni'):
                return f"Заблокированный SNI ({bs_compat['service_name']})", False
            if bs_compat.get('is_bs_compat') and bs_compat.get('is_russian_service'):
                has_whitelisted_sni = True
            elif sni_domain and sni_domain in BS_COMPAT_SNI_RU:
                has_whitelisted_sni = True
        ip_is_white = False
        ip_status = ""
        if MTProtoChecker._is_ip_in_whitelist_ranges(ip):
            ip_is_white = True
            ip_status = "CIDR РФ"
        else:
            asn_data = MTProtoChecker._get_ip_asn_country(ip)
            if asn_data.get("asn") in RU_TRUSTED_ASNS:
                ip_is_white = True
                ip_status = f"ASN {asn_data['asn']} доверенный"
            elif asn_data.get("country") == "RU":
                ip_is_white = True
                ip_status = f"IP РФ (ASN {asn_data.get('asn', 0)})"
        tspu_not_blocking = MTProtoChecker._test_raw_tcp_handshake(ip, 443)
        if has_whitelisted_sni and ip_is_white and tspu_not_blocking:
            return f"В БС (SNI: {sni_domain}, IP: {ip_status}, ТСПУ не блокирует)", True
        if has_whitelisted_sni and ip_is_white:
            return f"Вероятно в БС (SNI: {sni_domain}, IP: {ip_status}, ТСПУ не проверен)", True
        if has_whitelisted_sni and tspu_not_blocking:
            return f"Частично БС (SNI: {sni_domain}, ТСПУ не блокирует, IP не белый)", False
        if ip_is_white and tspu_not_blocking and not secret.startswith('ee'):
            return f"Возможно в БС (IP: {ip_status}, ТСПУ не блокирует, нет SNI)", False
        if ip_is_white and tspu_not_blocking:
            return f"Частично БС (IP: {ip_status}, ТСПУ не блокирует, SNI не из списка)", False
        if has_whitelisted_sni:
            return f"SNI из списка ({sni_domain}), но IP не белый", False
        if tspu_not_blocking:
            return "ТСПУ не блокирует, но нет SNI из списка и белого IP", False
        if secret.startswith('ee'):
            if sni_domain:
                return f"Не в БС (SNI: {sni_domain}, не из списка)", False
            return "Не в БС (Fake-TLS без проверенного SNI)", False
        elif secret.startswith('dd'):
            return "Не в БС (Padded, нет Fake-TLS)", False
        return "Не в БС (Standard)", False

